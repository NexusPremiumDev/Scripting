-- AUTOCOMPLETE + HISTORY
-- ═══════════════════════════════════════════════════════════════════
local history = {}
local historyIndex = 0

CommandBar:GetPropertyChangedSignal("Text"):Connect(function()
    local txt = string.lower(CommandBar.Text)
    if txt == "" then SuggestionLabel.Text = "" return end
    if Commands[txt] then SuggestionLabel.Text = "" return end
    for _, name in ipairs(CommandOrder) do
        if string.sub(name, 1, #txt) == txt then
            SuggestionLabel.Text = name
            return
        end
    end
    SuggestionLabel.Text = ""
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if not CommandBar:IsFocused() then return end
    if input.KeyCode == Enum.KeyCode.Tab then
        if SuggestionLabel.Text ~= "" then
            CommandBar.Text = SuggestionLabel.Text
            CommandBar.CursorPosition = #CommandBar.Text + 1
            SuggestionLabel.Text = ""
        end
    elseif input.KeyCode == Enum.KeyCode.Up then
        if #history > 0 then
            historyIndex = math.max(1, historyIndex - 1)
            CommandBar.Text = history[historyIndex]
            CommandBar.CursorPosition = #CommandBar.Text + 1
        end
    elseif input.KeyCode == Enum.KeyCode.Down then
        if #history > 0 then
            historyIndex = math.min(#history + 1, historyIndex + 1)
            if historyIndex > #history then
                CommandBar.Text = ""
            else
                CommandBar.Text = history[historyIndex]
            end
            CommandBar.CursorPosition = #CommandBar.Text + 1
        end
    end
end)

-- ═══════════════════════════════════════════════════════════════════
-- COMMAND EXECUTION (2-word support)
-- ═══════════════════════════════════════════════════════════════════
local function executeCommand(text)
    text = text or ""
    local args = {}
    for word in string.gmatch(text, "%S+") do table.insert(args, word) end
    if #args == 0 then return end

    -- Önce 2 kelimelik komut dene (örn. "wrd aimbot", "god mode", "fly speed")
    local cmdName, consumed
    if #args >= 2 then
        local two = string.lower(args[1] .. " " .. args[2])
        if Commands[two] then
            cmdName = two
            consumed = 2
        end
    end
    if not cmdName then
        cmdName = string.lower(args[1])
        consumed = 1
    end

    if not Commands[cmdName] then
        Nexus_Log("Unknown: " .. cmdName .. " (try 'help')", true)
        return
    end

    Nexus_Log("> " .. text)
    local rest = {}
    for i = consumed + 1, #args do table.insert(rest, args[i]) end
    safeCall(function() Commands[cmdName].payload(rest) end)
end

CommandBar.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local txt = CommandBar.Text
        CommandBar.Text = ""
        SuggestionLabel.Text = ""
        if txt ~= "" then
            table.insert(history, txt)
            historyIndex = #history + 1
            executeCommand(txt)
        end
        CommandBar:CaptureFocus()
    end
end)

