local normalSize = UDim2.new(0, 620, 0, 380)
local normalPos  = UDim2.new(1, -650, 1, -410)
local maxSize    = UDim2.new(1, 0, 1, 0)
local maxPos     = UDim2.new(0, 0, 0, 0)
local miniSize   = UDim2.new(0, 620, 0, 30)

local windowState     = "normal"
local lastNormalSize  = normalSize
local lastNormalPos   = normalPos

local function updateButtons()
    if windowState == "maximized" then
        MaxBtn.Text = "❐"; MaxBtn.TextColor3 = Color3.fromRGB(255, 200, 130)
        MinBtn.Text = "—"; MinBtn.TextColor3 = Color3.fromRGB(120, 255, 160)
    elseif windowState == "minimized" then
        MaxBtn.Text = "⛶"; MaxBtn.TextColor3 = Color3.fromRGB(130, 200, 255)
        MinBtn.Text = "▢"; MinBtn.TextColor3 = Color3.fromRGB(255, 200, 130)
    else
        MaxBtn.Text = "⛶"; MaxBtn.TextColor3 = Color3.fromRGB(130, 200, 255)
        MinBtn.Text = "—"; MinBtn.TextColor3 = Color3.fromRGB(120, 255, 160)
    end
end

local function tweenTo(size, pos)
    pcall(function()
        ConsoleContainer:TweenSizeAndPosition(
            size, pos,
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quart,
            0.22, true)
    end)
end

local function doMinimize()
    if windowState == "minimized" then
        windowState = "normal"
        tweenTo(lastNormalSize, lastNormalPos)
        log("Restored")
    else
        if windowState == "normal" then
            lastNormalSize = ConsoleContainer.Size
            lastNormalPos  = ConsoleContainer.Position
        end
        windowState = "minimized"
        tweenTo(miniSize, ConsoleContainer.Position)
        log("Minimized")
    end
    updateButtons()
end

local function doMaximize()
    if windowState == "maximized" then
        windowState = "normal"
        tweenTo(lastNormalSize, lastNormalPos)
        log("Restored")
    else
        if windowState == "normal" then
            lastNormalSize = ConsoleContainer.Size
            lastNormalPos  = ConsoleContainer.Position
        end
        windowState = "maximized"
        tweenTo(maxSize, maxPos)
        log("Maximized")
    end
    updateButtons()
end

local function doClose()
    Nexus_Log("Shutting down...")
    task.wait(0.15)
    for k in pairs(conn) do unbind(k) end
    for _, c in pairs(respawnConnections) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function() ScreenGui:Destroy() end)
end

MinBtn.MouseButton1Click:Connect(doMinimize)
MaxBtn.MouseButton1Click:Connect(doMaximize)
CloseBtn.MouseButton1Click:Connect(doClose)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
              or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if not ctrl then return end
    if input.KeyCode == Enum.KeyCode.M then
        doMaximize()
    elseif input.KeyCode == Enum.KeyCode.N then
        doMinimize()
    elseif input.KeyCode == Enum.KeyCode.Q then
        doClose()
    end
end)

updateButtons()

