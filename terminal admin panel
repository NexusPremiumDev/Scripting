    local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Head")
end

local function getHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function lpChar() return LocalPlayer.Character end
local function lpRoot() return getRoot(lpChar()) end
local function lpHum()  return getHum(lpChar()) end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        if Nexus_Log then Nexus_Log("Error: " .. tostring(err), true) end
        warn("[Nexus] " .. tostring(err))
    end
    return ok, err
end

local function findPlayer(query)
    if not query or query == "" then return nil end
    query = string.lower(query)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and string.lower(p.Name) == query then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and string.find(string.lower(p.Name), query, 1, true) then
            return p
        end
    end
    return nil
end

