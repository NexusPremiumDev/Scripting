-- FLY
local function enableFly()
    if flying then return end
    local humanoid, rootPart = lpHum(), lpRoot()
    if not humanoid or not rootPart then log("No character", true) return end
    flying = true
    humanoid.PlatformStand = true
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = rootPart
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 10000
    bodyGyro.D = 500
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    task.spawn(function()
        while flying and bodyVelocity and bodyGyro do
            local cam = Workspace.CurrentCamera
            local dir = Vector3.zero
            local root = lpRoot()
            if not root then break end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir += Vector3.new(0, -1, 0) end
            if dir.Magnitude > 0 then dir = dir.Unit * flySpeed end
            if bodyVelocity then bodyVelocity.Velocity = dir end
            if bodyGyro then bodyGyro.CFrame = CFrame.new(root.Position, root.Position + cam.CFrame.LookVector) end
            task.wait()
        end
    end)
    logOk("Fly ON · " .. flySpeed)
end

local function disableFly()
    if not flying then return end
    flying = false
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    local h = lpHum()
    if h then h.PlatformStand = false end
    logOk("Fly OFF")
end

local function enableWalkSpeed(val)
    if val then wsValue = math.clamp(val, 1, 500) end
    wsActive = true
    bind("walkspeed_loop", RunService.Heartbeat:Connect(function()
        if not wsActive then return end
        local h = lpHum()
        if h and h.WalkSpeed ~= wsValue then h.WalkSpeed = wsValue end
    end))
    local h = lpHum()
    if h then h.WalkSpeed = wsValue end
    logOk("WalkSpeed → " .. wsValue)
end

local function disableWalkSpeed()
    wsActive = false
    unbind("walkspeed_loop")
    local h = lpHum()
    if h then h.WalkSpeed = 16 end
    logOk("WalkSpeed → 16")
end

local function enableNoClip()
    if noclip then return end
    noclip = true
    noclipConnection = RunService.Stepped:Connect(function()
        local c = lpChar()
        if not c then return end
        for _, part in pairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end)
    logOk("Noclip ON")
end

local function disableNoClip()
    if not noclip then return end
    noclip = false
    local char = lpChar()
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    logOk("Noclip OFF")
end

local function getVehicleRoot()
    local hum = lpHum()
    if not hum or not hum.SeatPart then return nil end
    local model = hum.SeatPart:FindFirstAncestorOfClass("Model")
    if model then
        return model.PrimaryPart or model:FindFirstChild("Chassis") or model:FindFirstChildWhichIsA("BasePart")
    end
    return hum.SeatPart
end

local function enableCarFly()
    if carFlying then return end
    local root = getVehicleRoot()
    if not root then log("Sit in a vehicle first", true) return end
    carFlying = true
    carBV = Instance.new("BodyVelocity")
    carBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    carBV.Parent = root
    carBG = Instance.new("BodyGyro")
    carBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    carBG.P = 9e4
    carBG.Parent = root
    bind("carfly", RunService.RenderStepped:Connect(function()
        if not carFlying then return end
        local r = getVehicleRoot()
        if not r then return end
        if carBV and carBV.Parent ~= r then carBV.Parent = r; carBG.Parent = r end
        local cam = Workspace.CurrentCamera
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir += Vector3.new(0, -1, 0) end
        if dir.Magnitude > 0 then dir = dir.Unit * flySpeed end
        if carBV then carBV.Velocity = dir end
        if carBG then carBG.CFrame = CFrame.new(r.Position, r.Position + cam.CFrame.LookVector) end
    end))
    logOk("CarFly ON")
end

local function disableCarFly()
    carFlying = false
    unbind("carfly")
    if carBV then carBV:Destroy() carBV = nil end
    if carBG then carBG:Destroy() carBG = nil end
    logOk("CarFly OFF")
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if flying then disableFly() end
    if noclip then disableNoClip() end
    if carFlying then disableCarFly() end
    if wsActive then local h = getHum(char) if h then h.WalkSpeed = wsValue end end
    local hum = getHum(char)
    if hum then
        hum.Died:Connect(function()
            local r = getRoot(char)
            if r then lastDeath = r.CFrame end
        end)
    end
    if spawnpoint and spawnpos then
        task.wait(spDelay)
        local r = getRoot(char)
        if r then r.CFrame = spawnpos end
    end
end)

if lpChar() then
    local hum = lpHum()
    if hum then
        hum.Died:Connect(function()
            local r = lpRoot()
            if r then lastDeath = r.CFrame end
