local function executeCommand(text)
text = string.lower(text or "")
logMessage("> " .. text)
local args = {}
for word in string.gmatch(text, "%S+") do table.insert(args, word) end
if #args == 0 then return end
local cmdName = args[1] table.remove(args, 1)

if CustomScripts[cmdName] then
	local success, err = pcall(function() CustomScripts[cmdName].payload(args) end)
	if not success then logMessage("Error: " .. tostring(err), true) end
else
	logMessage("Unknown cmd: " .. cmdName, true)
end


end

CommandBar.FocusLost:Connect(function(enterPressed)
if enterPressed then
local txt = CommandBar.Text
CommandBar.Text = ""
SuggestionLabel.Text = ""
if txt ~= "" then executeCommand(txt) end
CommandBar:CaptureFocus()
end
end)

