desc = "ESP Player",
payload = function()
if ScreenGui:FindFirstChild("NexusESPFolder") then
ScreenGui.NexusESPFolder:Destroy()
unbind("esp")
logMessage("ESP disabled.")
return
end

		local ESPFolder = Instance.new("Folder")
		ESPFolder.Name = "NexusESPFolder"
		ESPFolder.Parent = ScreenGui

		bind("esp", RunService.RenderStepped:Connect(function()
			for _, c in ipairs(ESPFolder:GetChildren()) do c:Destroy() end

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and getRoot(p.Character) and getHum(p.Character) and getHum(p.Character).Health > 0 then
					local char = p.Character
					local root = getRoot(char)
					local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
					
					if onScreen then
						local dist = (Camera.CFrame.Position - root.Position).Magnitude
						local topPos = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
						local btmPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
						local height = math.abs(topPos.Y - btmPos.Y)
						local width = height / 2

						local box = Instance.new("Frame")
						box.Size = UDim2.new(0, width, 0, height)
						box.Position = UDim2.new(0, vector.X - width/2, 0, vector.Y - height/2)
						box.BackgroundTransparency = 1
						box.Parent = ESPFolder

						local stroke = Instance.new("UIStroke")
						stroke.Color = Color3.fromRGB(0, 255, 120)
						stroke.Thickness = 1.2
						stroke.Parent = box

						local tag = Instance.new("TextLabel")
						tag.Size = UDim2.new(0, 120, 0, 16)
						tag.Position = UDim2.new(0.5, -60, 0, -18)
						tag.BackgroundTransparency = 1
						tag.Text = string.format("[%s] (%dm)", p.Name, math.floor(dist))
						tag.TextColor3 = Color3.fromRGB(0, 255, 120)
						tag.TextSize = 9
						tag.Font = Enum.Font.Code
						tag.TextXAlignment = Enum.TextXAlignment.Center
