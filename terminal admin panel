local Commands, CommandOrder = {}, {}
local function register(name, desc, payload)
    Commands[name] = { desc = desc, payload = payload, name = name }
    table.insert(CommandOrder, name)
end

-- MOVEMENT
register("fly", "Toggle Fly", function() if flying then disableFly() else enableFly() end end)
register("unfly", "Stop Fly", function() disableFly() end)
register("fly speed", "Fly/CarFly speed", function(args)
    flySpeed = math.clamp(tonumber(args[1]) or 50, 1, 500)
    logOk("Fly speed → " .. flySpeed)
end)
register("walkspeed", "WalkSpeed e.g. 50", function(args) enableWalkSpeed(tonumber(args[1]) or 50) end)
register("speed", "Alias walkspeed", function(args) enableWalkSpeed(tonumber(args[1]) or 50) end)
register("unspeed", "Reset WalkSpeed", function() disableWalkSpeed() end)
register("noclip", "Toggle Noclip", function() if noclip then disableNoClip() else enableNoClip() end end)
register("unnoclip", "Stop Noclip", function() disableNoClip() end)
register("carfly", "Vehicle fly", function() if carFlying then disableCarFly() else enableCarFly() end end)
register("uncarfly", "Stop CarFly", function() disableCarFly() end)
