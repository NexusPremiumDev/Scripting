local history, historyIndex = {}, 0
CommandBar:GetPropertyChangedSignal("Text"):Connect(function()
    local txt = string.lower(CommandBar.Text)
    if txt == "" then SuggestionLabel.Text = "" return end
    if Commands[txt] then SuggestionLabel.Text = "" return end
    for _, name in ipairs(CommandOrder) do
        if string.sub(name, 1, #txt) == txt then SuggestionLabel.Text = name return end
    end
    SuggestionLabel.Text = ""
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if not CommandBar:IsFocused() then return end
    if input.KeyCode == Enum.KeyCode.Tab and SuggestionLabel.Text ~= "" then
        CommandBar.Text = SuggestionLabel.Text
        CommandBar.CursorPosition = #CommandBar.Text + 1
        SuggestionLabel.Text = ""
    elseif input.KeyCode == Enum.KeyCode.Up and #history > 0 then
        historyIndex = math.max(1, historyIndex - 1)
        CommandBar.Text = history[historyIndex]
    elseif input.KeyCode == Enum.KeyCode.Down and #history > 0 then
        historyIndex = math.min(#history + 1, historyIndex + 1)
        CommandBar.Text = historyIndex > #history and "" or history[historyIndex]
    end
end)

local function executeCommand(text)
    local args = {}
    for word in string.gmatch(text or "", "%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local cmdName, consumed
    if #args >= 2 then
        local two = string.lower(args[1] .. " " .. args[2])
        if Commands[two] then cmdName = two; consumed = 2 end
    end
    if not cmdName then cmdName = string.lower(args[1]); consumed = 1 end
    if not Commands[cmdName] then Nexus_Log("Unknown: " .. cmdName, true) return end
    Nexus_Log("> " .. text)
    local rest = {}
    for i = consumed + 1, #args do table.insert(rest, args[i]) end
    safeCall(function() Commands[cmdName].payload(rest) end)
end

CommandBar.FocusLost:Connect(function(enter)
    if enter then
        local txt = CommandBar.Text
        CommandBar.Text = ""
        SuggestionLabel.Text = ""
        if txt ~= "" then
            table.insert(history, txt)
            historyIndex = #history + 1
            executeCommand(txt)
        end
        CommandBar:CaptureFocus()
    end
end)

