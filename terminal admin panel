local function tweenTo(size, pos)
    TweenService:Create(ConsoleContainer, TweenInfo.new(0.22, Enum.EasingStyle.Quart), {
        Size = size, Position = pos
    }):Play()
end

MinBtn.MouseButton1Click:Connect(function()
    if windowState == "minimized" then
        windowState = "normal"
        ContentArea.Visible = true
        tweenTo(lastNormalSize, lastNormalPos)
    else
        if windowState == "normal" then
            lastNormalSize = ConsoleContainer.Size
            lastNormalPos = ConsoleContainer.Position
        end
        windowState = "minimized"
