local MAX_LINES, lineCount = 250, 0
function Nexus_Log(msg, isError, isSuccess)
    if lineCount >= MAX_LINES then
        local first = ScrollingOutput:FindFirstChildWhichIsA("TextLabel")
        if first then first:Destroy(); lineCount -= 1 end
    end
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = "› " .. tostring(msg)
    lbl.TextColor3 = isError and Color3.fromRGB(255, 95, 105)
        or (isSuccess and Color3.fromRGB(120, 255, 185) or Color3.fromRGB(0, 255, 130))
    lbl.TextSize = 11
    lbl.Font = Enum.Font.Code
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = ScrollingOutput
    lineCount += 1
end
local function log(msg, err) Nexus_Log(msg, err) end
local function logOk(msg) Nexus_Log(msg, false, true) end
log("Nexus Terminal online.")

local conn = {}
local function bind(key, c)
    if conn[key] then pcall(function() conn[key]:Disconnect() end) end
    conn[key] = c
end
local function unbind(key)
    if conn[key] then pcall(function() conn[key]:Disconnect() end); conn[key] = nil end
end
local function isBound(key) return conn[key] ~= nil end

