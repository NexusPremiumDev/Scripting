local function protectGui(gui)
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    local parent = CoreGui
    pcall(function() if gethui then parent = gethui() end end)
    gui.Parent = parent
end

local function getRoot(char)
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.RootPart then return hum.RootPart end
    return char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Head")
end

local function getHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function lpChar() return LocalPlayer.Character end
local function lpRoot() return getRoot(lpChar()) end
local function lpHum()  return getHum(lpChar()) end

local function isR15(char)
    local h = getHum(char or lpChar())
    return h and h.RigType == Enum.HumanoidRigType.R15
end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        if Nexus_Log then Nexus_Log("Error: " .. tostring(err), true) end
        warn("[Nexus] " .. tostring(err))
    end
    return ok, err
end

local function findPlayer(query)
    if not query or query == "" then return nil end
    query = string.lower(query)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and string.lower(p.Name) == query then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and string.find(string.lower(p.Name), query, 1, true) then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and string.find(string.lower(p.DisplayName), query, 1, true) then return p end
    end
    return nil
end

local function copyText(str)
    return pcall(function()
        if setclipboard then setclipboard(str)
        elseif toclipboard then toclipboard(str)
        elseif Clipboard and Clipboard.set then Clipboard.set(str)
        else error("no clipboard") end
    end)
end

