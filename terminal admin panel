register("fly", "Enable Fly (WASD)", function()
    if flyState.active then
        log("Fly already active — 'unfly' to stop")
        return
    end

    local char = lpChar()
    if not char then log("No character", true) return end
    local root = getRoot(char)
    local hum = getHum(char)
    if not root or not hum then log("No root/humanoid", true) return end

    flyState.active = true

    flyState.bodyGyro = Instance.new("BodyGyro")
    flyState.bodyGyro.P = 9e4
    flyState.bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyState.bodyGyro.CFrame = root.CFrame
    flyState.bodyGyro.Parent = root

    flyState.bodyVel = Instance.new("BodyVelocity")
    flyState.bodyVel.Velocity = Vector3.new(0, 0, 0)
    flyState.bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyState.bodyVel.P = 1250
    flyState.bodyVel.Parent = root

    local function press(key, state)
        if key == Enum.KeyCode.W then flyState.keys.W = state
        elseif key == Enum.KeyCode.A then flyState.keys.A = state
        elseif key == Enum.KeyCode.S then flyState.keys.S = state
        elseif key == Enum.KeyCode.D then flyState.keys.D = state
        elseif key == Enum.KeyCode.Space then flyState.keys.Space = state
        elseif key == Enum.KeyCode.LeftShift then flyState.keys.Shift = state end
    end

    bind("fly_input", UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        press(input.KeyCode, true)
    end))
    bind("fly_input_end", UserInputService.InputEnded:Connect(function(input)
        press(input.KeyCode, false)
    end))

    bind("fly_loop", RunService.RenderStepped:Connect(function()
        if not flyState.active then return end
        local r = lpRoot()
        if not r then return end
        local cf = Camera.CFrame
        local move = Vector3.new(0, 0, 0)
        if flyState.keys.W then move += cf.LookVector end
        if flyState.keys.S then move -= cf.LookVector end
        if flyState.keys.A then move -= cf.RightVector end
        if flyState.keys.D then move += cf.RightVector end
        if flyState.keys.Space then move += Vector3.new(0, 1, 0) end
        if flyState.keys.Shift then move -= Vector3.new(0, 1, 0) end
        local target = (move.Magnitude > 0) and move.Unit * flyState.speed or Vector3.new(0, 0, 0)
        if flyState.bodyGyro then flyState.bodyGyro.CFrame = cf end
        if flyState.bodyVel then flyState.bodyVel.Velocity = target end
    end))

    logOk("Fly ON — speed " .. flyState.speed .. "  ·  WASD move, Space up, Shift down")
end)

register("unfly", "Stop Fly", function()
    flyState.active = false
    unbind("fly_input")
    unbind("fly_input_end")
    unbind("fly_loop")
    local root = lpRoot()
    if root then
        for _, v in ipairs(root:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
                v:Destroy()
            end
        end
    end
    flyState.bodyGyro = nil
    flyState.bodyVel = nil
    logOk("Fly OFF")
end)

