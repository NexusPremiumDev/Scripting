register("fling", "Spin fling toggle", function()
    if flinging then
        flinging = false
        unbind("fling")
        disableNoClip()
        local char = lpChar()
        if char then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
                    v.Massless = false
                elseif v:IsA("BodyAngularVelocity") then
                    v:Destroy()
                end
            end
        end
        logOk("Fling OFF")
        return
    end
    local char, root = lpChar(), lpRoot()
    if not char or not root then log("No character", true) return end
    for _, child in pairs(char:GetDescendants()) do
        if child:IsA("BasePart") then
            child.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
            child.Massless = true
        end
    end
    enableNoClip()
    local bambam = Instance.new("BodyAngularVelocity")
    bambam.Name = "NexusFling"
    bambam.Parent = root
    bambam.AngularVelocity = Vector3.new(0, 99999, 0)
    bambam.MaxTorque = Vector3.new(0, math.huge, 0)
    bambam.P = math.huge
    flinging = true
    task.spawn(function()
        while flinging do
            if bambam and bambam.Parent then
                bambam.AngularVelocity = Vector3.new(0, 99999, 0)
                task.wait(0.2)
                bambam.AngularVelocity = Vector3.zero
                task.wait(0.1)
            else break end
        end
    end)
    logOk("Fling ON")
end)

register("walkfling", "Walk fling", function()
    if walkflinging then
        walkflinging = false
        disableNoClip()
        logOk("WalkFling OFF")
        return
    end
    walkflinging = true
    enableNoClip()
    task.spawn(function()
        while walkflinging do
            RunService.Heartbeat:Wait()
            local root = lpRoot()
            if not root then continue end
            local vel = root.Velocity
            root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
            RunService.RenderStepped:Wait()
            if root and root.Parent then root.Velocity = vel end
            RunService.Stepped:Wait()
            if root and root.Parent then root.Velocity = vel + Vector3.new(0, 0.1, 0) end
        end
    end)
    logOk("WalkFling ON")
end)
register("unwalkfling", "Stop WalkFling", function()
    walkflinging = false
    disableNoClip()
    logOk("WalkFling OFF")
end)

