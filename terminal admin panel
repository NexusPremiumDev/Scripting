register("esp", "ESP players", function()
    if ScreenGui:FindFirstChild("NexusESPFolder") then ScreenGui.NexusESPFolder:Destroy(); unbind("esp") end
    local folder = Instance.new("Folder")
    folder.Name = "NexusESPFolder"
    folder.Parent = ScreenGui
    local cache = {}
    bind("esp", RunService.Heartbeat:Connect(function()
        local alive = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root, hum = getRoot(p.Character), getHum(p.Character)
                if root and hum and hum.Health > 0 then
                    alive[p] = true
                    local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
                    local entry = cache[p]
                    if onScreen then
                        if not entry then
                            local box = Instance.new("Frame")
                            box.BackgroundTransparency = 1
                            box.Parent = folder
                            Instance.new("UIStroke", box).Color = Color3.fromRGB(0, 255, 130)
                            local tag = Instance.new("TextLabel")
                            tag.Size = UDim2.new(0, 140, 0, 16)
                            tag.Position = UDim2.new(0.5, -70, 0, -18)
                            tag.BackgroundTransparency = 1
                            tag.TextColor3 = Color3.fromRGB(0, 255, 130)
                            tag.TextSize = 10
                            tag.Font = Enum.Font.Code
                            tag.TextXAlignment = Enum.TextXAlignment.Center
                            tag.Parent = box
                            cache[p] = { box = box, tag = tag }
                            entry = cache[p]
                        end
                        local dist = (Camera.CFrame.Position - root.Position).Magnitude
                        local top = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                        local btm = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(top.Y - btm.Y)
                        local width = height / 2
                        entry.box.Visible = true
                        entry.box.Size = UDim2.new(0, width, 0, height)
                        entry.box.Position = UDim2.new(0, vector.X - width / 2, 0, vector.Y - height / 2)
                        entry.tag.Text = string.format("[%s] %dm", p.Name, math.floor(dist))
                    elseif entry then entry.box.Visible = false end
                end
            end
        end
        for p, entry in pairs(cache) do
            if not alive[p] then entry.box:Destroy(); cache[p] = nil end
        end
    end))
    logOk("ESP ON")
end)
register("unesp", "Stop ESP", function()
    unbind("esp")
    if ScreenGui:FindFirstChild("NexusESPFolder") then ScreenGui.NexusESPFolder:Destroy() end
    logOk("ESP OFF")
end)

