local function getClosestTargetInFov()
    local mousePos = UserInputService:GetMouseLocation()
    local bestPlayer, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local targetPart = getTargetPart(char, Settings.SilentTargetPart)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not targetPart or not hum or hum.Health <= 0 then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist2d < Settings.FOVRadius and dist2d < bestDist then
            bestDist = dist2d
            bestPlayer = plr
        end
    end
    return bestPlayer
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
        return
    end
    if input.KeyCode == Enum.KeyCode.RightControl then
        unload()
        return
    end
    if input.KeyCode == Enum.KeyCode.Space and Settings.InfJump then
        local h = getHumanoid()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        IsScoped = true
    end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 and Settings.SilentAim then
        local target = getClosestTargetInFov()
        if target then
            local targetPart = getTargetPart(target.Character, Settings.SilentTargetPart)
            if targetPart then
                local saved = Camera.CFrame
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                task.delay(0.015, function()
                    if Camera then Camera.CFrame = saved end
                end)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        IsScoped = false
    end
end)

RunService.RenderStepped:Connect(function()
    if not Running then return end

    local hrp = getHRP()
    local hum = getHumanoid()
    if hrp and hum and Settings.WalkSpeed > 20 and not Settings.Fly then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (moveDir * ((Settings.WalkSpeed - 20) * 0.016))
        end
    end

    if Settings.ShowFOV and (Settings.Aimbot or Settings.SilentAim) then
        FOVCircle.Visible = true
        FOVCircle.Radius = Settings.FOVRadius
        FOVCircle.Position = UserInputService:GetMouseLocation()
    else
        FOVCircle.Visible = false
    end

    if Settings.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getClosestTargetInFov()
        if target then
            local targetPart = getTargetPart(target.Character, Settings.SilentTargetPart)
            if targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local current = UserInputService:GetMouseLocation()
                    local goal = Vector2.new(screenPos.X, screenPos.Y)
                    local delta = (goal - current) / math.max(1, (Settings.AimSmoothness / 10))
                    mousemoverel(delta.X, delta.Y)
                end
            end
        end
    end

    if Settings.SpinBot and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
    end

    if Settings.Fly and hrp and hum then
        hum.PlatformStand = true
        if not FlyState.bv then
            FlyState.bv = Instance.new("BodyVelocity")
            FlyState.bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            FlyState.bv.Velocity = Vector3.new(0, 0, 0)
            FlyState.bv.Parent = hrp
        end
        if not FlyState.bg then
            FlyState.bg = Instance.new("BodyGyro")
            FlyState.bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            FlyState.bg.CFrame = Camera.CFrame
            FlyState.bg.Parent = hrp
        end
        
        local moveDir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        
        FlyState.bv.Velocity = moveDir * Settings.FlySpeed
        FlyState.bg.CFrame = Camera.CFrame
    else
        if hum and not Settings.SpinBot then hum.PlatformStand = false end
        if FlyState.bv then FlyState.bv:Destroy() FlyState.bv = nil end
        if FlyState.bg then FlyState.bg:Destroy() FlyState.bg = nil end
    end

    if Settings.Noclip then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

local BonePairs = {
    { "Head", "Torso" }, { "Head", "UpperTorso" },
    { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local BoneCount = #BonePairs

local function createVisual()
    local v = {
        Box       = Drawing.new("Square"),
        Name      = Drawing.new("Text"),
        Dist      = Drawing.new("Text"),
        HpBg      = Drawing.new("Square"),
        HpFill    = Drawing.new("Square"),
        SkeletonLines = {},
    }
    v.Name.Center = true  v.Name.Size = 13  v.Name.Font = 2
    v.Name.Outline = true v.Name.OutlineColor = Color3.new(0,0,0)
    v.Dist.Center = true  v.Dist.Size = 11  v.Dist.Font = 2
    v.Dist.Outline = true v.Dist.OutlineColor = Color3.new(0,0,0)
    v.HpBg.Filled = true
    v.HpFill.Filled = true

    for i = 1, BoneCount do
        local ln = Drawing.new("Line")
        ln.Thickness = 1
        ln.Transparency = 1
        ln.Visible = false
        v.SkeletonLines[i] = ln
    end
    return v
end

local function removeVisual(v)
    pcall(function()
        v.Box:Remove() v.Name:Remove() v.Dist:Remove()
        v.HpBg:Remove() v.HpFill:Remove()
        for _, ln in ipairs(v.SkeletonLines) do ln:Remove() end
    end)
end

RunService.RenderStepped:Connect(function()
    if not Running then return end
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if not PlayerEntries[p] then PlayerEntries[p] = createVisual() end
                local v = PlayerEntries[p]

                if Settings.ESPEnabled and isAlive(p) and p.Character then
                    local char = p.Character
                    local root = getAnchor(char)
                    local hum = char:FindFirstChildOfClass("Humanoid")

                    if root and hum then
                        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                        local dist = (root.Position - Camera.CFrame.Position).Magnitude

                        if onScreen and pos.Z > 0.5 and dist <= Settings.MaxDistance then
                            local color = Settings.ESPRainbow and rainbowColor() or Settings.EnemyColor

                            local z = math.max(pos.Z, 1)
                            local sx = math.clamp(1800 / z, 10, 400)
                            local sy = math.clamp(2800 / z, 14, 620)

                            local topX, topY = pos.X - sx/2, pos.Y - sy/2

                            v.Box.Size = Vector2.new(sx, sy)
                            v.Box.Position = Vector2.new(topX, topY)
                            v.Box.Color = color
                            v.Box.Thickness = 1
                            v.Box.Visible = Settings.ESPBoxes

                            v.Name.Text = p.Name
                            v.Name.Position = Vector2.new(pos.X, topY - 26)
                            v.Name.Color = color
                            v.Name.Visible = Settings.ESPNames

                            v.Dist.Text = "[" .. math.floor(dist) .. "m]"
                            v.Dist.Position = Vector2.new(pos.X, topY - 12)
                            v.Dist.Color = color
                            v.Dist.Visible = Settings.ESPDistance

                            if Settings.ESPHealthBar then
                                local maxHp = math.max(1, hum.MaxHealth)
                                local hpPct = math.clamp(hum.Health / maxHp, 0, 1)
                                local barW = 3
                                local barX = topX - 7
                                local barY = topY
                                local barH = sy

                                local hpColor
                                if hpPct > 0.5 then
                                    hpColor = Color3.fromRGB(74, 222, 128)
                                elseif hpPct > 0.25 then
                                    hpColor = Color3.fromRGB(255, 200, 87)
                                else
                                    hpColor = Color3.fromRGB(255, 85, 102)
                                end

                                v.HpBg.Size = Vector2.new(barW + 2, barH + 2)
                                v.HpBg.Position = Vector2.new(barX - 1, barY - 1)
                                v.HpBg.Color = Color3.fromRGB(0, 0, 0)
                                v.HpBg.Visible = true

                                local fillH = barH * hpPct
                                v.HpFill.Size = Vector2.new(barW, math.max(0, fillH))
                                v.HpFill.Position = Vector2.new(barX, barY + (barH - fillH))
                                v.HpFill.Color = hpColor
                                v.HpFill.Visible = true
                            else
                                v.HpBg.Visible = false
                                v.HpFill.Visible = false
                            end

                            if Settings.ESPSkeleton then
                                for i, pair in ipairs(BonePairs) do
                                    local ln = v.SkeletonLines[i]
                                    local partA = char:FindFirstChild(pair[1])
                                    local partB = char:FindFirstChild(pair[2])
                                    if partA and partB then
                                        local a2, aOn = Camera:WorldToViewportPoint(partA.Position)
                                        local b2, bOn = Camera:WorldToViewportPoint(partB.Position)
                                        if aOn and bOn and a2.Z > 0.5 and b2.Z > 0.5 then
                                            ln.From = Vector2.new(a2.X, a2.Y)
                                            ln.To   = Vector2.new(b2.X, b2.Y)
                                            ln.Color = color
                                            ln.Visible = true
                                        else
                                            ln.Visible = false
                                        end
                                    else
                                        ln.Visible = false
                                    end
                                end
                            else
                                for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end
                            end
                        else
                            v.Box.Visible = false v.Name.Visible = false v.Dist.Visible = false
                            v.HpBg.Visible = false v.HpFill.Visible = false
                            for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end
                        end
                    else
                        v.Box.Visible = false v.Name.Visible = false v.Dist.Visible = false
                        v.HpBg.Visible = false v.HpFill.Visible = false
