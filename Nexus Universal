-- HELPERS
local function getAnchor(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") 
        or character:FindFirstChild("Torso") 
        or character:FindFirstChild("UpperTorso") 
        or character:FindFirstChild("Head") 
        or character:FindFirstChildWhichIsA("BasePart")
end

local function getTargetPart(character, partName)
    if not character then return nil end
    if partName == "Head" then
        return character:FindFirstChild("Head") or getAnchor(character)
    else
        return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or getAnchor(character)
    end
end

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = LocalPlayer.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function rainbowColor()
    return Color3.fromHSV((tick() * 0.35) % 1, 1, 1)
end

-- SPIDER-MAN HANGING ANIMATION
local function manageDance(state)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = getHumanoid()
    if not hum then return end

    if state then
        pcall(function()
            if not DanceTrack then
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://123955307291627"
                CustomAnimObject = anim
                
                local animator = hum:FindFirstChildOfClass("Animator")
                if not animator then
                    animator = Instance.new("Animator")
                    animator.Parent = hum
                end
                
                DanceTrack = animator:LoadAnimation(anim)
                DanceTrack.Looped = true
                DanceTrack.Priority = Enum.AnimationPriority.Action4
            end
            if DanceTrack and not DanceTrack.IsPlaying then
                DanceTrack:Play()
            end
        end)
    else
        if DanceTrack then
            pcall(function() DanceTrack:Stop() end)
        end
    end
end

