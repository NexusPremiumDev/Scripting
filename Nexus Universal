                {"Smoke Grenade", "Hourglass"},
                {"Jump Pad", "Spider Web"},
                {"Grenade", "Soul Grenade"},
                {"Molotov", "Torch"},
                {"Riot Shield", "Energy Shield"},
                {"Medkit", "Laptop"},
                {"Paintball Gun", "Boba Gun"},
                {"Energy Pistols", "Void Pistols"},
                {"Energy Rifle", "Hacker Rifle"},
                {"Distortion", "Plasma Distortion"},
                {"Knife", "Caladbolg"},
                {"Assault Rifle", "AKEY-47"},
                {"Sniper", "Event Horizon"},
                {"Handgun", "Pixel Handgun"},
