local function watchHumanoid(h)
    if not h then return end
    h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if Running and h.WalkSpeed ~= Settings.WalkSpeed then
            h.WalkSpeed = Settings.WalkSpeed
        end
    end)
end

