-- HELPERS
local function getAnchor(character)
    if not character then return nil end
    local hitbox = character:FindFirstChild("Hitbox")
    if hitbox then
        return hitbox:FindFirstChild("Head") or hitbox:FindFirstChild("Torso") or hitbox:FindFirstChildWhichIsA("BasePart")
    end
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart")
end

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function applyAll()
    local h = getHumanoid()
    if h then
        h.WalkSpeed    = Settings.WalkSpeed
        h.UseJumpPower = true
        h.JumpPower    = Settings.JumpPower
    end
end

local function rainbowColor()
