-- UNLOAD
local function unload()
    Running = false
    manageDance(false)
    pcall(function() FOVCircle:Remove() end)
    for _, v in pairs(PlayerEntries) do
        pcall(function()
            v.Box:Remove() v.Name:Remove() v.Dist:Remove()
            v.HpBg:Remove() v.HpFill:Remove()
            for _, ln in ipairs(v.SkeletonLines) do ln:Remove() end
        end)
    end
    if FlyState.bg then pcall(function() FlyState.bg:Destroy() end) end
    if FlyState.bv then pcall(function() FlyState.bv:Destroy() end) end
    pcall(function()
        Lighting.Brightness     = 1
        Lighting.GlobalShadows  = true
        Lighting.OutdoorAmbient = Color3.fromRGB(70,70,70)
    end)
    pcall(function() ScreenGui:Destroy() end)
    print("[Nexus] Unloaded.")
end

local function onClick(inst, callback)
    inst.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local ok, err = pcall(callback)
            if not ok then warn("[Nexus] click err: " .. tostring(err)) end
        end
    end)
end

