local function UI_Toggle(parent, label, key, onChange)
    local row = mk("TextButton", { Size = UDim2.new(1,-8,0,38), BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, parent)
    corner(row, 8)
    local rowStroke = stroke(row, Theme.Border, 1, 0.5)

    mk("TextLabel", { Size = UDim2.new(1,-70,1,0), Position = UDim2.new(0,14,0,0), BackgroundTransparency = 1, Text = label, TextColor3 = Theme.Text, Font = FontMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Active = false }, row)

    local track = mk("Frame", { Size = UDim2.new(0,36,0,20), Position = UDim2.new(1,-48,0.5,-10), BackgroundColor3 = Settings[key] and Theme.Accent or Color3.fromRGB(50,56,72), BorderSizePixel = 0, Active = false }, row)
    corner(track, 10)
    local knob = mk("Frame", { Size = UDim2.new(0,14,0,14), Position = Settings[key] and UDim2.new(0,19,0,3) or UDim2.new(0,3,0,3), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Active = false }, track)
    corner(knob, 7)

    local function upd(state, animate)
        local pos = state and UDim2.new(0,19,0,3) or UDim2.new(0,3,0,3)
        local col = state and Theme.Accent or Color3.fromRGB(50,56,72)
        local info = TweenInfo.new(animate and 0.22 or 0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(knob, info, { Position = pos }):Play()
        TweenService:Create(track, info, { BackgroundColor3 = col }):Play()
    end

    row.MouseEnter:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Theme.SurfaceHov }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.15), { Color = Theme.BorderHov }):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Theme.SurfaceAlt }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.15), { Color = Theme.Border }):Play()
    end)

    onClick(row, function()
        Settings[key] = not Settings[key]
        upd(Settings[key], true)
        if onChange then
            pcall(onChange, Settings[key])
        end
    end)
end

