local function UI_Tab(label, name)
    local btn = mk("TextButton", { Size = UDim2.new(1,-16,0,36), BackgroundColor3 = Theme.Surface, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, Sidebar)
    corner(btn, 8)

    local textLbl = mk("TextLabel", {
        Size = UDim2.new(1,-16,1,0), Position = UDim2.new(0,14,0,0),
        BackgroundTransparency = 1, Text = label,
        TextColor3 = Theme.TextMuted, Font = FontBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, Active = false,
    }, btn)

    local indicator = mk("Frame", { Size = UDim2.new(0,3,0,0), Position = UDim2.new(0,0,0.5,0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Active = false }, btn)
    corner(indicator, 2)

    local content = mk("ScrollingFrame", {
        Size = UDim2.new(1,-16,1,-16), Position = UDim2.new(0,8,0,8),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        CanvasSize = UDim2.new(0,0,0,0), ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Border, ScrollBarImageTransparency = 0.4,
        Visible = false, ClipsDescendants = true,
    }, ContentArea)
    local layout = mk("UIListLayout", { Padding = UDim.new(0,6), SortOrder = Enum.SortOrder.LayoutOrder }, content)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        content.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    local tab = { Button = btn, Content = content, Text = textLbl, Indicator = indicator, Active = false }

    btn.MouseEnter:Connect(function()
        if not tab.Active then
            TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Theme.SurfaceHov }):Play()
            TweenService:Create(textLbl, TweenInfo.new(0.12), { TextColor3 = Theme.TextSub }):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if not tab.Active then
            TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = Theme.Surface }):Play()
            TweenService:Create(textLbl, TweenInfo.new(0.12), { TextColor3 = Theme.TextMuted }):Play()
        end
    end)

    onClick(btn, function()
        for _, t in pairs(Tabs) do
            t.Active = false
            t.Content.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.18), { BackgroundColor3 = Theme.Surface }):Play()
            TweenService:Create(t.Text, TweenInfo.new(0.18), { TextColor3 = Theme.TextMuted }):Play()
            TweenService:Create(t.Indicator, TweenInfo.new(0.18), { Size = UDim2.new(0,3,0,0) }):Play()
        end
        tab.Active = true
        tab.Content.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(30, 26, 48) }):Play()
        TweenService:Create(textLbl, TweenInfo.new(0.18), { TextColor3 = Theme.Text }):Play()
        TweenService:Create(indicator, TweenInfo.new(0.18), { Size = UDim2.new(0,3,0,20) }):Play()
    end)

    Tabs[name] = tab
    return tab
end

