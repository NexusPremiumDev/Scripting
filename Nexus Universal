UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        MainFrame.Visible = not MainFrame.Visible
        return
    end
    if input.KeyCode == Enum.KeyCode.RightControl then
        unload()
        return
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        and Settings.SilentAim and SilentTarget then
        local saved = Camera.CFrame
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, SilentTarget.Position)
        RunService.RenderStepped:Wait()
        Camera.CFrame = saved
    end
end)

-- TARGET
local function findTarget()
    local center = Camera.ViewportSize * 0.5
    local bestT, bestD = nil, Settings.FOVRadius
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isAlive(p) then
            local part = getAnchor(p.Character)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < bestD then bestD = d bestT = part end
                end
            end
        end
    end
    return bestT
end

