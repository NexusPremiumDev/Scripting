local function applySkinChanger()
    task.spawn(function()
        local ok, err = pcall(function()
            local player = Players.LocalPlayer
            local ViewModels = player:WaitForChild("PlayerScripts", 8)
                :WaitForChild("Assets", 8)
                :WaitForChild("ViewModels", 8)
            local Weapons = ViewModels:FindFirstChild("Weapons")
            if not Weapons then
                warn("[Nexus SkinChanger] Weapons folder not found!")
                return
            end

            local function FindSkin(skinName)
                local direct = ViewModels:FindFirstChild(skinName, true)
                if direct then return direct end
                local wanted = string.lower(skinName)
                for _, obj in ipairs(ViewModels:GetDescendants()) do
                    local objName = string.lower(obj.Name)
                    if string.find(objName, wanted, 1, true) or string.find(wanted, objName, 1, true) then
                        return obj
                    end
                end
                return nil
            end

            local function ApplySkin(weaponName, skinName)
                local weapon = Weapons:FindFirstChild(weaponName)
                if not weapon then return false end
                local skin = FindSkin(skinName)
                if not skin then return false end
                for _, child in ipairs(weapon:GetChildren()) do
                    child:Destroy()
                end
                local copied = 0
                for _, child in ipairs(skin:GetChildren()) do
                    local clone = child:Clone()
                    clone.Parent = weapon
                    copied = copied + 1
                end
                return copied > 0
            end

            local skins = {
                {"Bow", "Bat Bow"},
                {"Crossbow", "Frostbite Crossbow"},
                {"Wildcat", "Plasma Wildcat"},
                {"Daggers", "Aces"},
                {"Spray", "Spray Bottle"},
