-- HELPERS
local function getAnchor(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Head")
        or character:FindFirstChildWhichIsA("BasePart")
end

local function getTargetPart(character, partName)
    if not character then return nil end
    if partName == "Head" then
        return character:FindFirstChild("Head") or getAnchor(character)
    else
        return character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("UpperTorso")
            or getAnchor(character)
    end
end

local function isCharAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    return Players:GetPlayerFromCharacter(model) == nil
end

local function rainbowColor()
    return Color3.fromHSV((tick() * 0.35) % 1, 1, 1)
end

local function getCandidates()
    local list = {}
    if Settings.TargetPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                table.insert(list, { char = p.Character, name = p.Name })
            end
        end
    end
    if Settings.TargetNPCs then
        for _, o in ipairs(Workspace:GetChildren()) do
            if isNPC(o) then
                table.insert(list, { char = o, name = o.Name })
            end
        end
    end
    return list
end

