-- LOGIC
local function getClosestTargetInFov()
    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget, bestDist = nil, math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for _, c in ipairs(getCandidates()) do
        local char = c.char
        if not isCharAlive(char) then continue end
        local targetPart = getTargetPart(char, Settings.SilentTargetPart)
        if not targetPart then continue end

        if myRoot then
            local tr = char:FindFirstChild("HumanoidRootPart")
            if tr and (myRoot.Position - tr.Position).Magnitude > Settings.TriggerRange then continue end
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist2d < Settings.FOVRadius and dist2d < bestDist then
            bestDist = dist2d
            bestTarget = { char = char, part = targetPart, name = c.name }
        end
    end
    return bestTarget
end

-- TRIGGER BOT (with wall check)
local function checkTriggerBot()
    if not Settings.TriggerBot then return end

    local now = tick()
    if now - lastTriggerTime < Settings.TriggerDelay then return end

    local target = getClosestTargetInFov()
    if not target or not target.part then return end
    local targetPart = target.part

    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = { LocalPlayer.Character, Camera }

    local result = Workspace:Raycast(origin, direction, raycastParams)

    if result then
        local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
        if hitChar == target.char then
            lastTriggerTime = now
            if mouse1click then
                mouse1click()
            elseif mouse1down and mouse1up then
                mouse1down()
                task.wait(0.01)
                mouse1up()
            else
                local VU = game:GetService("VirtualUser")
                VU:CaptureController()
                VU:ClickButton1(Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2))
            end
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    -- Panic key (X only)
    if input.KeyCode == PANIC_KEY then
        panic()
        return
    end

    if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.RightControl then
        unload()
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 and Settings.SilentAim then
        local target = getClosestTargetInFov()
        if target and target.part then
            local saved = Camera.CFrame
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.part.Position)
            task.delay(0.015, function()
                if Camera then Camera.CFrame = saved end
            end)
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not Running then return end

    -- FOV Circle
    if Settings.ShowFOV or Settings.TriggerBot or Settings.Aimbot or Settings.SilentAim then
        FOVCircle.Visible = true
        FOVCircle.Radius = Settings.FOVRadius
        FOVCircle.Position = UserInputService:GetMouseLocation()
    else
        FOVCircle.Visible = false
    end

    -- Aimbot
    if Settings.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target = getClosestTargetInFov()
        if target and target.part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(target.part.Position)
            if onScreen then
                local current = UserInputService:GetMouseLocation()
                local goal = Vector2.new(screenPos.X, screenPos.Y)
                local delta = (goal - current) / math.max(1, (Settings.AimSmoothness / 10))
                mousemoverel(delta.X, delta.Y)
            end
        end
    end

    -- Trigger Bot
    if Settings.TriggerBot then
        pcall(checkTriggerBot)
    end
end)

-- ESP LOGIC
local BonePairs = {
    { "Head", "Torso" }, { "Head", "UpperTorso" },
    { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local BoneCount = #BonePairs

local function createVisual()
    local v = {
        Box       = Drawing.new("Square"),
        Name      = Drawing.new("Text"),
        Dist      = Drawing.new("Text"),
        HpBg      = Drawing.new("Square"),
        HpFill    = Drawing.new("Square"),
        SkeletonLines = {},
    }
    v.Name.Center = true  v.Name.Size = 13  v.Name.Font = 2
    v.Name.Outline = true v.Name.OutlineColor = Color3.new(0,0,0)
    v.Dist.Center = true  v.Dist.Size = 11  v.Dist.Font = 2
    v.Dist.Outline = true v.Dist.OutlineColor = Color3.new(0,0,0)
    v.HpBg.Filled = true  v.HpFill.Filled = true

    for i = 1, BoneCount do
        local ln = Drawing.new("Line")
        ln.Thickness = 1 ln.Transparency = 1 ln.Visible = false
        v.SkeletonLines[i] = ln
    end
    return v
end

local function removeVisual(v)
    pcall(function()
        v.Box:Remove() v.Name:Remove() v.Dist:Remove()
        v.HpBg:Remove() v.HpFill:Remove()
        for _, ln in ipairs(v.SkeletonLines) do ln:Remove() end
    end)
end

local function hideVisual(v)
    if not v then return end
    v.Box.Visible    = false
    v.Name.Visible   = false
    v.Dist.Visible   = false
    v.HpBg.Visible   = false
    v.HpFill.Visible = false
    for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end
end

RunService.RenderStepped:Connect(function()
    if not Running then return end
    pcall(function()
        local charSet = {}
        local charList = {}

        if Settings.TargetPlayers then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    charSet[p.Character] = true
                    table.insert(charList, { char = p.Character, name = p.Name })
                end
            end
        end
        if Settings.TargetNPCs then
            for _, o in ipairs(Workspace:GetChildren()) do
                if isNPC(o) then
                    charSet[o] = true
                    table.insert(charList, { char = o, name = o.Name })
                end
            end
        end

        -- Cleanup removed characters entirely (respawn, despawn, leave)
        for char, v in pairs(PlayerEntries) do
            if not charSet[char] then
                removeVisual(v)
                PlayerEntries[char] = nil
            end
        end

        for _, e in ipairs(charList) do
            local char = e.char
            local hum = char:FindFirstChildOfClass("Humanoid")

            -- BUG FIX: dead/removed characters → hide stale drawings instead of leaving them frozen
            if not hum or hum.Health <= 0 then
                local v = PlayerEntries[char]
                if v then hideVisual(v) end
                continue
            end

            if not PlayerEntries[char] then PlayerEntries[char] = createVisual() end
            local v = PlayerEntries[char]

            if Settings.ESPEnabled then
                local root = getAnchor(char)
                if root then
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    local dist = (root.Position - Camera.CFrame.Position).Magnitude

                    if onScreen and pos.Z > 0.5 and dist <= Settings.MaxDistance then
                        local color = Settings.ESPRainbow and rainbowColor() or Settings.EnemyColor
                        local z = math.max(pos.Z, 1)
                        local sx = math.clamp(1800 / z, 10, 400)
                        local sy = math.clamp(2800 / z, 14, 620)
                        local topX, topY = pos.X - sx/2, pos.Y - sy/2

                        v.Box.Size = Vector2.new(sx, sy) v.Box.Position = Vector2.new(topX, topY)
                        v.Box.Color = color v.Box.Thickness = 1 v.Box.Visible = Settings.ESPBoxes
                        v.Name.Text = e.name v.Name.Position = Vector2.new(pos.X, topY - 26) v.Name.Color = color v.Name.Visible = Settings.ESPNames
                        v.Dist.Text = "[" .. math.floor(dist) .. "m]" v.Dist.Position = Vector2.new(pos.X, topY - 12) v.Dist.Color = color v.Dist.Visible = Settings.ESPDistance

                        if Settings.ESPHealthBar then
                            local maxHp = math.max(1, hum.MaxHealth)
                            local hpPct = math.clamp(hum.Health / maxHp, 0, 1)
                            local barW, barX, barY, barH = 3, topX - 7, topY, sy
                            local hpColor = hpPct > 0.5 and Color3.fromRGB(74, 222, 128) or (hpPct > 0.25 and Color3.fromRGB(255, 200, 87) or Color3.fromRGB(255, 85, 102))
                            v.HpBg.Size = Vector2.new(barW + 2, barH + 2) v.HpBg.Position = Vector2.new(barX - 1, barY - 1) v.HpBg.Color = Color3.new(0,0,0) v.HpBg.Visible = true
                            local fillH = barH * hpPct
                            v.HpFill.Size = Vector2.new(barW, math.max(0, fillH)) v.HpFill.Position = Vector2.new(barX, barY + (barH - fillH)) v.HpFill.Color = hpColor v.HpFill.Visible = true
                        else v.HpBg.Visible = false v.HpFill.Visible = false end

                        if Settings.ESPSkeleton then
                            for i, pair in ipairs(BonePairs) do
                                local ln = v.SkeletonLines[i]
                                local partA, partB = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
                                if partA and partB then
                                    local a2, aOn = Camera:WorldToViewportPoint(partA.Position)
                                    local b2, bOn = Camera:WorldToViewportPoint(partB.Position)
                                    if aOn and bOn and a2.Z > 0.5 and b2.Z > 0.5 then
                                        ln.From = Vector2.new(a2.X, a2.Y) ln.To = Vector2.new(b2.X, b2.Y) ln.Color = color ln.Visible = true
                                    else ln.Visible = false end
                                else ln.Visible = false end
                            end
                        else for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end end
                    else
                        hideVisual(v)
                    end
                else
                    hideVisual(v)
                end
            else
                hideVisual(v)
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(p)
    if p.Character and PlayerEntries[p.Character] then
        removeVisual(PlayerEntries[p.Character])
        PlayerEntries[p.Character] = nil
    end
    -- fallback: any orphaned entries for this player's old characters
    for char, v in pairs(PlayerEntries) do
        if Players:GetPlayerFromCharacter(char) == p then
            removeVisual(v)
            PlayerEntries[char] = nil
        end
    end
end)

