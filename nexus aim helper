local function UI_Toggle(parent, label, key, onChange)
    local row = mk("TextButton", { Size = UDim2.new(1,-8,0,38), BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0, Text = "", AutoButtonColor = false }, parent)
    corner(row, 8)
    local rowStroke = stroke(row, Theme.Border, 1, 0.5)
    mk("TextLabel", { Size = UDim2.new(1,-70,1,0), Position = UDim2.new(0,14,0,0), BackgroundTransparency = 1, Text = label, TextColor3 = Theme.Text, Font = FontMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Active = false }, row)
    local track = mk("Frame", { Size = UDim2.new(0,36,0,20), Position = UDim2.new(1,-48,0.5,-10), BackgroundColor3 = Settings[key] and Theme.Accent or Color3.fromRGB(50,56,72), BorderSizePixel = 0, Active = false }, row)
    corner(track, 10)
    local knob = mk("Frame", { Size = UDim2.new(0,14,0,14), Position = Settings[key] and UDim2.new(0,19,0,3) or UDim2.new(0,3,0,3), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Active = false }, track)
    corner(knob, 7)
    local function upd(state, animate)
        local pos = state and UDim2.new(0,19,0,3) or UDim2.new(0,3,0,3)
        local col = state and Theme.Accent or Color3.fromRGB(50,56,72)
        local info = TweenInfo.new(animate and 0.22 or 0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(knob, info, { Position = pos }):Play()
        TweenService:Create(track, info, { BackgroundColor3 = col }):Play()
    end
    row.MouseEnter:Connect(function() TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Theme.SurfaceHov }):Play() TweenService:Create(rowStroke, TweenInfo.new(0.15), { Color = Theme.BorderHov }):Play() end)
    row.MouseLeave:Connect(function() TweenService:Create(row, TweenInfo.new(0.15), { BackgroundColor3 = Theme.SurfaceAlt }):Play() TweenService:Create(rowStroke, TweenInfo.new(0.15), { Color = Theme.Border }):Play() end)
    onClick(row, function()
        Settings[key] = not Settings[key]
        upd(Settings[key], true)
        if onChange then pcall(onChange, Settings[key]) end
    end)
end

local function UI_Slider(parent, label, key, minVal, maxVal, step, suffix, onChange)
    local row = mk("Frame", { Size = UDim2.new(1,-8,0,52), BackgroundColor3 = Theme.SurfaceAlt, BorderSizePixel = 0 }, parent)
    corner(row, 8)
    local rowStroke = stroke(row, Theme.Border, 1, 0.5)
    mk("TextLabel", { Size = UDim2.new(1,-70,0,20), Position = UDim2.new(0,14,0,6), BackgroundTransparency = 1, Text = label, TextColor3 = Theme.Text, Font = FontMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Active = false }, row)
    local valueLbl = mk("TextLabel", { Size = UDim2.new(0,60,0,20), Position = UDim2.new(1,-74,0,6), BackgroundTransparency = 1, Text = tostring(Settings[key]) .. (suffix or ""), TextColor3 = Theme.Accent, Font = FontBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Active = false }, row)
    local trackBg = mk("Frame", { Size = UDim2.new(1,-28,0,4), Position = UDim2.new(0,14,0,40), BackgroundColor3 = Color3.fromRGB(44,50,68), BorderSizePixel = 0, Active = false }, row)
    corner(trackBg, 2)
    local fill = mk("Frame", { Size = UDim2.new(0,0,1,0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Active = false }, trackBg)
    corner(fill, 2) grad(fill, Theme.Accent, Theme.Accent2, 0)
    local knob = mk("Frame", { Size = UDim2.new(0,14,0,14), Position = UDim2.new(0,-7,0.5,-7), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 3, Active = false }, trackBg)
    corner(knob, 7) stroke(knob, Theme.Accent, 2, 0)
    local hitArea = mk("TextButton", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.5, -12), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 5 }, trackBg)
    local function apply(newVal)
        Settings[key] = newVal
        local pct = (newVal - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(pct, 0, 1, 0) knob.Position = UDim2.new(pct, -7, 0.5, -7)
        valueLbl.Text = tostring(newVal) .. (suffix or "")
        if onChange then pcall(onChange, newVal) end
    end
    apply(Settings[key])
    local draggingSlider = false
    local function setFromAbsX(absX)
        local relX = absX - hitArea.AbsolutePosition.X
        local pct = math.clamp(relX / hitArea.AbsoluteSize.X, 0, 1)
        local raw = minVal + pct * (maxVal - minVal)
        local newVal = math.floor(raw / step + 0.5) * step
        newVal = math.clamp(newVal, minVal, maxVal) apply(newVal)
    end
    hitArea.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = true setFromAbsX(input.Position.X) end end)
    UserInputService.InputChanged:Connect(function(input) if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromAbsX(input.Position.X) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSlider = false end end)
end

