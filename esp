local function makeToggle(parent, yPos, labelText, defaultState, callback)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -30, 0, 32)
	row.Position = UDim2.new(0, 15, 0, yPos)
	row.BackgroundTransparency = 1
	row.Parent = parent

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -50, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText
	lbl.TextColor3 = Color3.fromRGB(180, 180, 200)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local tBg = Instance.new("Frame")
	tBg.Size = UDim2.new(0, 40, 0, 20)
	tBg.Position = UDim2.new(1, -40, 0.5, -10)
	tBg.BackgroundColor3 = defaultState and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(45, 45, 55)
	tBg.BorderSizePixel = 0
	tBg.Parent = row
	Instance.new("UICorner", tBg).CornerRadius = UDim.new(1, 0)

	local tKnob = Instance.new("Frame")
	tKnob.Size = UDim2.new(0, 14, 0, 14)
	tKnob.Position = defaultState and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
	tKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	tKnob.BorderSizePixel = 0
	tKnob.Parent = tBg
	Instance.new("UICorner", tKnob).CornerRadius = UDim.new(1, 0)

	local state = defaultState
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Parent = row

	btn.MouseButton1Click:Connect(function()
		state = not state
		TweenService:Create(tBg,   TweenInfo.new(0.15), { BackgroundColor3 = state and Color3.fromRGB(80,200,120) or Color3.fromRGB(45,45,55) }):Play()
		TweenService:Create(tKnob, TweenInfo.new(0.15), { Position = state and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7) }):Play()
		callback(state)
	end)
end

