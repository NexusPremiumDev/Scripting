}

local SOURCES = {SOURCE_1, SOURCE_2, SOURCE_3, SOURCE_4}

local launching = false

local function launch(index)
    if launching then return end
    launching = true

    -- Close Nexus BEFORE the selected script starts.
    Nexus.Enabled = false
    pcall(function() Nexus:Destroy() end)

    task.defer(function()
        local source = SOURCES[index]
        local fn, compileError = loadstring(source)

        if not fn then
            warn("[Nexus] "..tostring(compileError))
            return
        end

        local ok, runtimeError = pcall(fn)
        if not ok then
            warn("[Nexus] Module "..tostring(index).." error: "..tostring(runtimeError))
        end
    end)
end

for i, button in ipairs(buttons) do
    button.MouseButton1Click:Connect(function()
        launch(i)
    end)
end

Close.MouseButton1Click:Connect(function()
    pcall(function() Nexus:Destroy() end)
end)

-- Dragging
do
    local dragging = false
    local dragStart
    local startPos

    Top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)

    Top.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end
