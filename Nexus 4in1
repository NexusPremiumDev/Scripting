local buttons = {
    addButton(1, "TSB", "Nexus TSB • combat / visual / utility"),
    addButton(2, "RIVALS LEGIT", "Nexus Rivals Legit"),
    addButton(3, "RIVALS RAGE", "Nexus Rivals Rage"),
