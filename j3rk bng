-- Fonksiyonalite: Jerk
JerkBtn.MouseButton1Click:Connect(function()
	if not guiUnlocked then return end
	isJorking = not isJorking
	JerkBtn.BackgroundColor3 = isJorking and Color3.fromRGB(40, 180, 80) or Color3.fromRGB(50, 120, 200)
	JerkBtn.Text = isJorking and "Toggle Jerk On" or "Toggle Jerk Off"
	
	if isJorking then
		task.spawn(function()
			local char = player.Character
			local animtr = char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid:FindFirstChildOfClass("Animator")
			if not animtr then return end
			
			while isJorking and char and char.Humanoid.Health > 0 do
				local r15 = isR15(player)
				if not jerkTrack then
					local anim = Instance.new("Animation")
					anim.AnimationId = not r15 and "rbxassetid://72042024" or "rbxassetid://698251653"
					pcall(function() jerkTrack = animtr:LoadAnimation(anim) end)
				end
				if jerkTrack and not jerkTrack.IsPlaying then
					jerkTrack:Play()
					jerkTrack:AdjustSpeed(r15 and 2.6 or 2.4)
					jerkTrack.TimePosition = 0.55
				end
				task.wait(0.05)
			end
			if jerkTrack then jerkTrack:Stop() jerkTrack = nil end
		end)
	else
		if jerkTrack then jerkTrack:Stop() jerkTrack = nil end
	end
end)

-- Fonksiyonalite: Get Sucked (Tam Entegre ve Güvenli Mantık)
GetSuckBtn.MouseButton1Click:Connect(function()
	if not guiUnlocked then return end
	
	if not running then
		local victim = UsernameBox.Text:lower()
		targetPlayer = nil
		
		for _, p in pairs(Players:GetPlayers()) do
			if string.find(p.Name:lower(), victim) or string.find(p.DisplayName:lower(), victim) then
				targetPlayer = p
				break
			end
		end
		
		if targetPlayer and targetPlayer.Character then
			local char = player.Character
			local targetChar = targetPlayer.Character
			
			local humanoidRootPart = char and char:FindFirstChild("HumanoidRootPart")
			local targetRootPart = targetChar:FindFirstChild("HumanoidRootPart")
			
			if humanoidRootPart and targetRootPart then
				running = true
				GetSuckBtn.Text = "STOP GET SUCKED"
				GetSuckBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
				
				originalGravity = workspace.Gravity
				workspace.Gravity = 0
				
				task.spawn(function()
					while running and humanoidRootPart and targetRootPart and humanoidRootPart.Position.Y <= 44 do
						task.wait()
						if not running then break end
						humanoidRootPart.CFrame = humanoidRootPart.CFrame * CFrame.new(0, 1.5, 0)
					end
					
					task.wait(1)
					if not running then return end
					
					attachmentLoop = RunService.Stepped:Connect(function()
						if running and humanoidRootPart and targetRootPart then
							humanoidRootPart.CFrame = targetRootPart.CFrame * CFrame.new(0, 2.3, -1.1) * CFrame.Angles(0, math.pi, 0)
							if humanoidRootPart.AssemblyLinearVelocity then
								humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
							else
								humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
							end
						end
					end)
					
					task.wait(1)
					if not running then return end
					
					local r15Check = isR15(player)
					local animationId = r15Check and "rbxassetid://5918726674" or "rbxassetid://148840371"
					local animation = Instance.new('Animation')
					animation.AnimationId = animationId
					
					local humanoid = char:FindFirstChildOfClass("Humanoid")
					if humanoid then
						local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
						pcall(function()
							animTrack = animator:LoadAnimation(animation)
							animTrack:Play()
							animTrack:AdjustSpeed(r15Check and 1 or 3)
						end)
					end
				end)
			end
		end
	else
		running = false
		GetSuckBtn.Text = "START GET SUCKED"
		GetSuckBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		
		if originalGravity then
			workspace.Gravity = originalGravity
			originalGravity = nil
		end
		
		if attachmentLoop then
			attachmentLoop:Disconnect()
			attachmentLoop = nil
		end
		
		if animTrack then
			animTrack:Stop()
			animTrack = nil
		end
	end
end)

