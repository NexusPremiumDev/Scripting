local function CSl(parent,title,y,min,max,def,cb) local f=Instance.new("Frame",parent) f.Size=UDim2.new(0.92,0,0,55) f.Position=UDim2.new(0.04,0,0,y) f.BackgroundColor3=Color3.fromRGB(24,24,30) f.BorderSizePixel=0 Instance.new("UICorner",f).CornerRadius=UDim.new(0,5) local lbl=Instance.new("TextLabel",f) lbl.Size=UDim2.new(1,-20,0,18) lbl.Position=UDim2.new(0,10,0,4) lbl.BackgroundTransparency=1 lbl.Text=title..": "..def lbl.TextColor3=Color3.fromRGB(255,255,255) lbl.Font=Enum.Font.GothamMedium lbl.TextSize=10 lbl.TextXAlignment=Enum.TextXAlignment.Left local trk=Instance.new("Frame",f) trk.Size=UDim2.new(1,-20,0,8) trk.Position=UDim2.new(0,10,0,28) trk.BackgroundColor3=Color3.fromRGB(45,45,52) trk.BorderSizePixel=0 Instance.new("UICorner",trk).CornerRadius=UDim.new(1,0) local fill=Instance.new("Frame",trk) local pc=(def-min)/(max-min) fill.Size=UDim2.new(pc,0,1,0) fill.BackgroundColor3=Color3.fromRGB(255,0,150) fill.BorderSizePixel=0 Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0) local knob=Instance.new("TextButton",trk) knob.Size=UDim2.new(0,14,0,14) knob.Position=UDim2.new(pc,-7,0.5,-7) knob.BackgroundColor3=Color3.fromRGB(255,255,255) knob.BorderSizePixel=0 knob.Text="" knob.AutoButtonColor=false Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0) local drag=false local function upd(p) local v=math.floor(min+(max-min)*p) fill.Size=UDim2.new(p,0,1,0) knob.Position=UDim2.new(p,-7,0.5,-7) lbl.Text=title..": "..v pcall(function() cb(v) end) end knob.MouseButton1Down:Connect(function() drag=true end) local endConn; endConn = UIS.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end) f.Destroying:Connect(function() endConn:Disconnect() end) local changeConn; changeConn = UIS.InputChanged:Connect(function(inp) if drag and inp.UserInputType==Enum.UserInputType.MouseMovement then local pos=UIS:GetMouseLocation() upd(math.clamp((pos.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)) end end) f.Destroying:Connect(function() changeConn:Disconnect() end) trk.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then local pos=UIS:GetMouseLocation() upd(math.clamp((pos.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)) end end) return f,function(nv) upd((nv-min)/(max-min)) end end

