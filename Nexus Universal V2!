-- Vehicle Fly
function StartVehicleFly()
    StopVehicleFly()
    VehicleFlyEnabled = true
    local cam = Camera
    local smoothness = 0.92
    coroutine.wrap(function()
        local seatFound = false
        local searchAttempts = 0
        while VehicleFlyEnabled and not seatFound and searchAttempts < 50 do
            pcall(function()
                local char = Player.Character if not char then return end
                local hum = char:FindFirstChildOfClass("Humanoid") if not hum then return end
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("VehicleSeat") and v.Occupant == hum then
                        seatFound = true
                        local car = v.Parent
                        if car and car:IsA("Model") then
                            local mainPart = car.PrimaryPart or v
                            pcall(function() if car:FindFirstChild("VFlyBV") then car.VFlyBV:Destroy() end end)
                            pcall(function() if car:FindFirstChild("VFlyBG") then car.VFlyBG:Destroy() end end)
                            VehicleFlyBV = Instance.new("BodyVelocity") VehicleFlyBV.MaxForce = Vector3.new(1e6,1e6,1e6) VehicleFlyBV.Velocity = Vector3.zero VehicleFlyBV.P = 100000 VehicleFlyBV.Name = "VFlyBV" VehicleFlyBV.Parent = mainPart
                            VehicleFlyBG = Instance.new("BodyGyro") VehicleFlyBG.MaxTorque = Vector3.new(1e6,1e6,1e6) VehicleFlyBG.CFrame = mainPart.CFrame VehicleFlyBG.P = 100000 VehicleFlyBG.D = 500 VehicleFlyBG.Name = "VFlyBG" VehicleFlyBG.Parent = mainPart
                            local velocity = Vector3.zero
                            VehicleFlyConn = RunService.RenderStepped:Connect(function(deltaTime)
                                if not VehicleFlyEnabled then return end
                                pcall(function()
                                    if not VehicleFlyBV or not VehicleFlyBG or not VehicleFlyBV.Parent then return end
                                    local targetDir = Vector3.zero
                                    local inputActive = false
                                    if UIS:IsKeyDown(Enum.KeyCode.W) then targetDir += cam.CFrame.LookVector inputActive = true end
                                    if UIS:IsKeyDown(Enum.KeyCode.S) then targetDir -= cam.CFrame.LookVector inputActive = true end
                                    if UIS:IsKeyDown(Enum.KeyCode.A) then targetDir -= cam.CFrame.RightVector inputActive = true end
                                    if UIS:IsKeyDown(Enum.KeyCode.D) then targetDir += cam.CFrame.RightVector inputActive = true end
                                    if UIS:IsKeyDown(Enum.KeyCode.E) then targetDir += Vector3.new(0,1,0) inputActive = true end
                                    if UIS:IsKeyDown(Enum.KeyCode.Q) then targetDir -= Vector3.new(0,1,0) inputActive = true end
                                    if inputActive then
                                        local targetVelocity = targetDir.Unit * VehicleFlySpeed
                                        velocity = velocity:Lerp(targetVelocity, 1 - smoothness ^ (deltaTime * 60))
                                    else
                                        velocity = velocity:Lerp(Vector3.zero, 1 - 0.95 ^ (deltaTime * 60))
                                    end
                                    VehicleFlyBV.Velocity = velocity
                                    local flatCamLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                                    if flatCamLook.Magnitude > 0.01 then
                                        flatCamLook = flatCamLook.Unit
                                        local currentUp = mainPart.CFrame.UpVector
                                        local newCF = CFrame.lookAt(mainPart.Position, mainPart.Position + flatCamLook, currentUp)
                                        VehicleFlyBG.CFrame = newCF
                                    end
                                end)
                            end)
                        end
                        break
                    end
                end
            end)
            searchAttempts += 1
            RunService.Heartbeat:Wait()
        end
    end)()
end
function StopVehicleFly()
    VehicleFlyEnabled = false
    pcall(function() if VehicleFlyConn then VehicleFlyConn:Disconnect() end end) VehicleFlyConn = nil
    pcall(function() if VehicleFlyBV then VehicleFlyBV:Destroy() end end) VehicleFlyBV = nil
    pcall(function() if VehicleFlyBG then VehicleFlyBG:Destroy() end end) VehicleFlyBG = nil
    VehicleSeatOccupied = nil
end

