local Tabs = {}
local currentTab = "Home"

local function switchTab(name)
    if currentTab == name then return end
    if Tabs[currentTab] then Tabs[currentTab].Cont.Visible = false end
    if Tabs[name] then Tabs[name].Cont.Visible = true end
    for tabName, tab in pairs(Tabs) do
        if tabName == name then
            SafeTween(tab.Btn, {BackgroundColor3 = tab.ActiveColor})
        else
            SafeTween(tab.Btn, {BackgroundColor3 = tab.DefaultColor})
        end
    end
    currentTab = name
end

