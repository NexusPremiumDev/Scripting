-- ESP
function EnableESP()
    for _,obj in pairs(ESPObjects) do pcall(function() obj:Destroy() end) end ESPObjects = {}
    local function AE(p)
        if p == Player then return end
        local function S(c)
            pcall(function()
                local head = c:FindFirstChild("Head")
                if not head or head:FindFirstChild("ESP_TAG") then return end
                local bill = Instance.new("BillboardGui")
                bill.Name = "ESP_TAG"
                bill.Size = UDim2.new(0, 200, 0, 40)
                bill.StudsOffset = Vector3.new(0, 2.5, 0)
                bill.AlwaysOnTop = true
                bill.Parent = head
                table.insert(ESPObjects, bill)
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = p.Name
                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLabel.Font = Enum.Font.GothamBold
                nameLabel.TextSize = 12
                nameLabel.Parent = bill
                local distLabel = Instance.new("TextLabel")
                distLabel.Size = UDim2.new(1, 0, 0.5, 0)
                distLabel.Position = UDim2.new(0, 0, 0.5, 0)
                distLabel.BackgroundTransparency = 1
                distLabel.Text = "0m"
                distLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                distLabel.Font = Enum.Font.GothamMedium
                distLabel.TextSize = 11
                distLabel.Parent = bill
                local hl = Instance.new("Highlight")
                hl.Name = "ESP_TAG"
                hl.FillColor = Color3.fromRGB(255, 0, 150)
                hl.FillTransparency = 0.6
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineTransparency = 0.2
                hl.Adornee = c
                hl.Parent = c
                table.insert(ESPObjects, hl)
                spawn(function()
                    while ESPEnabled and bill.Parent and head.Parent do
                        pcall(function()
                            local myChar = Player.Character
                            if not myChar then return end
                            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                            local targetHRP = c:FindFirstChild("HumanoidRootPart")
                            if not myHRP or not targetHRP then return end
                            local dist = math.floor((myHRP.Position - targetHRP.Position).Magnitude)
                            distLabel.Text = dist .. "m"
                            if dist < 50 then
                                distLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                                hl.FillColor = Color3.fromRGB(255, 0, 0)
                            elseif dist < 150 then
                                distLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                                hl.FillColor = Color3.fromRGB(255, 200, 0)
                            else
                                distLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
                                hl.FillColor = Color3.fromRGB(0, 255, 100)
                            end
                        end)
                        wait(0.5)
                    end
                end)
            end)
        end
        if p.Character then S(p.Character) end
        p.CharacterAdded:Connect(function(c) wait(0.3) S(c) end)
    end
    for _,p in pairs(Players:GetPlayers()) do AE(p) end
    Players.PlayerAdded:Connect(function(p) wait(0.5) AE(p) end)
    StarterGui:SetCore("SendNotification", {Title = "ESP", Text = "ESP açık", Duration = 2})
end

function DisableESP()
    ESPEnabled = false
    for _,o in pairs(ESPObjects) do pcall(function() o:Destroy() end) end
    ESPObjects = {}
    StarterGui:SetCore("SendNotification", {Title = "ESP", Text = "ESP kapalı", Duration = 2})
end

