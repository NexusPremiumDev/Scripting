local function nexusSwapModelChildren(weapon, skin)
	if not weapon or not skin or weapon == skin then return false end
	local skinHasController = false
	for _, child in ipairs(skin:GetChildren()) do
		if child:IsA("AnimationController") then
			skinHasController = true
			break
		end
	end
	local savedController = nil
	if not skinHasController then
		pcall(function()
			local existing = weapon:FindFirstChildOfClass("AnimationController")
			if existing then
				savedController = existing:Clone()
			end
		end)
	end
	local staged = {}
	for _, child in ipairs(skin:GetChildren()) do
		local ok, clone = pcall(function() return child:Clone() end)
		if ok and clone then
			table.insert(staged, clone)
		end
	end
	if #staged == 0 then
		if savedController then
			pcall(function() savedController:Destroy() end)
		end
		return false
	end
	for _, child in ipairs(weapon:GetChildren()) do
		child:Destroy()
	end
	for _, clone in ipairs(staged) do
		clone.Parent = weapon
	end
	if savedController then
		savedController.Parent = weapon
	end
	return true
end

