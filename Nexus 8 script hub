-- Role Finder Function for MM2
local function getMM2Role(p)
    if p == Player then return "Self", Color3.fromRGB(255, 255, 255) end
    local char = p.Character
    local backpack = p:FindFirstChild("Backpack")
    
    local function checkContainer(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                if n:find("gun") or n:find("revolver") or n:find("sheriff") or n:find("peacemaker") then
                    return "Sheriff", Color3.fromRGB(0, 150, 255)
                elseif n:find("knife") or n:find("dagger") or n:find("murder") or n:find("godly") or n:find("chroma") then
                    return "Murderer", Color3.fromRGB(255, 50, 50)
                end
            end
        end
        return nil
    end
    
    local role = checkContainer(char) or checkContainer(backpack)
    if role then return role, role == "Murderer" and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 150, 255) end
    return "Innocent", Color3.fromRGB(50, 255, 50)
end

