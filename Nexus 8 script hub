local function itemMatchesView(item)
	local view = Apex.View
	if view == "All" then return true end
	if view == "Games" then return item.Category == "Games" end
	if view == "Utilities" then return item.Category == "Utilities" end
	if view == "Universal" then return hasTag(item, "Universal") or string.find(item.Name, "UNIVERSAL", 1, true) ~= nil end
	if view == "Favorites" then return State.Favorites[item.Id] == true end
	if view == "Recent" then
		for _, id in ipairs(State.Recent) do
			if id == item.Id then return true end
		end
		return false
	end
	return true
end
local function itemMatchesQuery(item)
	local q = string.lower(Apex.Query or "")
	if q == "" then return true end
	local hay = string.lower(item.Name .. " " .. (item.Sub or "") .. " " .. table.concat(item.Tags or {}, " "))
	return string.find(hay, q, 1, true) ~= nil
end
local function sortedItems()
	local entries = {}
	local recentRank = {}
	for i, id in ipairs(State.Recent) do recentRank[id] = i end
	for _, item in ipairs(Apex.Registry) do
		entries[#entries + 1] = item
	end
	table.sort(entries, function(a, b)
		if Apex.View == "Recent" then
			return (recentRank[a.Id] or 999) < (recentRank[b.Id] or 999)
		end
		local fa = State.Favorites[a.Id] and 1 or 0
		local fb = State.Favorites[b.Id] and 1 or 0
		if fa ~= fb then return fa > fb end
		local ca = Apex.IsCurrentGame(a) and 1 or 0
		local cb = Apex.IsCurrentGame(b) and 1 or 0
		if ca ~= cb then return ca > cb end
		return a.Order < b.Order
	end)
	return entries
end
