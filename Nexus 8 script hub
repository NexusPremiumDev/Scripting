local function GetSilentMurdererPart()
	local cam = workspace.CurrentCamera
	if not cam then
		return nil, nil
	end
	local murderer = RoleSummary.Murderer
	if not murderer then
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and GetRole(player) == "Murderer" then
				murderer = player
				break
			end
		end
	end
	if not murderer or murderer == LocalPlayer or not murderer.Character then
		return nil, nil
	end
	local hum = murderer.Character:FindFirstChildOfClass("Humanoid")
	local part = murderer.Character:FindFirstChild(State.AimPart) or murderer.Character:FindFirstChild("Head") or murderer.Character:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not part then
		return nil, nil
	end
	local viewport = cam.ViewportSize
	if not viewport or viewport.Magnitude < 1 then
		return nil, nil
	end
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local point, onScreen = cam:WorldToViewportPoint(part.Position)
	if not onScreen or point.Z <= 0 then
		return nil, nil
	end
	local dist2d = (Vector2.new(point.X, point.Y) - center).Magnitude
	local fovValue = tonumber(State.SilentFOV) or 2000
	local maxFov = fovValue >= 2000 and math.huge or fovValue
	if dist2d > maxFov then
		return nil, nil
	end
	return part, murderer
end
local function FireSilentAim()
	local cam = workspace.CurrentCamera
	if not cam then
		return false
	end
	local part = GetSilentMurdererPart()
	if not part then
		return false
	end
	local targetPos = part.Position
	if State.SilentPrediction then
		pcall(function()
			targetPos = targetPos + part.AssemblyLinearVelocity * (tonumber(State.SilentPredictionAmount) or 0.12)
		end)
	end
	local saved = cam.CFrame
	cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
	task.delay(math.max(tonumber(State.SilentDelay) or 0.02, 0), function()
		local currentCam = workspace.CurrentCamera
		if currentCam and currentCam.Parent then
			currentCam.CFrame = saved
		end
	end)
	return true
end
local function GetTargetPlayer()
	local cam = workspace.CurrentCamera
	if not cam then
		return nil, nil
	end
	local mouseLocation = UserInputService:GetMouseLocation()
	local bestPlayer = nil
	local bestPart = nil
	local bestDistance = State.AimFOV
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local role = GetRole(player)
			local wanted = State.AimTargetMode == "Nearest" or role == State.AimTargetMode
			if wanted then
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				local part = player.Character:FindFirstChild(State.AimPart) or player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and part then
					local point, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen and point.Z > 0 then
						local distance = (Vector2.new(point.X, point.Y) - mouseLocation).Magnitude
						if distance < bestDistance then
							bestDistance = distance
							bestPlayer = player
							bestPart = part
						end
					end
				end
			end
		end
	end
	return bestPlayer, bestPart
end
