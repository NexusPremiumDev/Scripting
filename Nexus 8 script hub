local SOURCES = {SOURCE_1, SOURCE_2, SOURCE_3, SOURCE_4, SOURCE_5, SOURCE_6, SOURCE_7, SOURCE_8}

local launching = false

local function launch(index)
    if launching then return end
    launching = true

    -- Close Nexus BEFORE the selected script starts.
    Nexus.Enabled = false
    pcall(function() Nexus:Destroy() end)

    task.defer(function()
        local source = SOURCES[index]
        local fn, compileError = loadstring(source)

        if not fn then
            warn("[Nexus] "..tostring(compileError))
            return
        end

        local ok, runtimeError = pcall(fn)
        if not ok then
            warn("[Nexus] Module "..tostring(index).." error: "..tostring(runtimeError))
        end
    end)
end

