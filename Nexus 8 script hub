local AlertInside, LastAlertAt, LastDodgeAt, LastCalloutName = false, 0, 0, nil
local function UpdateMM2Pro()
	local murderer = RoleSummary.Murderer
	local mChar = murderer and murderer.Character
	local mRoot = mChar and mChar:FindFirstChild("HumanoidRootPart")
	local mHum = mChar and mChar:FindFirstChildOfClass("Humanoid")
	local selfIsMurderer = murderer == LocalPlayer or GetRole(LocalPlayer) == "Murderer"
	local alive = RootPart and RootPart.Parent and Humanoid and Humanoid.Health > 0
	local murdererAlive = mRoot and mHum and mHum.Health > 0
	if State.SpectateMurderer then
		local cam = workspace.CurrentCamera
		if cam then
			if murdererAlive and cam.CameraSubject ~= mHum then
				pcall(function()
					cam.CameraSubject = mHum
				end)
			elseif not murdererAlive and Humanoid and cam.CameraSubject ~= Humanoid then
				pcall(function()
					cam.CameraSubject = Humanoid
				end)
			end
		end
	end
	if State.AutoCallout then
		if murderer and murderer ~= LocalPlayer then
			if LastCalloutName ~= murderer.Name then
				LastCalloutName = murderer.Name
				SendChatMessage("Murderer is " .. murderer.Name .. "!")
			end
		else
			LastCalloutName = nil
		end
	end
	if alive and murdererAlive and not selfIsMurderer then
		local distance = (mRoot.Position - RootPart.Position).Magnitude
		if State.MurdererAlert then
			local inside = distance <= (State.MurdererAlertRange or 25)
			if inside and (not AlertInside or os.clock() - LastAlertAt >= 3) then
				LastAlertAt = os.clock()
				FlashMurdererAlert()
				Notify("WARNING: Murderer is " .. tostring(math.floor(distance)) .. "m away!", 2)
			end
			AlertInside = inside
		else
			AlertInside = false
		end
		if State.AutoDodge and distance <= (State.AutoDodgeRange or 12) and os.clock() - LastDodgeAt >= 1.2 then
			LastDodgeAt = os.clock()
			pcall(function()
				local away = RootPart.Position - mRoot.Position
				local flat = Vector3.new(away.X, 0, away.Z)
				if flat.Magnitude < 0.1 then
					flat = -RootPart.CFrame.LookVector
				end
				Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				RootPart.AssemblyLinearVelocity = flat.Unit * 38 + Vector3.new(0, 34, 0)
			end)
		end
	else
		AlertInside = false
	end
	UpdateCoinESP()
	UpdateSkinChanger()
end
