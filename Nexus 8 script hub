UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if silentEnabled then
			fireSilentAim()
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAimingKeyHeld = true
		if rageModeEnabled and skyCampEnabled then
			local hrp = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				scopeSkyReturnCFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(hrp.Orientation.Y), 0)
				scopeSkyReturnPending = true
			end
			
			
			skyCampSuspended = true
			if skyCampPosition then skyCampPosition:Destroy(); skyCampPosition = nil end
		end
	elseif input.KeyCode == Enum.KeyCode.B then
		silentEnabled = not silentEnabled
		pcall(function()
			if _G.SilentAim and _G.SilentAim.Toggle then _G.SilentAim.Toggle(silentEnabled) end
		end)
		
		pcall(function()
			local bags = {}
			if type(Toggles) == "table" then table.insert(bags, Toggles) end
			if Library and type(Library.Toggles) == "table" then table.insert(bags, Library.Toggles) end
			for _, bag in ipairs(bags) do
				local t = bag["SilentAim"]
				if t then
					if t.SetValue then pcall(function() t:SetValue(silentEnabled) end) end
					pcall(function() t.Value = silentEnabled end)
				end
			end
		end)
		print("[Ultra Rage] Silent Aim:", silentEnabled and "ON" or "OFF")
	elseif input.KeyCode == Enum.KeyCode.P then
		toggleRageMode()
	elseif input.KeyCode == Enum.KeyCode.X then
		ESP_CONFIG.Enabled = not ESP_CONFIG.Enabled
		if Toggles and Toggles["EspRainbow"] then
			pcall(function() Toggles["EspRainbow"]:SetValue(ESP_CONFIG.Enabled) end)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAimingKeyHeld = false
		if scopeSkyReturnPending and rageModeEnabled then
			local hrp = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			local hum = k.Character and k.Character:FindFirstChildOfClass("Humanoid")
			if hrp and scopeSkyReturnCFrame then hrp.CFrame = scopeSkyReturnCFrame end
			if hum then hum.PlatformStand = false; hum.AutoRotate = true end
			scopeSkyReturnPending = false
			scopeSkyReturnCFrame = nil
			skyCampSuspended = false
			task.defer(function() if rageModeEnabled then toggleSkyCamp(true) end end)
		elseif not skyCampEnabled and not loopGotoEnabled then
			local hum = k.Character and k.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.PlatformStand = false end
		end
	end
end)

