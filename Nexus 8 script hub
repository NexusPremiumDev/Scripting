function ClearAllGoldESP() NexusSetESP("Gold", false) end
function ClearAllEntityESP() NexusSetESP("Entity", false) end
function ClearAllLadderESP() NexusSetESP("Ladder", false) end
function ClearAllFuseESP() NexusSetESP("Fuse", false) end

function ClearAllESP()
    for _, kind in pairs(NexusESPKindMap) do NexusSetESP(kind, false) end
    NexusESPLibrary:ClearAllESP()
end

function UpdateAllESP()
    if not Toggles then return end
    for kind in pairs(NexusESPKindMap) do NexusSyncKind(kind) end
end

-- Keep new ESP color mapping in sync with the existing color pickers.
local function NexusRefreshESPColors()
    local colors = {
        Door=DoorColor, Objective=ItemsColor, HidingPlace=HidingPlaceColor, GateLever=LeverColor,
        Books=BookColor, Breakers=BreakerColor, Gold=GoldColor, Entity=EntityColor,
        Ladder=LadderColor, Fuse=FuseColor,
    }
    for kind, color in pairs(colors) do
        if color then NexusESPApplyColor(kind, color) end
    end
end
