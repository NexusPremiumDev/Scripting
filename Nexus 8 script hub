local function ApplySkinToHandle(handle, meshId, textureId, chroma)
	if not handle then
		return
	end
	BackupSkinHandle(handle)
	local info = SkinBackups[handle]
	local meshContent = SkinContentId(meshId)
	local textureContent = SkinContentId(textureId)
	pcall(function()
		if handle:IsA("MeshPart") then
			if meshContent then
				handle.MeshId = meshContent
			end
			if textureContent then
				handle.TextureID = textureContent
			end
		end
	end)
	local special = handle:FindFirstChildOfClass("SpecialMesh")
	if special then
		pcall(function()
			if meshContent then
				special.MeshId = meshContent
			end
			if textureContent then
				special.TextureId = textureContent
			end
		end)
	end
	if textureContent then
		local appearance = handle:FindFirstChildOfClass("SurfaceAppearance")
		if appearance then
			if info and not info.SurfaceAppearance then
				info.SurfaceAppearance = appearance
			end
			pcall(function()
				appearance.Parent = nil
			end)
		end
	end
	if chroma then
		pcall(function()
			handle.Color = Color3.fromHSV((os.clock() % 3) / 3, 1, 1)
		end)
	end
end
local function RestoreSkinHandle(handle)
	local info = handle and SkinBackups[handle]
	if not info then
		return
	end
	pcall(function()
		if handle:IsA("MeshPart") then
			if info.MeshId ~= nil then
				handle.MeshId = info.MeshId
			end
			if info.TextureID ~= nil then
				handle.TextureID = info.TextureID
			end
		end
		if info.SpecialMesh then
			info.SpecialMesh.MeshId = info.SpecialMeshId
			info.SpecialMesh.TextureId = info.SpecialTextureId
		end
		if info.SurfaceAppearance then
			info.SurfaceAppearance.Parent = handle
		end
		handle.Color = info.Color
	end)
end
local function RestoreAllSkins()
	for handle in pairs(SkinBackups) do
		RestoreSkinHandle(handle)
	end
end
local function PartHasSkinMesh(part)
	local ok = false
	pcall(function()
		if part:IsA("MeshPart") and part.MeshId ~= "" and part.MeshId ~= "rbxassetid://0" then
			ok = true
		end
	end)
	if ok then
		return true
	end
	local special = part:FindFirstChildOfClass("SpecialMesh")
	if special then
		pcall(function()
			if special.MeshId ~= "" then
				ok = true
			end
		end)
	end
	return ok
end
local function CollectToolVisualParts(tool)
	local parts = {}
	if not tool then
		return parts
	end
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") and PartHasSkinMesh(handle) then
		table.insert(parts, handle)
		return parts
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") and PartHasSkinMesh(d) then
			table.insert(parts, d)
		end
	end
	if #parts == 0 and handle and handle:IsA("BasePart") then
		table.insert(parts, handle)
	end
	return parts
end
local function ReadToolSkin(tool)
	for _, part in ipairs(CollectToolVisualParts(tool)) do
		local meshId, textureId = ReadHandleSkin(part)
		if meshId then
			return meshId, textureId
		end
	end
	return nil, nil
end
local function RestoreWeaponSkin(role)
	local tool = FindToolByRole(LocalPlayer, role, false)
	for _, part in ipairs(CollectToolVisualParts(tool)) do
		RestoreSkinHandle(part)
	end
end
local function ResolveKnifeSkin()
	local customMesh = string.match(tostring(State.KnifeSkinCustomMesh or ""), "%d+")
	local customTexture = string.match(tostring(State.KnifeSkinCustomTexture or ""), "%d+")
	local preset = FindSkinPreset(KnifeSkinPresets, State.KnifeSkinPreset)
	local meshId = customMesh or (preset and preset.Mesh or nil)
	local textureId = customTexture or (preset and preset.Texture or nil)
	if not customMesh then
		local meshOption = FindSkinOption(KnifeMeshOptions, State.KnifeSkinMesh)
		if meshOption and meshOption.Id then
			meshId = meshOption.Id
		end
	end
	if not customTexture then
		local textureOption = FindSkinOption(KnifeTextureOptions, State.KnifeSkinTexture)
		if textureOption and textureOption.Id then
			textureId = textureOption.Id
		end
	end
	local chroma = State.SkinChroma or (preset ~= nil and string.find(string.lower(tostring(preset.Name)), "chroma", 1, true) ~= nil)
	return meshId, textureId, chroma
end
local function ResolveGunSkin()
	local customMesh = string.match(tostring(State.GunSkinCustomMesh or ""), "%d+")
	local customTexture = string.match(tostring(State.GunSkinCustomTexture or ""), "%d+")
	local preset = FindSkinPreset(GunSkinPresets, State.GunSkinPreset)
	local meshId = customMesh or (preset and preset.Mesh or nil)
	local textureId = customTexture or (preset and preset.Texture or nil)
	local chroma = State.SkinChroma or (preset ~= nil and string.find(string.lower(tostring(preset.Name)), "chroma", 1, true) ~= nil)
	return meshId, textureId, chroma
end
local function ApplySkinToTool(tool, meshId, textureId, chroma)
	for _, part in ipairs(CollectToolVisualParts(tool)) do
		ApplySkinToHandle(part, meshId, textureId, chroma)
	end
end
local function UpdateSkinChanger()
	if State.KnifeSkinEnabled then
		local tool = FindToolByRole(LocalPlayer, "Murderer", false)
		if tool then
			local meshId, textureId, chroma = ResolveKnifeSkin()
			if meshId or textureId then
				ApplySkinToTool(tool, meshId, textureId, chroma)
			else
				RestoreWeaponSkin("Murderer")
			end
		end
	end
	if State.GunSkinEnabled then
		local tool = FindToolByRole(LocalPlayer, "Sheriff", false)
		if tool then
			local meshId, textureId, chroma = ResolveGunSkin()
			if meshId or textureId then
				ApplySkinToTool(tool, meshId, textureId, chroma)
			else
				RestoreWeaponSkin("Sheriff")
			end
		end
	end
end
local function BindSkinWatch(container)
	if not container then
		return
	end
	Connect(container.ChildAdded:Connect(function(child)
		if child and child:IsA("Tool") then
			task.defer(UpdateSkinChanger)
			task.delay(0.3, UpdateSkinChanger)
			task.delay(1, UpdateSkinChanger)
		end
	end))
end
