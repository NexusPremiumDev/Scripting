function Apex.RebuildCards()
	local scroll = Apex.UI.CardsScroll
	if not scroll then return end
	for _, card in ipairs(Apex.UI.Cards or {}) do
		pcall(function() card:Destroy() end)
	end
	Apex.UI.Cards = {}
	Apex.VisibleItems = {}
	local order = 0
	for _, item in ipairs(sortedItems()) do
		if itemMatchesView(item) and itemMatchesQuery(item) then
			order = order + 1
			Apex.VisibleItems[#Apex.VisibleItems + 1] = item
			Apex.CreateCard(item, order)
		end
	end
	if Apex.UI.EmptyNotice then
		Apex.UI.EmptyNotice.Visible = order == 0
		Apex.UI.EmptyNotice.LayoutOrder = 9999
	end
	if Apex.UI.ResultCount then
		Apex.UI.ResultCount.Text = tostring(order) .. " results"
	end
	if Apex.UI.ViewSub then
		local detected = Apex.DetectedGameName()
		Apex.UI.ViewSub.Text = detected and ("Detected: " .. detected .. " · Apex Engine " .. Apex.Version) or ("Apex Engine " .. Apex.Version .. " · " .. Apex.Executor)
	end
end
