local GunDropCache = nil
local LastGunDropScan = 0
local function GetObjectPart(obj)
	if not obj then
		return nil
	end
	if obj:IsA("BasePart") then
		return obj
	end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return obj:FindFirstChild("Handle", true) or obj:FindFirstChildWhichIsA("BasePart", true)
end
local function FindGunDrop(forceScan)
	if GunDropCache and GunDropCache.Parent and GetObjectPart(GunDropCache) then
		return GunDropCache
	end
	GunDropCache = nil
	local direct = workspace:FindFirstChild("GunDrop")
	if direct then
		GunDropCache = direct
		return direct
	end
	local now = os.clock()
	if not forceScan and now - LastGunDropScan < 1 then
		return nil
	end
	LastGunDropScan = now
	for _, obj in ipairs(workspace:GetDescendants()) do
		local name = string.lower(obj.Name)
		if name == "gundrop" or name == "gun drop" or name == "gun_drop" then
			GunDropCache = obj
			return obj
		end
	end
	return nil
end
local CoinContainerCache = nil
local LastCoinContainerScan = 0
local CoinIgnore = {}
local function HasCoinName(obj)
	local cur = obj
	for _ = 1, 4 do
		if not cur then break end
		if string.find(string.lower(cur.Name), "coin", 1, true) then
			return true
		end
		cur = cur.Parent
	end
	return false
end
local function IsCoinCandidate(obj)
	if not obj:IsA("BasePart") then return false end
	if obj.Transparency >= 0.9 then return false end
	if obj:FindFirstAncestorOfClass("Tool") then return false end
	local expire = CoinIgnore[obj]
	if expire and os.clock() < expire then return false end
	return HasCoinName(obj)
end
local function FindNearestCoin()
	if not RootPart then
		return nil
	end
	local now = os.clock()
	if not CoinContainerCache or not CoinContainerCache.Parent then
		CoinContainerCache = nil
		if now - LastCoinContainerScan >= 1 then
			LastCoinContainerScan = now
			CoinContainerCache = workspace:FindFirstChild("CoinContainer", true)
		end
	end
	local searchRoot = CoinContainerCache or workspace
	local best = nil
	local bestDistance = math.huge
	for _, obj in ipairs(searchRoot:GetDescendants()) do
		if IsCoinCandidate(obj) then
			local distance = (obj.Position - RootPart.Position).Magnitude
			if distance < bestDistance then
				bestDistance = distance
				best = obj
			end
		end
	end
	return best
end
