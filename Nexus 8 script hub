function Apex.FetchSource(item)
	if item.RemoteSource then return item.RemoteSource end
	if not item.Url then return item.Source end
	local ok, result = pcall(function() return game:HttpGet(item.Url) end)
	if not ok then
		return nil, result
	end
	if type(result) ~= "string" or #result < 10 then
		return nil, "empty remote response"
	end
	item.RemoteSource = result
	item.Bytes = #result
	item.Checksum = nil
	Apex.EnsureChecksum(item)
	return result
end
function Apex.Compile(item, force)
	if Apex.Cache[item.Id] and not force then return Apex.Cache[item.Id] end
	if type(loadstring) ~= "function" then
		return nil, "loadstring is not available"
	end
	local source, fetchErr = Apex.FetchSource(item)
	if type(source) ~= "string" or #source < 20 then
		return nil, fetchErr or "missing source"
	end
	local started = os.clock()
	local fn, err = loadstring(source)
	item.CompileMs = math.floor((os.clock() - started) * 1000 + 0.5)
	if fn then
		Apex.Cache[item.Id] = fn
		item.Compiled = true
		Apex.EnsureChecksum(item)
		Apex.Log("INFO", "Compiled " .. item.Name .. " in " .. tostring(item.CompileMs) .. "ms")
	else
		item.Compiled = false
		Apex.Log("ERROR", "Compile failed for " .. item.Name .. ": " .. tostring(err))
	end
	return fn, err
end
function Apex.CompileEmbedded()
	if Apex.Runtime.CompilingAll then return end
	Apex.Runtime.CompilingAll = true
	task.spawn(function()
		local done = 0
		local failed = 0
		for _, item in ipairs(Apex.Registry) do
			if item.SourceIndex then
				local fn = Apex.Compile(item)
				if fn then done = done + 1 else failed = failed + 1 end
				task.wait(0.05)
			end
		end
		Apex.Runtime.CompilingAll = false
		Apex.Toast("Embedded diagnostics: " .. tostring(done) .. " OK, " .. tostring(failed) .. " failed", failed == 0 and C.Green or C.Red)
		if Apex.RebuildCards then Apex.RebuildCards() end
		if Apex.RefreshDiagnostics then Apex.RefreshDiagnostics() end
	end)
end
