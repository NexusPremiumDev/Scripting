local function applyCreepyAvatar()
	pcall(function()
		local char = k.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Material = Enum.Material.SmoothPlastic
				part.Color = Color3.fromRGB(15, 15, 20)
				if part.Name == "Head" then
					for _, faceChild in ipairs(part:GetChildren()) do
						if faceChild:IsA("Decal") or faceChild:IsA("Texture") then faceChild:Destroy() end
					end
					local eyes = part:FindFirstChild("CreepyEyes") or Instance.new("PointLight")
					eyes.Name = "CreepyEyes"
					eyes.Color = Color3.fromRGB(255, 0, 0)
					eyes.Brightness = 6
					eyes.Range = 10
					eyes.Parent = part
				end
			end
		end
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Clothing") or item:IsA("Accessory") then
				item:Destroy()
			end
		end
	end)
end

local activeDanceTrack = nil
local dances = {
	["Bang"] = "rbxassetid://5918726674",
	["Chaos Orbit"] = "rbxassetid://507771019",
}
local function playDance(danceName)
	pcall(function()
		if activeDanceTrack then
			activeDanceTrack:Stop()
			activeDanceTrack = nil
		end
		if danceName == "OFF" or not dances[danceName] then return end
		local char = k.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		local anim = Instance.new("Animation")
		anim.AnimationId = dances[danceName]
		activeDanceTrack = hum:LoadAnimation(anim)
		activeDanceTrack.Looped = true
		activeDanceTrack:Play()
		activeDanceTrack:AdjustSpeed(25)
	end)
end


local SKY_CAMP_ALTITUDE = 1500
local skyCampPosition = nil 
local skyCampSuspended = false
local lastAutoShotAt = 0
local function toggleSkyCamp(state)
	skyCampEnabled = state and true or false
	local char = k.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if skyCampEnabled then
		
		if hrp then
			hrp.CFrame = CFrame.new(hrp.Position.X, SKY_CAMP_ALTITUDE, hrp.Position.Z)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		if hum then
			hum.PlatformStand = true
			hum.AutoRotate = true
		end
	else
		if skyCampPosition then pcall(function() skyCampPosition:Destroy() end); skyCampPosition = nil end
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end
	end
end

