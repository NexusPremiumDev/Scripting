local function AddSlider(parent, label, key, min, max, step, callback)
	step = step or 1
	local holder = New("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, parent)
	New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
		Text = label, TextColor3 = COLORS.Text, Font = Enum.Font.Gotham, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)
	local valueLabel = New("TextLabel", {
		Size = UDim2.fromOffset(70, 16), Position = UDim2.new(1, -70, 0, 0), BackgroundTransparency = 1,
		Text = tostring(S[key]), TextColor3 = COLORS.Accent2, Font = Enum.Font.GothamSemibold, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, holder)
	local bar = New("Frame", {
		Size = UDim2.new(1, 0, 0, 8), Position = UDim2.fromOffset(0, 26),
		BackgroundColor3 = COLORS.Off, BorderSizePixel = 0,
	}, holder)
	Corner(bar, 4)
	local fill = New("Frame", { BackgroundColor3 = COLORS.Accent, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) }, bar)
	Corner(fill, 4)
	local hit = New("TextButton", { Size = UDim2.new(1, 0, 1, 10), Position = UDim2.fromOffset(0, -5), BackgroundTransparency = 1, Text = "" }, bar)

	local function Refresh()
		local ratio = (S[key] - min) / (max - min)
		fill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
		if step < 1 then
			valueLabel.Text = string.format("%.2f", S[key])
		else
			valueLabel.Text = tostring(math.floor(S[key] + 0.5))
		end
	end
	Refresh()
	local sliding = false
	local function ApplyFromX(x)
		local ratio = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local raw = min + ratio * (max - min)
		S[key] = math.floor(raw / step + 0.5) * step
		Refresh()
		if callback then pcall(callback, S[key]) end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			ApplyFromX(input.Position.X)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliding = false
					if SaveConfig then SaveConfig() end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			ApplyFromX(input.Position.X)
		end
	end)
	return { Refresh = Refresh }
end

