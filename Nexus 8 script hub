local function nexusPlaySound(times)
    times = times or 1
    local idText = tostring(getgenv().NexusSoundId or "142376088"):gsub("%D", "")
    local id = tonumber(idText)
    if not id then
        warn("[NEXUS] Invalid sound ID")
        return
    end

    getgenv().NexusSoundStop = false
    getgenv().NexusSoundPlaying = true

    local LP = game.Players.LocalPlayer
    local RS = game:GetService("ReplicatedStorage")
    local RE = RS:FindFirstChild("RE")
    if not RE then
        pcall(function() RE = RS:WaitForChild("RE", 3) end)
    end

    local soundRemote = nil
    if RE then
        soundRemote = RE:FindFirstChild("1Gu1nSound1s")
        if not soundRemote then
            for _, c in ipairs(RE:GetChildren()) do
                if string.lower(c.Name):find("sound", 1, true) then
                    soundRemote = c
                    break
                end
            end
        end
    end
    if not soundRemote then
        soundRemote = RS:FindFirstChild("1Gu1nSound1s", true)
    end

    if soundRemote then
        print("[NEXUS] FE remote:", soundRemote:GetFullName())
    else
        warn("[NEXUS] No sound remote found")
    end

    -- NO guns / NO tools — sound remote only

    task.spawn(function()
        for n = 1, times do
            if getgenv().NexusSoundStop then break end

            local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local localLen = 120

            -- local full track
            pcall(function()
                if root then
                    for _, ch in ipairs(root:GetChildren()) do
                        if ch:IsA("Sound") and ch.Name == "NexusSound" then
                            ch:Stop()
                            ch:Destroy()
                        end
                    end
                end
                local snd = Instance.new("Sound")
                snd.Name = "NexusSound"
                snd.SoundId = "rbxassetid://" .. tostring(id)
                snd.Volume = 2
                snd.Looped = false
                snd.Parent = root or LP:FindFirstChild("PlayerGui")
                local t0 = tick()
                while not snd.IsLoaded and tick() - t0 < 8 do
                    task.wait(0.05)
                end
                if snd.TimeLength and snd.TimeLength > 1 then
                    localLen = snd.TimeLength + 1
                end
                snd:Play()
                print("[NEXUS] Local play ~", localLen, "s")
            end)

            -- FE: only 1Gu1nSound1s patterns from working audio hubs
            if soundRemote then
                task.spawn(function()
                    local t0 = tick()
                    local limit = math.clamp(localLen, 20, 300)
                    while getgenv().NexusSoundPlaying and not getgenv().NexusSoundStop and (tick() - t0) < limit do
                        -- primary (Audio-All / Zyronis)
                        pcall(function()
                            soundRemote:FireServer(workspace, id, 1)
                        end)
                        pcall(function()
                            soundRemote:FireServer(unpack({ [1] = workspace, [2] = id, [3] = 1 }))
                        end)
                        -- duration form (ScriptBlox)
                        pcall(function()
                            soundRemote:FireServer(id, 300)
                        end)
                        pcall(function()
                            soundRemote:FireServer(id, math.ceil(limit))
                        end)
                        task.wait(0.5)
                    end
                end)
            end

            local t0 = tick()
            while not getgenv().NexusSoundStop and (tick() - t0) < math.max(localLen, 10) do
                task.wait(0.25)
            end
            if n < times and not getgenv().NexusSoundStop then
                task.wait(0.4)
            end
        end
        getgenv().NexusSoundPlaying = false
        print("[NEXUS] Done")
    end)
end

