	toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
	toastLayout.Parent = toastHolder
	Apex.UI.ToastHolder = toastHolder
	Apex.BuildSplash()
	task.spawn(function()
		Apex.SplashProgress(0.08, "Detecting executor environment...")
		Apex.DetectEnvironment()
		task.wait(0.12)
		Apex.SplashProgress(0.24, "Loading engine state...")
		Apex.LoadState()
		Apex.BuildRegistry()
		task.wait(0.12)
		Apex.SplashProgress(0.46, "Building Apex interface...")
		Apex.BuildMainUi()
		Apex.BindKeys()
		Apex.StartTelemetry()
		task.wait(0.12)
		Apex.SplashProgress(0.68, "Verifying embedded payloads...")
		for _, item in ipairs(Apex.Registry) do
			if item.SourceIndex then
				Apex.EnsureChecksum(item)
				task.wait(0.03)
			end
		end
		Apex.SplashProgress(0.86, "Indexing utilities and favorites...")
		Apex.RebuildCards()
		Apex.RefreshDiagnostics()
		task.wait(0.16)
		Apex.SplashProgress(1, "Apex Engine ready")
		task.wait(0.22)
		if Apex.UI.Splash then
			tw(Apex.UI.Splash, 0.3, {BackgroundTransparency = 1}):Play()
			if Apex.UI.SplashCard then
				tw(Apex.UI.SplashCard, 0.3, {Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.In):Play()
			end
			task.delay(0.34, function()
				pcall(function() Apex.UI.Splash:Destroy() end)
			end)
		end
		if Apex.UI.Main then
			Apex.UI.Main.Visible = true
			tw(Apex.UI.Main, 0.45, {Size = Apex.UI.MainSize}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
		end
		local detected = Apex.DetectedGameName()
		if detected then
			Apex.SetStatus("● GAME DETECTED: " .. string.upper(detected) .. " · RightShift · Ctrl+K", C.Green)
			Apex.Toast("🎮 Game detected: " .. detected, C.Green)
		else
			Apex.SetStatus("● SYSTEM READY · PICK A MODULE · RightShift · Ctrl+K", C.Green)
		end
		Apex.Log("INFO", "Apex Engine " .. Apex.Version .. " ready on " .. tostring(Apex.Executor))
		Apex.Emit("Ready", Apex)
		Apex.WarmupDetected()
	end)
end
Apex.Boot()
return Apex
