local function TweenActive() return State.TweenBusy == true end

local function CancelTween()
	State.TweenId += 1
	State.TweenBusy = false
end

local function TweenTo(targetPos, speed)
	local root = GetRoot()
	if not root or not targetPos then return false end
	local hum = GetHumanoid()
	if hum and hum.Sit then
		pcall(function() hum.Sit = false end)
		task.wait(0.1)
		root = GetRoot()
		if not root then return false end
	end
	State.TweenId += 1
	local myId = State.TweenId
	State.TweenBusy = true
	speed = speed or S.TweenSpeed
	while not State.Unloaded and State.TweenId == myId do
		root = GetRoot()
		if not root then break end
		local pos = root.Position
		local diff = targetPos - pos
		local dist = diff.Magnitude
		if dist < 4 then break end
		local dt = RunService.Heartbeat:Wait()
		local lookDir = diff.Unit
		local step = math.min(dist, speed * dt)
		local newPos = pos + lookDir * step
		root.CFrame = CFrame.new(newPos, newPos + lookDir)
		root.AssemblyLinearVelocity = Vector3.zero
	end
	if State.TweenId == myId then State.TweenBusy = false end
	return State.TweenId == myId
end

local function InstantTeleport(pos)
	local root = GetRoot()
	if root and pos then
		CancelTween()
		root.CFrame = CFrame.new(pos)
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

-- Character collision manager: snapshots original CanCollide so it can be restored exactly.
local CollisionSnapshot = setmetatable({}, { __mode = "k" })
local function SetCharacterCollisions(enabled)
	local c = GetChar()
	if not c then return end
	for _, part in ipairs(c:GetDescendants()) do
		if part:IsA("BasePart") then
			if enabled then
				local orig = CollisionSnapshot[part]
				if orig ~= nil then part.CanCollide = orig end
			else
				if CollisionSnapshot[part] == nil then
					CollisionSnapshot[part] = part.CanCollide
				end
				if part.CanCollide then part.CanCollide = false end
			end
		end
	end
end

