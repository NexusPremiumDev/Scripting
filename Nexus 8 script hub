local CurrentAnimTrack, CurrentAnimInstance, CurrentAnimData = nil, nil, nil
function StopCurrentAnimation()
	local track = CurrentAnimTrack
	local instance = CurrentAnimInstance
	CurrentAnimTrack = nil
	CurrentAnimInstance = nil
	CurrentAnimData = nil
	if track then
		pcall(function()
			track:Stop(0.1)
		end)
		task.delay(0.25, function()
			pcall(function()
				track:Destroy()
			end)
			if instance then
				pcall(function()
					instance:Destroy()
				end)
			end
		end)
	end
end
function PlaySelectedAnimation()
	local data = AnimationByName[State.AnimName or ""]
	if not data then
		Notify("No animation selected", 3)
		return
	end
	if not Humanoid then
		Notify("Humanoid is not ready", 3)
		return
	end
	StopCurrentAnimation()
	local animation = Instance.new("Animation")
	animation.Name = "NexusTSBAnimation"
	animation.AnimationId = "rbxassetid://" .. tostring(data.Id)
	animation.Parent = Humanoid
	local animator = Humanoid:FindFirstChildOfClass("Animator")
	local ok, track = pcall(function()
		if animator then
			return animator:LoadAnimation(animation)
		end
		return Humanoid:LoadAnimation(animation)
	end)
	if not ok or not track then
		animation:Destroy()
		Notify("Animation failed to load", 3)
		return
	end
	CurrentAnimTrack = track
	CurrentAnimInstance = animation
	CurrentAnimData = data
	pcall(function()
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = State.AnimLoop
		track:Play(0.1, 1, math.clamp(data.Speed * State.AnimSpeed, 0.01, 50))
	end)
	track.Stopped:Connect(function()
		if CurrentAnimTrack == track then
			CurrentAnimTrack = nil
			CurrentAnimData = nil
			if CurrentAnimInstance == animation then
				CurrentAnimInstance = nil
			end
			task.delay(0.1, function()
				pcall(function()
					animation:Destroy()
				end)
				pcall(function()
					track:Destroy()
				end)
			end)
		end
	end)
	Notify("Playing: " .. data.Name, 2)
end
