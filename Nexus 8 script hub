-- TORNADO
local tornadoEnabled = false
local tornadoConnection
local tornadoParts = {}
local tornadoCenter
local tornadoAngle = 0

local function rebuildTornadoParts()
    table.clear(tornadoParts)

    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("map") or workspace
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("BasePart")
            and not obj.Anchored
            and obj.AssemblyMass < 5000
            and not obj:IsDescendantOf(LocalPlayer.Character or Instance.new("Folder")) then

            table.insert(tornadoParts, obj)
        end
    end
end

local function stopTornado()
    tornadoEnabled = false

    if tornadoConnection then
        tornadoConnection:Disconnect()
        tornadoConnection = nil
    end

    for _, part in ipairs(tornadoParts) do
        if part and part.Parent and not part.Anchored then
            part.AssemblyLinearVelocity *= 0.15
            part.AssemblyAngularVelocity *= 0.15
        end
    end

    table.clear(tornadoParts)
end

local function startTornado()
    stopTornado()

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    tornadoEnabled = true
    tornadoCenter = root.Position
    tornadoAngle = 0
    rebuildTornadoParts()

    local scanTimer = 0

    tornadoConnection = RunService.Heartbeat:Connect(function(dt)
        if not tornadoEnabled then return end

        local currentChar = LocalPlayer.Character
        local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        if not currentRoot then
            stopTornado()
            return
        end

        tornadoCenter = currentRoot.Position
        tornadoAngle += dt * 7
        scanTimer += dt

        if scanTimer >= 1.5 then
            scanTimer = 0
            rebuildTornadoParts()
        end

        for i, part in ipairs(tornadoParts) do
            if part and part.Parent and not part.Anchored then
                local offset = part.Position - tornadoCenter
                local horizontal = Vector3.new(offset.X, 0, offset.Z)
                local radius = horizontal.Magnitude

                if radius < 1 then
                    radius = 1
                    horizontal = Vector3.new(1, 0, 0)
                end

                local angle = math.atan2(horizontal.Z, horizontal.X) + tornadoAngle * 0.12
                local orbitDir = Vector3.new(-math.sin(angle), 0, math.cos(angle))
                local inward = -horizontal.Unit

                local targetVelocity =
                    orbitDir * math.clamp(radius * 3.0, 25, 100)
                    + inward * math.clamp((radius - 8) * 4, -10, 80)
                    + Vector3.yAxis * math.clamp(35 + radius * 1.5, 35, 100)

                targetVelocity += Vector3.yAxis * math.sin(tornadoAngle + i) * 8

                part.AssemblyLinearVelocity = part.AssemblyLinearVelocity:Lerp(
                    targetVelocity,
                    math.clamp(dt * 6, 0, 1)
                )

                part.AssemblyAngularVelocity = Vector3.new(
                    0,
                    12 + radius * 0.25,
                    0
                )
            end
        end
    end)
end

CreateToggle("Tornado", false, function(state)
    if state then
        startTornado()
    else
        stopTornado()
    end
end)

CreateButton("Refresh Tornado Parts", function()
    if tornadoEnabled then
        rebuildTornadoParts()
    end
end)

-- TOUCH FLING
local touchFlingEnabled = false
local touchFlingConnection
local touchFlingTarget

local function getPlayerRoot(player)
    local c = player and player.Character
    return c and c:FindFirstChild('HumanoidRootPart')
end

local function stopTouchFling()
    touchFlingEnabled = false
    touchFlingTarget = nil
    if touchFlingConnection then
        touchFlingConnection:Disconnect()
        touchFlingConnection = nil
    end
end

local function startTouchFling()
    stopTouchFling()
    touchFlingEnabled = true

    touchFlingConnection = RunService.Heartbeat:Connect(function()
        if not touchFlingEnabled then return end
        local myRoot = select(3, getCharacter())
        if not myRoot then return end

        local nearest, nearestDistance
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local root = getPlayerRoot(player)
                if root then
                    local d = (root.Position - myRoot.Position).Magnitude
                    if not nearestDistance or d < nearestDistance then
                        nearestDistance = d
                        nearest = player
                    end
                end
            end
        end
        touchFlingTarget = nearest
        local targetRoot = getPlayerRoot(nearest)
        if targetRoot and nearestDistance and nearestDistance < 18 then
            local dir = targetRoot.Position - myRoot.Position
            if dir.Magnitude > 0.1 then
                myRoot.AssemblyLinearVelocity = dir.Unit * 140 + Vector3.new(0, 35, 0)
                myRoot.AssemblyAngularVelocity = Vector3.new(0, 80, 0)
            end
        end
    end)
end

CreateToggle('Touch Fling', false, function(state)
    if state then startTouchFling() else stopTouchFling() end
end)

CreateButton('Stop Touch Fling', function()
    stopTouchFling()
end)

