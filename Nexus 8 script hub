local function UpdatePlayerESP()
	local root = GetRoot()
	local seen = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local char = plr.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local head = char:FindFirstChild("Head")
			local proot = char:FindFirstChild("HumanoidRootPart")
			if hum and head and proot and hum.Health > 0 then
				seen[plr] = true
				local entry = State.ESPObjects[plr]
				if not entry or entry.Character ~= char then
					if entry then
						pcall(function() entry.Highlight:Destroy() end)
						pcall(function() entry.Billboard:Destroy() end)
					end
					local hl = MakeHighlight(char, Color3.fromRGB(220, 60, 80))
					local bb, label = MakeBillboard(head, plr.Name, Color3.fromRGB(255, 120, 140))
					entry = { Highlight = hl, Billboard = bb, Label = label, Character = char }
					State.ESPObjects[plr] = entry
				end
				local dist = root and math.floor((proot.Position - root.Position).Magnitude) or 0
				local hp = math.floor(hum.Health)
				local maxHp = math.floor(hum.MaxHealth)
				entry.Label.Text = plr.Name .. "\nHP " .. hp .. "/" .. maxHp .. "  ·  " .. dist .. "m"
			end
		end
	end
	for plr, entry in pairs(State.ESPObjects) do
		if not seen[plr] then
			pcall(function() entry.Highlight:Destroy() end)
			pcall(function() entry.Billboard:Destroy() end)
			State.ESPObjects[plr] = nil
		end
	end
end

local function UpdateFruitESP()
	local fruits = GetSpawnedFruits()
	local root = GetRoot()
	local seen = {}
	for _, f in ipairs(fruits) do
		seen[f.Object] = true
		if S.FruitESP then
			local entry = State.FruitESPObjects[f.Object]
			if not entry then
				local hl = MakeHighlight(f.Object, Color3.fromRGB(255, 170, 40))
				local bb, label = MakeBillboard(f.Part, f.Object.Name, Color3.fromRGB(255, 200, 90))
				entry = { Highlight = hl, Billboard = bb, Label = label }
				State.FruitESPObjects[f.Object] = entry
			end
			local dist = root and math.floor((f.Part.Position - root.Position).Magnitude) or 0
			entry.Label.Text = f.Object.Name .. "\n" .. dist .. "m"
		end
	end
	for obj, entry in pairs(State.FruitESPObjects) do
		if not seen[obj] or not obj.Parent then
			pcall(function() entry.Highlight:Destroy() end)
			pcall(function() entry.Billboard:Destroy() end)
			State.FruitESPObjects[obj] = nil
		end
	end
	if fruitInfoLabel then
		if #fruits > 0 then
			local names = {}
			for _, f in ipairs(fruits) do table.insert(names, f.Object.Name) end
			fruitInfoLabel.Text = "Spawned fruits (" .. #fruits .. "): " .. table.concat(names, ", ")
		else
			fruitInfoLabel.Text = "Spawned fruits: none"
		end
	end
	return fruits
end

