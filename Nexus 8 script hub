function SpendStatPoints()
	local stats = {}
	if S.StatMelee then table.insert(stats, "Melee") end
	if S.StatDefense then table.insert(stats, "Defense") end
	if S.StatSword then table.insert(stats, "Sword") end
	if S.StatGun then table.insert(stats, "Gun") end
	if S.StatFruit then table.insert(stats, "Demon Fruit") end
	if #stats == 0 then return end
	State.StatIndex = ((State.StatIndex or 0) % #stats) + 1
	InvokeCommF("AddPoint", stats[State.StatIndex], math.floor(S.StatPoints))
end

function StoreEquippedFruit()
	local c = GetChar()
	local bp = LP:FindFirstChild("Backpack")
	local tool = (c and c:FindFirstChildOfClass("Tool")) or nil
	local function tryStore(t)
		if not t then return false end
		local name = t.Name
		if not name:find("Fruit") and not name:find("-") then return false end
		local base = name:gsub("%s*Fruit%s*$", ""):gsub("^%s+", ""):gsub("%s+$", "")
		local id = base:find("-") and base or (base .. "-" .. base)
		InvokeCommF("StoreFruit", id, t)
		Notify("Nexus BF", "Store requested: " .. id)
		return true
	end
	if tryStore(tool) then return end
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") and tryStore(t) then return end
		end
	end
	Notify("Nexus BF", "No fruit tool found in hand/backpack.")
end

local function GetSpawnedFruits()
	local fruits = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if (obj:IsA("Tool") or obj:IsA("Model")) and obj.Name:find("Fruit") then
			local inCharacter = false
			local node = obj
			while node and node ~= Workspace do
				if node ~= obj and node:FindFirstChildOfClass("Humanoid") then inCharacter = true break end
				node = node.Parent
			end
			if not inCharacter then
				local part = obj:FindFirstChild("Handle", true) or obj:FindFirstChildWhichIsA("BasePart", true)
				if part then table.insert(fruits, { Object = obj, Part = part }) end
			end
		end
	end
	return fruits
end

function FindNearestFruitPos()
	local root = GetRoot()
	local best, bestDist = nil, math.huge
	for _, f in ipairs(GetSpawnedFruits()) do
		local d = root and (f.Part.Position - root.Position).Magnitude or 0
		if d < bestDist then bestDist = d; best = f.Part.Position end
	end
	return best
end

function ApplyFPSBoost(on)
	pcall(function()
		if on then
			State.OrigShadows = Lighting.GlobalShadows
			Lighting.GlobalShadows = false
			local terrain = Workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				terrain.WaterWaveSize = 0
				terrain.WaterWaveSpeed = 0
				terrain.WaterReflectance = 0
				terrain.WaterTransparency = 0
			end
			table.clear(State.SavedParticles)
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d:IsA("ParticleEmitter") or d:IsA("Trail") then
					State.SavedParticles[d] = d.Enabled
					d.Enabled = false
				end
			end
			pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		else
			if State.OrigShadows ~= nil then Lighting.GlobalShadows = State.OrigShadows end
			for d, enabled in pairs(State.SavedParticles) do
				pcall(function() d.Enabled = enabled end)
			end
			table.clear(State.SavedParticles)
		end
	end)
end

function ServerHop()
	local placeId = game.PlaceId
	local ok, result = pcall(function()
		return game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100")
	end)
	if not ok then
		Notify("Nexus BF", "Server list fetch failed. Rejoining instead.")
		pcall(function() TeleportService:Teleport(placeId, LP) end)
		return
	end
	local ok2, data = pcall(function() return HttpService:JSONDecode(result) end)
	if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then
		Notify("Nexus BF", "Could not parse server list.")
		return
	end
	local candidates = {}
	for _, srv in ipairs(data.data) do
		if srv.id and srv.id ~= game.JobId and (srv.playing or 0) < (srv.maxPlayers or 12) then
			table.insert(candidates, srv.id)
		end
	end
	if #candidates == 0 then
		Notify("Nexus BF", "No other server found.")
		return
	end
	local pick = candidates[math.random(1, #candidates)]
	Notify("Nexus BF", "Hopping to another server...")
	pcall(function() TeleportService:TeleportToPlaceInstance(placeId, pick, LP) end)
end

-- Farm core -------------------------------------------------------------------

local function MobAlive(mob)
	if not mob or not mob.Parent then return false end
	local hum = mob:FindFirstChildOfClass("Humanoid")
	local root = mob:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and root ~= nil and hum.Health > 0
end

local function EngageTarget(mob, modeAtStart)
	local engageStart = os.clock()
	local hum0 = GetHumanoid()
	if hum0 then hum0.AutoRotate = false end
	while not State.Unloaded and MobAlive(mob) do
		if not S.Farming then break end
		if S.FarmMode ~= modeAtStart then break end
		local root = GetRoot()
		local hum = GetHumanoid()
		if not root or not hum or hum.Health <= 0 then break end
		local mobRoot = mob:FindFirstChild("HumanoidRootPart")
		if not mobRoot then break end

		State.CurrentTarget = mob
		local mobLook = mobRoot.CFrame.LookVector
		local flatLook = Vector3.new(mobLook.X, 0, mobLook.Z)
		if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, 1) else flatLook = flatLook.Unit end
		local desired = mobRoot.Position - flatLook * 2 + Vector3.new(0, S.FarmHeight, 0)
		local dist = (desired - root.Position).Magnitude

		if dist > 70 then
			TweenTo(desired)
		else
			local dt = RunService.Heartbeat:Wait()
			local alpha = math.clamp(dt * 12, 0, 1)
			local newPos = root.Position:Lerp(desired, alpha)
			root.CFrame = CFrame.new(newPos, mobRoot.Position)
			root.AssemblyLinearVelocity = Vector3.zero
			if S.CameraAim then
				pcall(function()
					Camera.CFrame = CFrame.new(Camera.CFrame.Position, mobRoot.Position)
				end)
			end
		end

		if S.FarmMode ~= "Nearest Mob" then
			local platform = EnsurePlatform()
			local r2 = GetRoot()
			if r2 then platform.CFrame = CFrame.new(r2.Position - Vector3.new(0, 3.4, 0)) end
		end

		if S.BringMobs and (os.clock() - State.LastBring > 0.5) then
			State.LastBring = os.clock()
			local base = BaseMobName(mob.Name)
			pcall(function()
				for _, other in ipairs(GetEnemies()) do
					if other ~= mob and MobNameMatches(other.Name, base) then
						local oroot = other:FindFirstChild("HumanoidRootPart")
						local mr = mob:FindFirstChild("HumanoidRootPart")
						if oroot and mr and (oroot.Position - mr.Position).Magnitude < 120 then
							oroot.CFrame = mr.CFrame * CFrame.new(math.random(-3, 3), 0, math.random(-3, 3))
							oroot.AssemblyLinearVelocity = Vector3.zero
						end
					end
				end
			end)
		end

		if os.clock() - engageStart > 120 then break end
	end
	if State.CurrentTarget == mob then State.CurrentTarget = nil end
	local hum1 = GetHumanoid()
	if hum1 then hum1.AutoRotate = true end
end

local function FarmTick()
	if not S.Farming then return end
	local root = GetRoot()
	local hum = GetHumanoid()
	if not root or not hum or hum.Health <= 0 then
		if farmStatusLabel then farmStatusLabel.Text = "Status: waiting for character..." end
		return
	end

	if S.FarmMode == "Level (Quest)" then
		local level = GetLevel()
		local q = GetQuestForLevel(level)
		local onQuest = HasQuest()
		if State.WasOnQuest and not onQuest then
			-- Quest just finished: allow immediate re-accept.
			State.QuestBlacklistUntil = 0
			State.LastQuestTry = 0
		end
		State.WasOnQuest = onQuest
		if S.AutoQuest and not onQuest and os.clock() - State.LastQuestTry > 2 and os.clock() > State.QuestBlacklistUntil then
			State.LastQuestTry = os.clock()
			InvokeCommF("StartQuest", q[2], q[3])
			task.wait(0.7)
			if not HasQuest() then
				State.QuestBlacklistUntil = os.clock() + 8
			end
			root = GetRoot()
			if not root then return end
		end
		local mob = FindMobByName(q[4])
		if mob then
			if farmStatusLabel then farmStatusLabel.Text = "Status: fighting " .. q[4] .. " (Lv " .. level .. ")" end
			EngageTarget(mob, S.FarmMode)
		else
			local spawnPos = GetMobSpawnPos(q[4])
			if spawnPos and (root.Position - spawnPos).Magnitude > 25 then
				if farmStatusLabel then farmStatusLabel.Text = "Status: traveling to " .. q[4] .. " spawn..." end
				TweenTo(spawnPos)
			elseif spawnPos then
				if farmStatusLabel then farmStatusLabel.Text = "Status: waiting for " .. q[4] .. " to spawn..." end
			else
				if farmStatusLabel then farmStatusLabel.Text = "Status: " .. q[4] .. " not loaded. Go near its island once so the script learns the spot." end
			end
		end
	elseif S.FarmMode == "Nearest Mob" then
		local mob = FindNearestMob(4000)
		if mob then
			if farmStatusLabel then farmStatusLabel.Text = "Status: fighting " .. BaseMobName(mob.Name) end
			EngageTarget(mob, S.FarmMode)
		else
			if farmStatusLabel then farmStatusLabel.Text = "Status: no mobs found nearby." end
		end
	elseif S.FarmMode == "Boss (Highest HP)" then
		local mob = FindStrongestMob()
		if mob then
			if farmStatusLabel then farmStatusLabel.Text = "Status: fighting boss " .. BaseMobName(mob.Name) end
			EngageTarget(mob, S.FarmMode)
		else
			if farmStatusLabel then farmStatusLabel.Text = "Status: no boss spawned." end
		end
	elseif S.FarmMode == "Selected Mob" then
		if S.SelectedMob == "" then
			if farmStatusLabel then farmStatusLabel.Text = "Status: pick a mob from the dropdown first." end
			return
		end
		local mob = FindMobByName(S.SelectedMob)
		if mob then
			if farmStatusLabel then farmStatusLabel.Text = "Status: fighting " .. S.SelectedMob end
			EngageTarget(mob, S.FarmMode)
		else
			local spawnPos = GetMobSpawnPos(S.SelectedMob)
			if spawnPos and (root.Position - spawnPos).Magnitude > 25 then
				if farmStatusLabel then farmStatusLabel.Text = "Status: traveling to " .. S.SelectedMob .. " spawn..." end
				TweenTo(spawnPos)
			elseif spawnPos then
				if farmStatusLabel then farmStatusLabel.Text = "Status: waiting for " .. S.SelectedMob .. "..." end
			else
				if farmStatusLabel then farmStatusLabel.Text = "Status: " .. S.SelectedMob .. " not loaded near you." end
			end
		end
	end
end

-- Chests ----------------------------------------------------------------------

local function ChestPositionKey(pos)
	return string.format("%.0f|%.0f|%.0f", pos.X / 5, pos.Y / 5, pos.Z / 5)
end

local function ScanChests()
	local now = os.clock()
	if now - State.ChestCacheTime < 3 then
		local alive = {}
		for _, c in ipairs(State.ChestCache) do
			if c.Part and c.Part.Parent then table.insert(alive, c) end
		end
		return alive
	end
	local found = {}
	local seenKeys = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if (obj:IsA("Model") or obj:IsA("BasePart")) and obj.Name:match("^Chest%d*$") then
			local anchor = nil
			if obj:IsA("BasePart") then
				anchor = obj
			else
				local bestVolume = -1
				for _, d in ipairs(obj:GetDescendants()) do
					if d:IsA("BasePart") then
						local s = d.Size
						local volume = s.X * s.Y * s.Z
						if volume > bestVolume then
							bestVolume = volume
							anchor = d
						end
					end
				end
			end
			if anchor then
				local key = ChestPositionKey(anchor.Position)
				if not seenKeys[key] then
					seenKeys[key] = true
					table.insert(found, { Part = anchor, Name = obj.Name, Key = key })
				end
			end
		end
	end
	State.ChestCache = found
	State.ChestCacheTime = now
	return found
end

local function ChestTick()
	if not S.ChestFarm then return end
	local root = GetRoot()
	local hum = GetHumanoid()
	if not root or not hum or hum.Health <= 0 then
		if chestStatusLabel then chestStatusLabel.Text = "Status: waiting for character..." end
		return
	end

	local now = os.clock()
	for key, expiry in pairs(State.VisitedChests) do
		if now > expiry then State.VisitedChests[key] = nil end
	end

	local chests = ScanChests()
	local candidates = {}
	for _, c in ipairs(chests) do
		if c.Part.Parent and not State.VisitedChests[c.Key] then
			table.insert(candidates, c)
		end
	end

	if #chests == 0 then
		if chestStatusLabel then chestStatusLabel.Text = "Status: no chest models found in this area (collected: " .. State.ChestsCollected .. ")." end
		task.wait(2)
		return
	end
	if #candidates == 0 then
		if chestStatusLabel then chestStatusLabel.Text = "Status: all " .. #chests .. " known chests visited (collected: " .. State.ChestsCollected .. "). Waiting for respawn..." end
		task.wait(3)
		return
	end

	table.sort(candidates, function(a, b)
		return (a.Part.Position - root.Position).Magnitude < (b.Part.Position - root.Position).Magnitude
	end)
	local target = candidates[1]
	if chestStatusLabel then
		local dist = math.floor((target.Part.Position - root.Position).Magnitude)
		chestStatusLabel.Text = "Status: going to " .. target.Name .. " (" .. dist .. "m, " .. #candidates .. " left, collected: " .. State.ChestsCollected .. ")"
	end

	TweenTo(target.Part.Position + Vector3.new(0, 2, 0))
	if not S.ChestFarm or State.Unloaded then return end

	-- Touch snap: briefly place the character directly on the chest so the touch registers.
	local r = GetRoot()
	if r and target.Part.Parent then
		r.CFrame = target.Part.CFrame * CFrame.new(0, 1.2, 0)
		r.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.3)
		if target.Part.Parent then
			r.CFrame = target.Part.CFrame * CFrame.new(0, 2.2, 0)
			r.AssemblyLinearVelocity = Vector3.zero
		end
		task.wait(0.25)
	end

	State.VisitedChests[target.Key] = os.clock() + 120
	State.ChestsCollected += 1
end

