local function NexusFindGunDrop()
    local direct = Workspace:FindFirstChild("GunDrop")
    if direct then return direct end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n == "gundrop" or n == "gun drop" or n == "gun_drop" then
            return obj
        end
    end
    return nil
end

local function NexusGetPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
    end
    return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
end

local function NexusTryEquipGun()
    local char = Player.Character
    local backpack = Player:FindFirstChildOfClass("Backpack")
    if not char or not backpack then return false end

    local function isGun(tool)
        if not tool:IsA("Tool") then return false end
        local n = tool.Name:lower()
        return n:find("gun") or n:find("revolver") or n:find("sheriff") or n:find("peacemaker")
    end

    for _, tool in ipairs(char:GetChildren()) do
        if isGun(tool) then return true end
    end
    for _, tool in ipairs(backpack:GetChildren()) do
        if isGun(tool) then
            pcall(function() tool.Parent = char end)
            return true
        end
    end
    return false
end

