local ESPData = {}
local ESPGuiParent = nil
local function GetESPGuiParent()
	if ESPGuiParent then
		return ESPGuiParent
	end
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and hui then
		ESPGuiParent = hui
		return hui
	end
	local ok2, cg = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok2 and cg then
		ESPGuiParent = cg
		return cg
	end
	ESPGuiParent = LocalPlayer:WaitForChild("PlayerGui")
	return ESPGuiParent
end
local function ResolveCharacter(player)
	local character = player.Character
	if character and character.Parent then
		return character
	end
	local live = workspace:FindFirstChild("Live")
	if live then
		local model = live:FindFirstChild(player.Name)
		if model then
			return model
		end
	end
	return character
end
local function ClearESPPlayer(player)
	local data = ESPData[player]
	if data then
		for _, obj in ipairs(data.Objects or {}) do
			pcall(function()
				obj:Destroy()
			end)
		end
		ESPData[player] = nil
	end
	local character = ResolveCharacter(player)
	if character then
		for _, name in ipairs({"NexusTSBHighlight", "NexusTSBBillboard"}) do
			local old = character:FindFirstChild(name)
			if old then
				old:Destroy()
			end
		end
	end
end
local function ClearAllESP()
	for _, player in ipairs(Players:GetPlayers()) do
		ClearESPPlayer(player)
	end
	table.clear(ESPData)
end
local function GetESPColor(player, character)
	if State.ESPColorMode == "Rainbow" then
		return Color3.fromHSV((os.clock() % 5) / 5, 1, 1)
	elseif State.ESPColorMode == "Purple" then
		return Color3.fromRGB(168, 85, 247)
	elseif State.ESPColorMode == "Orange" then
		return Color3.fromRGB(255, 120, 30)
	elseif State.ESPColorMode == "Team" then
		if player.TeamColor then
			return player.TeamColor.Color
		end
		return Color3.fromRGB(255, 255, 255)
	elseif State.ESPColorMode == "Health" then
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if hum and hum.MaxHealth > 0 then
			local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
			return Color3.fromHSV(ratio * 0.33, 1, 1)
		end
	end
	return Color3.fromRGB(168, 85, 247)
end
local function IsTeammate(player)
	return player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team
end
local function ESPObjectsValid(data)
	if not data or not data.Highlight or not data.Billboard then
		return false
	end
	local ok, hp = pcall(function()
		return data.Highlight.Parent
	end)
	if not ok or not hp then
		return false
	end
	local ok2, bp = pcall(function()
		return data.Billboard.Parent
	end)
	if not ok2 or not bp then
		return false
	end
	return true
end
local function UpdateESP()
	if not State.ESP then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			pcall(function()
				local character = ResolveCharacter(player)
				if not character then
					ClearESPPlayer(player)
					return
				end
				local head = character:FindFirstChild("Head")
				local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or head
				local data = ESPData[player]
				if not data or data.Character ~= character or not ESPObjectsValid(data) then
					ClearESPPlayer(player)
					local guiParent = GetESPGuiParent()
					local highlight = Instance.new("Highlight")
					highlight.Name = "NexusTSBHighlight"
					highlight.Adornee = character
					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.FillTransparency = 0.55
					highlight.OutlineTransparency = 0
					highlight.Parent = guiParent
					local billboard = Instance.new("BillboardGui")
					billboard.Name = "NexusTSBBillboard"
					billboard.Adornee = head or root or character
					billboard.AlwaysOnTop = true
					billboard.Size = UDim2.fromOffset(220, 42)
					billboard.StudsOffset = Vector3.new(0, 3, 0)
					billboard.Parent = guiParent
					local label = Instance.new("TextLabel")
					label.Name = "Info"
					label.Size = UDim2.fromScale(1, 1)
					label.BackgroundTransparency = 1
					label.Font = Enum.Font.GothamBold
					label.TextSize = 12
					label.TextStrokeTransparency = 0.25
					label.Parent = billboard
					data = {Character = character, Highlight = highlight, Billboard = billboard, Label = label, Objects = {highlight, billboard}}
					ESPData[player] = data
				end
				pcall(function()
					data.Highlight.Adornee = character
				end)
				if head then
					pcall(function()
						data.Billboard.Adornee = head
					end)
				end
				local color = GetESPColor(player, character)
				data.Highlight.FillColor = color
				data.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
				data.Billboard.Enabled = State.ESPNames or State.ESPDistance
				local parts = {}
				if State.ESPNames then
					table.insert(parts, player.Name)
				end
				if State.ESPDistance and RootPart and root then
					table.insert(parts, tostring(math.floor((root.Position - RootPart.Position).Magnitude)) .. "m")
				end
				data.Label.Text = table.concat(parts, " • ")
				data.Label.TextColor3 = color
			end)
		end
	end
end
