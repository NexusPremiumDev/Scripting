local function bl(hn, hc)
	if not hn or not hc then return end
	pcall(function()
		local oldPivot = nil
		pcall(function() oldPivot = hn:GetPivot() end)

		local savedAnim = nil
		pcall(function()
			local ax = hn:FindFirstChildOfClass("AnimationController")
				or hn:FindFirstChildWhichIsA("AnimationController", true)
			if ax then
				local animator = ax:FindFirstChildOfClass("Animator") or ax:FindFirstChild("Animator")
				if animator then
					for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
						pcall(function() tr:Stop(0) end)
					end
				end
				savedAnim = ax:Clone()
			end
		end)

		local template = hc:Clone()
		if not template then return end

		hn:ClearAllChildren()

		local intactMelee = (hn.Name == "Knife" or hn.Name == "Daggers")
		for _, item in ipairs(template:GetChildren()) do
			if intactMelee then
				item.Parent = hn
			elseif item:IsA("AnimationController") or item:IsA("Animation") then
				item:Destroy()
			else
				for _, d in ipairs(item:GetDescendants()) do
					if d:IsA("Animation") then pcall(function() d:Destroy() end) end
				end
				item.Parent = hn
			end
		end
		template:Destroy()

		if savedAnim then
			if intactMelee and hn:FindFirstChildWhichIsA("AnimationController", true) then
				savedAnim:Destroy()
			else
				for _, c in ipairs(hn:GetChildren()) do
					if c:IsA("AnimationController") then pcall(function() c:Destroy() end) end
				end
				savedAnim.Parent = hn
			end
		end

		-- PrimaryPart fix (stops "Primary is not a valid member")
		pcall(function()
			local prim = hn:FindFirstChild("Primary", true)
				or hn:FindFirstChild("Handle", true)
				or hn:FindFirstChildWhichIsA("BasePart", true)
			if prim and prim:IsA("BasePart") then
				hn.PrimaryPart = prim
			end
			for _, ch in ipairs(hn:GetDescendants()) do
				if ch:IsA("Model") and not ch.PrimaryPart then
					local p = ch:FindFirstChild("Primary", true)
						or ch:FindFirstChild("Handle", true)
						or ch:FindFirstChildWhichIsA("BasePart", true)
					if p and p:IsA("BasePart") then
						ch.PrimaryPart = p
					end
				end
			end
		end)

		-- Ensure visible (some skins ship with Transparency=1 on extras)
		pcall(function()
			for _, p in ipairs(hn:GetDescendants()) do
				if p:IsA("BasePart") then
					-- do not force all to 0 (scopes/sights may be intentional)
					if p.Transparency >= 1 and (p.Name == "Primary" or p.Name == "Handle" or p.Name:lower():find("blade") or p.Name:lower():find("knife")) then
						p.Transparency = 0
					end
					p.LocalTransparencyModifier = 0
				elseif p:IsA("MeshPart") then
					p.LocalTransparencyModifier = 0
				end
			end
		end)

		nexusHideBlockParts(hn)
		if oldPivot then pcall(function() hn:PivotTo(oldPivot) end) end
	end)
end

