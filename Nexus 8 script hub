local lastSave = 0
SaveConfig = function(force)
	local now = os.clock()
	if not force and now - lastSave < 1 then return end
	lastSave = now
	pcall(function()
		if writefile and HttpService then
			if isfolder and makefolder and not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
			local data = {}
			for k, v in pairs(S) do
				if type(v) == "boolean" or type(v) == "number" or type(v) == "string" then data[k] = v end
			end
			data.Farming = false
			data.ChestFarm = false
			data.Fly = false
			writefile(ConfigFile, HttpService:JSONEncode(data))
		end
	end)
end

