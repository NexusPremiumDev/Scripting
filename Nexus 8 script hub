local function IsMurdererNear(position, studs)
	local murderer = RoleSummary.Murderer
	local root = murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart")
	if not root or not position then
		return false
	end
	return (root.Position - position).Magnitude <= (studs or 22)
end
local function HasLineOfSight(targetPart, targetChar)
	local cam = workspace.CurrentCamera
	if not cam or not targetPart then
		return false
	end
	local origin = cam.CFrame.Position
	local direction = targetPart.Position - origin
	if direction.Magnitude < 0.1 then
		return true
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	if Character then
		params.FilterDescendantsInstances = {Character}
	end
	params.IgnoreWater = true
	local ok, result = pcall(function()
		return workspace:Raycast(origin, direction, params)
	end)
	if not ok or not result then
		return true
	end
	if targetChar and result.Instance and result.Instance:IsDescendantOf(targetChar) then
		return true
	end
	return false
end
