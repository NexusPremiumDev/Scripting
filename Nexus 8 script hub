			end
			for _, ch in ipairs(model:GetDescendants()) do
				if ch:IsA("Model") and not ch.PrimaryPart then
					local p = ch:FindFirstChild("Primary", true)
						or ch:FindFirstChild("Handle", true)
						or ch:FindFirstChildWhichIsA("BasePart", true)
					if p and p:IsA("BasePart") then ch.PrimaryPart = p end
				end
			end
		end
	end)
end

