local function formatBytes(n)
	n = tonumber(n) or 0
	if n < 1024 then return tostring(n) .. " B" end
	if n < 1024 * 1024 then return string.format("%.1f KB", n / 1024) end
	return string.format("%.2f MB", n / (1024 * 1024))
