function Apex.StartTelemetry()
	if Apex.Runtime.TelemetryConn then return end
	local frames = 0
	local lastT = os.clock()
	Apex.Runtime.TelemetryConn = RunService.RenderStepped:Connect(function()
		if Apex.Runtime.Dead or not Apex.UI.Gui or not Apex.UI.Gui.Parent then
			if Apex.Runtime.TelemetryConn then
				pcall(function() Apex.Runtime.TelemetryConn:Disconnect() end)
				Apex.Runtime.TelemetryConn = nil
			end
			return
		end
		frames = frames + 1
		local now = os.clock()
		if Apex.UI.BorderGradient then
			Apex.UI.BorderGradient.Rotation = (Apex.UI.BorderGradient.Rotation + 0.45) % 360
		end
		if now - lastT >= 0.5 then
			local fps = math.floor(frames / (now - lastT) + 0.5)
			frames = 0
			lastT = now
			local ping = 0
			pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000 + 0.5) end)
			local memText = ""
			pcall(function()
				if gcinfo then memText = string.format(" · %.0f MB", gcinfo() / 1024) end
			end)
			if Apex.UI.Telemetry then
				Apex.UI.Telemetry.Text = string.format("FPS %d · PING %dms%s · APEX v7", fps, ping, memText)
			end
		end
	end)
end
function Apex.WarmupDetected()
	if not State.Settings.WarmupDetected then return end
	task.spawn(function()
		task.wait(0.8)
		for _, item in ipairs(Apex.Registry) do
			if Apex.IsCurrentGame(item) and item.SourceIndex and not Apex.Cache[item.Id] then
				Apex.Compile(item)
				task.wait(0.08)
			end
		end
		if Apex.RebuildCards then Apex.RebuildCards() end
	end)
end
function Apex.BindKeys()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if Apex.Runtime.Dead or not Apex.UI.Gui or not Apex.UI.Gui.Parent then return end
		local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if input.KeyCode == Enum.KeyCode.K and ctrl then
			Apex.UI.Gui.Enabled = true
			if Apex.UI.Main and not Apex.UI.Main.Visible then Apex.ToggleMinimize() end
			if Apex.UI.SearchBox then pcall(function() Apex.UI.SearchBox:CaptureFocus() end) end
			return
		end
		if gameProcessed then return end
		if Apex.UI.SearchBox and Apex.UI.SearchBox:IsFocused() then return end
		if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert then
			Apex.UI.Gui.Enabled = not Apex.UI.Gui.Enabled
		end
	end)
end
function Apex.Boot()
	if Apex.Runtime.Booted then return end
	Apex.Runtime.Booted = true
	Apex.CleanOldGuis()
	local gui = mk("ScreenGui", nil, {
		Name = "ApexEngineV7",
		ResetOnSpawn = false,
		DisplayOrder = 999999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
	})
	Apex.UI.Gui = gui
	Apex.ParentGui(gui)
	local toastHolder = mk("Frame", gui, {
