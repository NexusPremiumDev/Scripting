				if type(bag) ~= "table" then return end
				local keys = {}
				for k in pairs(bag) do
					keys[#keys + 1] = tostring(k)
				end
				table.sort(keys)
				for _, key in ipairs(keys) do
					if not (ApexCfgSM.Ignore and ApexCfgSM.Ignore[key]) then
						local object = bag[key]
						if type(object) == "table" and object.Value ~= nil then
							parts[#parts + 1] = prefix .. ":" .. key .. "=" .. ApexCfgValueText(object.Value) .. "|" .. ApexCfgValueText(object.Transparency) .. "|" .. ApexCfgValueText(object.Mode) .. "|" .. ApexCfgValueText(object.Modifiers)
