			pcall(function()
				local bags = {}
				if type(Toggles) == "table" then bags[#bags + 1] = Toggles end
				if Library and type(Library.Toggles) == "table" then bags[#bags + 1] = Library.Toggles end
				for _, bag in ipairs(bags) do
