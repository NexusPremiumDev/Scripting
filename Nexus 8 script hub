ESPLibrary = NexusESPLibrary
ESPGui = NexusESPScreen

local NexusESPKindMap = {
    Door="Door", Objective="Objective", HidingPlace="HidingPlace", GateLever="GateLever",
    Books="Books", Breakers="Breakers", Gold="Gold", Entity="Entity", Ladder="Ladder", Fuse="Fuse"
}

function NexusESPApplyColor(kind, color)
    local c = NexusESPLibrary.Settings
    for obj, data in pairs(NexusESPLibrary.Cache) do
        if data and data.NexusKind == kind then
            data.Color = color
            data.Text.TextColor3 = color
            data.Box.FillColor = color
            data.Line.BackgroundColor3 = color
            data.Arrow.ImageColor3 = color
        end
    end
end

-- Tag cache entries with their logical ESP type so color changes can update live.
local _NexusOldAddESP = NexusESPLibrary.AddESP
NexusESPLibrary.AddESP = function(self, cfg)
    _NexusOldAddESP(self, cfg)
    local data = self.Cache[cfg.Object]
    if data then data.NexusKind = cfg.NexusKind end
end

local function NexusSyncKind(kind)
    local toggle = Toggles and Toggles[kind]
    NexusSetESP(kind, toggle and toggle.Value == true)
end

function UpdateDoorESP() NexusSyncKind("Door") end
function UpdateObjectiveESP() NexusSyncKind("Objective") end
