local function removeEspVisual(v)
	if not v then return end
	pcall(function()
		if v.Box then v.Box:Remove() end
		if v.Name then v.Name:Remove() end
		if v.Dist then v.Dist:Remove() end
		if v.HpBg then v.HpBg:Remove() end
		if v.HpFill then v.HpFill:Remove() end
		if v.SkeletonLines then
			for _, ln in ipairs(v.SkeletonLines) do pcall(function() ln:Remove() end) end
		end
	end)
end

local function hideEspVisual(v)
	if not v then return end
	pcall(function()
		if v.Box then v.Box.Visible = false end
		if v.Name then v.Name.Visible = false end
		if v.Dist then v.Dist.Visible = false end
		if v.HpBg then v.HpBg.Visible = false end
		if v.HpFill then v.HpFill.Visible = false end
		if v.SkeletonLines then
			for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end
		end
	end)
end

