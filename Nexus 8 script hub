nexusHideBlockParts = function(model)
	if not model then return end
	pcall(function()
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				local n = string.lower(p.Name)
				local hasSpecial = p:FindFirstChildOfClass("SpecialMesh") or p:FindFirstChildOfClass("BlockMesh") or p:FindFirstChildOfClass("CylinderMesh")
				local isMeshPart = p:IsA("MeshPart")
				local meshOk = isMeshPart and p.MeshId ~= nil and p.MeshId ~= "" and p.MeshId ~= "rbxassetid://0"
				local looksHitbox = n:find("hitbox") or n:find("collide") or n:find("hurt")
					or n:find("damage") or n == "part" or n == "block" or n == "cube"
					or n:find("bladebox") or n:find("proxy")
				local size = p.Size
				local isBlocky = (not isMeshPart and not hasSpecial) or (isMeshPart and not meshOk)
				-- white/grey default material blocks at tip
				if looksHitbox or isBlocky then
					-- keep Primary/Handle if it has a real mesh
					if meshOk and (n == "primary" or n == "handle" or n:find("blade") or n:find("knife") or n:find("weapon")) then
						-- keep visible
					else
						if isBlocky or looksHitbox then
							p.Transparency = 1
							p.LocalTransparencyModifier = 1
							p.CanCollide = false
							p.CastShadow = false
						end
					end
				end
				if isMeshPart and not meshOk then
					p.Transparency = 1
					p.LocalTransparencyModifier = 1
				end
			end
		end
	end)
end

nexusFixPrimary = function(model)
	if not model then return end
	pcall(function()
		if model:IsA("Model") then
			local prim = model.PrimaryPart
				or model:FindFirstChild("Primary", true)
				or model:FindFirstChild("Handle", true)
				or model:FindFirstChildWhichIsA("BasePart", true)
			if prim and prim:IsA("BasePart") then
