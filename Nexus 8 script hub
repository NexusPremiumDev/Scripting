local function ScanSkinDatabase()
	local foundKnife, foundGun = {}, {}
	pcall(function()
		local renv = (typeof(getrenv) == "function" and getrenv()) or nil
		local db = (renv and renv._G and renv._G.Database) or (genv and genv.Database) or nil
		local items = db and (db.Item or db.Items or db)
		if type(items) ~= "table" then
			return
		end
		local function readEntry(data, out)
			for k, v in pairs(data) do
				local lk = string.lower(tostring(k))
				if (lk == "mesh" or lk == "meshid") and (type(v) == "string" or type(v) == "number") then
					out.Mesh = tostring(v)
				elseif (lk == "texture" or lk == "textureid") and (type(v) == "string" or type(v) == "number") then
					out.Texture = tostring(v)
				elseif (lk == "itemtype" or lk == "type") and type(v) == "string" then
					out.ItemType = v
				elseif type(v) == "table" then
					readEntry(v, out)
				end
			end
		end
		for itemName, data in pairs(items) do
			if type(data) == "table" then
				local entry = {}
				readEntry(data, entry)
				local meshDigits = entry.Mesh and string.match(tostring(entry.Mesh), "%d+")
				local textureDigits = entry.Texture and string.match(tostring(entry.Texture), "%d+")
				if meshDigits and textureDigits and entry.ItemType then
					local preset = {Name = tostring(itemName), Mesh = meshDigits, Texture = textureDigits}
					local lt = string.lower(entry.ItemType)
					if string.find(lt, "knife", 1, true) then
						table.insert(foundKnife, preset)
					elseif string.find(lt, "gun", 1, true) then
						table.insert(foundGun, preset)
					end
				end
			end
		end
	end)
	local function byName(a, b)
		return tostring(a.Name) < tostring(b.Name)
	end
	table.sort(foundKnife, byName)
	table.sort(foundGun, byName)
	for _, p in ipairs(foundKnife) do
		table.insert(KnifeSkinPresets, p)
	end
	for _, p in ipairs(foundGun) do
		table.insert(GunSkinPresets, p)
	end
	return #foundKnife + #foundGun
end
