function Apex.On(eventName, callback)
	if type(callback) ~= "function" then return function() end end
	Apex.Bus[eventName] = Apex.Bus[eventName] or {}
	table.insert(Apex.Bus[eventName], callback)
	return function()
		local list = Apex.Bus[eventName]
		if list then
			for i = #list, 1, -1 do
				if list[i] == callback then table.remove(list, i) end
			end
		end
	end
end
