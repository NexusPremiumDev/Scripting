		animator.Parent = hum
	end
	DropkickAnim = Instance.new("Animation")
	DropkickAnim.AnimationId = "rbxassetid://17354976067"
	local loadOk, track = pcall(function()
		return animator:LoadAnimation(DropkickAnim)
	end)
	if not loadOk or not track then
		StopDropkick()
		return
	end
	DropkickTrack = track
	track.Looped = false
	track:AdjustSpeed(3)
	track:Play()
	DropkickSound = Instance.new("Sound")
	DropkickSound.SoundId = "rbxassetid://17429233290"
