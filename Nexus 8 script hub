function Apex.ExecuteCompiled(item, fn, token)
	task.spawn(function()
		local started = os.clock()
		local ok, err = pcall(fn)
		local elapsed = math.floor((os.clock() - started) * 1000 + 0.5)
		if Apex.Runtime.LaunchToken == token then
			Apex.Runtime.Launching = false
		end
		if not ok then
			Apex.Log("ERROR", "Runtime error in " .. item.Name .. " after " .. tostring(elapsed) .. "ms: " .. tostring(err))
			if Apex.UI.Gui and Apex.UI.Gui.Parent then
				Apex.UI.Gui.Enabled = true
				if Apex.UI.Main then Apex.UI.Main.Visible = true end
				if Apex.UI.MiniDock then Apex.UI.MiniDock.Visible = false end
			end
			Apex.SetStatus("● ERROR — HUB RESTORED: " .. item.Name, C.Red)
			Apex.Toast("⚠ " .. item.Name .. " errored. Hub restored.", C.Red)
			return
		end
		Apex.Log("INFO", "Executed " .. item.Name .. " in " .. tostring(elapsed) .. "ms")
		if item.Category == "Games" and State.Settings.CloseOnLaunch and not Apex.Runtime.Dead then
			Apex.DestroyHub()
		else
			Apex.SetStatus("● RUNNING: " .. item.Name, C.Green)
			Apex.Toast("✓ " .. item.Name, C.Green)
			if Apex.RebuildCards then Apex.RebuildCards() end
		end
	end)
	task.delay(25, function()
		if Apex.Runtime.LaunchToken == token and Apex.Runtime.Launching then
			Apex.Runtime.Launching = false
			Apex.Log("WARN", item.Name .. " is still running after 25s; watchdog released the launch lock")
		end
	end)
end
function Apex.Launch(item)
	if not item then return end
	if Apex.Runtime.Launching then
		Apex.Toast("Another launch is in progress. Please wait.", C.Amber)
		return
	end
	if item.Run then
		Apex.RecordUse(item)
		local ok, err = pcall(item.Run)
		if ok then
			Apex.SetStatus("● RUNNING: " .. item.Name, C.Green)
		else
			Apex.Log("ERROR", "Built-in failed for " .. item.Name .. ": " .. tostring(err))
			Apex.Toast("⚠ " .. item.Name .. " failed: " .. tostring(err), C.Red)
		end
		if Apex.RebuildCards then Apex.RebuildCards() end
		return
	end
	Apex.Runtime.Launching = true
	Apex.Runtime.LaunchToken = Apex.Runtime.LaunchToken + 1
	local token = Apex.Runtime.LaunchToken
	Apex.SetStatus("● COMPILING: " .. item.Name, C.Purple)
	local fn, err = Apex.Compile(item)
	if not fn then
		Apex.Runtime.Launching = false
		Apex.SetStatus("● COMPILE ERROR: " .. item.Name, C.Red)
		Apex.Toast("⚠ Compile error: " .. tostring(err), C.Red)
		return
	end
	Apex.RecordUse(item)
	Apex.SetStatus("● LAUNCHING: " .. item.Name, C.Purple)
	Apex.Toast("▶ Launching: " .. item.Name, C.Purple)
	Apex.Emit("Launch", item)
	if item.Category == "Games" and State.Settings.CloseOnLaunch and Apex.UI.Gui then
		pcall(function() Apex.UI.Gui.Enabled = false end)
		task.delay(0.3, function()
			if not Apex.Runtime.Dead then
				Apex.ExecuteCompiled(item, fn, token)
			end
		end)
	else
		Apex.ExecuteCompiled(item, fn, token)
	end
end
