ess = 0.05\n\t\tspinBotEnabled = true\n\t\t_G.EnableSpeed = true\n\t\ttoggleFixedHeadSpin(true)\n\t\tif not takeLEnabled then toggleTakeL() end\n\telse\n\t\tgetgenv().Smoothness = 0.35\n\t\tspinBotEnabled = false\n\t\t_G.EnableSpeed = false\n\t\ttoggleFixedHeadSpin(false)\n\t\tif takeLEnabled then toggleTakeL() end\n\t\tif humanoid then humanoid.CameraOffset = Vector3.new(0, 0, 0) end\n\t\tif humanoid then humanoid.PlatformStand = false end\n\tend\n\tupdateStatus()\nend\n\nfunction toggleTakeL()\n\ttakeLEnabled = not takeLEnabled\n\tif takeLEnabled then\n\t\tpcall(function()\n\t\t\tif humanoid then\n\t\t\t\tlocal anim = Instance.new(\"Animation\")\n\t\t\t\tanim.AnimationId = danceAnimId\n\t\t\t\tdanceTrack = humanoid:LoadAnimation(anim)\n\t\t\t\tdanceTrack.Looped = true\n\t\t\t\tdanceTrack:Play()\n\t\t\t\tdanceTrack:AdjustSpeed(25)\n\t\t\tend\n\t\tend)\n\telse\n\t\tif danceTrack then\n\t\t\tdanceTrack:Stop()\n\t\t\tdanceTrack = nil\n\t\tend\n\tend\n\tupdateStatus()\nend\n\n-- GUI BUTTONS\nstatusIndicators.silent = createClickableFeatureRow(\"Silent Aim (B)\", function() return silentEnabled and \"🟢 ON\" or \"🔴 OFF\" end, function()\n\tsilentEnabled = not silentEnabled\n\tif not silentEnabled then\n\t\ttargetPlayer = nil\n\t\tisLeftMouseDown = false\n\t\tautoShootEnabled = false\n\t\tif autoClickConnection then\n\t\t\tautoClickConnection:Disconnect()\n\t\t\tautoClickConnection = nil\n\t\tend\n\tend\n\tupdateStatus()\nend)\n\nstatusIndicators.autoshoot = createClickableFeatureRow(\"Auto Shoot\", function() return autoShootEnabled and \"🟢 ON\" or \"🔴 OFF\" end, function()\n\tif not silentEnabled then return end\n\tautoShootEnabled = not autoShootEnabled\n\tif autoShootEnabled and not autoClickConnection then autoClick() end\n\tupdateStatus()\nend)\n\nstatusIndicators.aimlock = createClickableFeatureRow(\"Aimlock\", function() return not AimbotEnabled and \"🔴 OFF\" end, function()\n\tAimbotEnabled = not AimbotEnabled\n\tupdateStatus()\nend)\n\nstatusIndicators.rage = createClickableFeatureRow(\"Rage Mode (P)\", function() return rageModeEnabled and \"🟢 ON\" or \"🔴 OFF\" end, toggleRageMode)\nstatusIndicators.takel = createClickableFeatureRow(\"Hyper Fast Dance + Head Glitch\", function() return takeLEnabled and \"🟢 ON\" or \"🔴 OFF\" end, toggleTakeL)\nstatusIndicators.loopgoto = createClickableFeatureRow(\"LoopGoto / Bang (G)\", function() return loopGotoEnabled and \"🟢 ON\" or \"🔴 OFF\" end, toggleLoopGoto)\nstatusIndicators.tpkill = createClickableFeatureRow(\"TP + Kill\", function() return tpKillEnabled and \"🟢 ON\" or \"🔴 OFF\" end, function() DoSilentKillSafe() end)\nstatusIndicators.fixedheadspin = createClickableFeatureRow(\"Fixed Head Spin\", function() return fixedHeadSpinEnabled and \"🟢 ON\" or \"🔴 OFF\" end, function() toggleFixedHeadSpin(not fixedHeadSpinEnabled) end)\nstatusIndicators.noclip = createClickableFeatureRow(\"Noclip\", function() return noclipEnabled and \"🟢 ON\" or \"🔴 OFF\" end, function() noclipEnabled = not noclipEnabled; setNoclip(noclipEnabled); updateStatus() end)\nstatusIndicators.speed = createClickableFeatureRow(\"WalkSpeed\", function() return _G.EnableSpeed and \"🟢 ON\" or \"🔴 OFF\" end, function() _G.EnableSpeed = not _G.EnableSpeed; updateStatus() end)\nstatusIndicators.night = createClickableFeatureRow(\"Night Mode\", function() return nightModeEnabled and \"🟢 ON\" or \"🔴 OFF\" end, function() toggleNightMode(not nightModeEnabled); updateStatus() end)\nstatusIndicators.esp = createClickableFeatureRow(\"ESP (X)\", function() return espenabled and \"🟢 ON\" or \"🔴 OFF\" end, function() espenabled = not espenabled; rebuildHighlights(); updateStatus() end)\n\nlocal iyButton = Instance.new(\"TextButton\")\niyButton.Size = UDim2.new(1, 0, 0, 34)\niyButton.BackgroundColor3 = Color3.fromRGB(35, 30, 60)\niyButton.BorderSizePixel = 0\niyButton.AutoButtonColor = true\niyButton.Text = \"Infinite Yield (Admin)\"\niyButton.TextColor3 = Color3.fromRGB(200, 190, 255)\niyButton.Font = Enum.Font.GothamBold\niyButton.TextSize = 12\niyButton.Parent = contentScroll\n\nlocal iyCorner = Instance.new(\"UICorner\")\niyCorner.CornerRadius = UDim.new(0, 6)\niyCorner.Parent = iyButton\n\niyButton.MouseButton1Click:Connect(function()\n\tloadstring(game:HttpGet(\"https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source\"))()\nend)\n\nfunction updateStatus()\n\tstatusIndicators.silent.Text = silentEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.autoshoot.Text = autoShootEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.aimlock.Text = not AimbotEnabled and \"🔴 OFF\" or aiming and \"🟢 ON\" or \"🟡 READY\"\n\tstatusIndicators.rage.Text = rageModeEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.takel.Text = takeLEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.loopgoto.Text = loopGotoEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.tpkill.Text = tpKillEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.fixedheadspin.Text = fixedHeadSpinEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.noclip.Text = noclipEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.speed.Text = _G.EnableSpeed and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.night.Text = nightModeEnabled and \"🟢 ON\" or \"🔴 OFF\"\n\tstatusIndicators.esp.Text = espenabled and \"🟢 ON\" or \"🔴 OFF\"\nend\n\nlocal function isLobbyVisible()\n\tlocal gui = localPlayer.PlayerGui:FindFirstChild(\"MainGui\")\n\tif gui and gui:FindFirstChild(\"MainFrame\") then\n\t\tlocal lobby = gui.MainFrame:FindFirstChild(\"Lobby\")\n\t\tif lobby and lobby:FindFirstChild(\"Currency\") then\n\t\t\treturn lobby.Currency.Visible\n\t\tend\n\tend\n\treturn false\nend\n\nlocal function getClosestPlayerOffScreen()\n\tlocal closestPlayer = nil\n\tlocal shortestDistance = math.huge\n\tif not rootPart then return nil end\n\tlocal origin = rootPart.Position\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tif player ~= localPlayer and player.Character then\n\t\t\tlocal hrp = player.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tlocal hum = player.Character:FindFirstChild(\"Humanoid\")\n\t\t\tif hrp and hum and hum.Health > 0 then\n\t\t\t\tlocal distance = (hrp.Position - origin).Magnitude\n\t\t\t\tif distance < shortestDistance then\n\t\t\t\t\tshortestDistance = distance\n\t\t\t\t\tclosestPlayer = player\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn closestPlayer\nend\n\nlocal function lockCameraToHead()\n\tif targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild(\"Head\") then\n\t\tlocal head = targetPlayer.Character.Head\n\t\tcamera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)\n\tend\nend\n\nlocal function get_target()\n\tlocal target = nil\n\tlocal closestDistance = 2000\n\tlocal myCharacter = localPlayer.Character\n\tif not myCharacter then return nil end\n\tlocal myRoot = myCharacter:FindFirstChild(\"HumanoidRootPart\")\n\tif not myRoot then return nil end\n\n\tfor _, v in ipairs(Players:GetPlayers()) do\n\t\tif v ~= localPlayer and v.Character then\n\t\t\tlocal humanoid = v.Character:FindFirstChild(\"Humanoid\")\n\t\t\tlocal root = v.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif humanoid and humanoid.Health > 0 and root then\n\t\t\t\tlocal distance = (root.Position - myRoot.Position).Magnitude\n\t\t\t\tif distance < closestDistance then\n\t\t\t\t\tlocal part = v.Character:FindFirstChild(\"HeadHB\") or v.Character:FindFirstChild(\"Head\") or v.Character:FindFirstChild(\"UpperTorso\")\n\t\t\t\t\tif part then\n\t\t\t\t\t\tclosestDistance = distance\n\t\t\t\t\t\ttarget = part\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn target\nend\n\n-- Aimbot / Smooth Aim & Spin Bot & Hyper Fast Dance + Head Glitch/Snap Logic\nRunService.RenderStepped:Connect(function(dt)\n\tif spinBotEnabled and rootPart then\n\t\trootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)\n\tend\n\n\tif AimbotEnabled and (aiming or rageModeEnabled) and getgenv().Aimbot then\n\t\tlocal target = get_target()\n\t\tif target and target.Parent then\n\t\t\tlocal pos, onScreen = camera:WorldToViewportPoint(target.Position)\n\t\t\tif onScreen or rageModeEnabled then\n\t\t\t\tlocal mouse = UserInputService:GetMouseLocation()\n\t\t\t\tlocal x = (pos.X - mouse.X) * getgenv().Smoothness\n\t\t\t\tlocal y = (pos.Y - mouse.Y) * getgenv().Smoothness\n\t\t\t\tif mousemoverel then mousemoverel(x, y) end\n\t\t\tend\n\t\tend\n\tend\n\t\n\t-- Ultra hızlı dans, sağa sola çılgın bakışlar ve kafanın yerinden çıkıp sağa sola yatması (Neck glitch) + Rage modda sürekli eğilip kalkma (Crouch spam)\n\tif takeLEnabled and humanoid and rootPart then\n\t\tif danceTrack and not danceTrack.IsPlaying then\n\t\t\tdanceTrack:Play()\n\t\tend\n\t\tif danceTrack and danceTrack.Speed ~= 25 then\n\t\t\tdanceTrack:AdjustSpeed(25)\n\t\tend\n\t\t\n\t\tdanceTime = danceTime + dt * 45\n\t\tlocal offsetX = math.sin(danceTime) * 2.5\n\t\tlocal offsetZ = math.cos(danceTime * 1.3) * 2.5\n\t\tlocal randomRotation = math.rad(math.random(-180, 180))\n\t\t\n\t\t-- Rage mod aktifse sürekli eğilip kalkma efekti\n\t\tlocal crouchOffset = 0\n\t\tif rageModeEnabled then\n\t\t\tcrouchOffset = math.abs(math.sin(danceTime * 4)) * -2.2\n\t\tend\n\t\thumanoid.CameraOffset = Vector3.new(0, crouchOffset, 0)\n\t\t\n\t\trootPart.CFrame = rootPart.CFrame + Vector3.new(offsetX, math.sin(danceTime * 3) * 0.6, offsetZ) * CFrame.Angles(0, randomRotation, 0)\n\t\t\n\t\t-- Kafanın yerinden çıkması / sağa sola çılgınca yatması (Neck Manipülasyonu)\n\t\tlocal head = character:FindFirstChild(\"Head\")\n\t\tif head then\n\t\t\tlocal neck = head:FindFirstChild(\"Neck\")\n\t\t\tif neck then\n\t\t\t\tlocal headTiltX = math.sin(danceTime * 5) * 1.5\n\t\t\t\tlocal headTiltZ = math.cos(danceTime * 4) * 1.5\n\t\t\t\tlocal headPosOffset = Vector3.new(math.sin(danceTime * 6) * 1.2, math.cos(danceTime * 5) * 0.8, math.cos(danceTime * 6) * 1.2)\n\t\t\t\tneck.C0 = CFrame.new(headPosOffset) * CFrame.Angles(headTiltX, 0, headTiltZ)\n\t\t\tend\n\t\tend\n\tend\nend)\n\n-- AutoClick Logic\nfunction autoClick()\n\tif autoClickConnection then autoClickConnection:Disconnect() end\n\tautoClickConnection = RunService.Heartbeat:Connect(function()\n\t\tif not silentEnabled and not rageModeEnabled then\n\t\t\tautoClickConnection:Disconnect()\n\t\t\tautoClickConnection = nil\n\t\t\treturn\n\t\tend\n\t\tif isLeftMouseDown or autoShootEnabled or (rageModeEnabled and aiming) then\n\t\t\tif not isLobbyVisible() then\n\t\t\t\tif mouse1click then mouse1click() end\n\t\t\tend\n\t\telse\n\t\t\tautoClickConnection:Disconnect()\n\t\t\tautoClickConnection = nil\n\t\tend\n\tend)\nend\n\n-- WalkSpeed\nRunService.RenderStepped:Connect(function()\n\tif not _G.EnableSpeed then return end\n\tlocal char = localPlayer.Character\n\tif not char then return end\n\tlocal hum = char:FindFirstChild(\"Humanoid\")\n\tlocal root = char:FindFirstChild(\"HumanoidRootPart\")\n\tif hum and root and hum.MoveDirection.Magnitude > 0 then\n\t\troot.CFrame += hum.MoveDirection * (_G.SpeedPower / 10)\n\tend\nend)\n\n-- LoopGoto / Bang / Güvenli Bölge (Sadece dürbün/sağ tık açıldığında çalışır)\nRunService.Heartbeat:Connect(function()\n\tlocal activeBang = (loopGotoEnabled or rageModeEnabled) and aiming\n\tif activeBang then\n\t\tlocal currentTarget = loopGotoTarget\n\t\tif (loopGotoEnabled or rageModeEnabled) and aiming then\n\t\t\tcurrentTarget = targetPlayer or getClosestPlayerOffScreen()\n\t\tend\n\n\t\tif currentTarget and currentTarget.Character then\n\t\t\tlocal targetChar = currentTarget.Character\n\t\t\tlocal targetHRP = targetChar:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tlocal targetHum = targetChar:FindFirstChild(\"Humanoid\")\n\t\t\t\n\t\t\tif targetHum and targetHum.Health <= 0 then\n\t\t\t\tif loopGotoEnabled then toggleLoopGoto() end\n\t\t\t\treturn\n\t\t\tend\n\t\t\t\n\t\t\tlocal myHRP = rootPart\n\t\t\tlocal hum = humanoid\n\t\t\tif targetHRP and myHRP and hum then\n\t\t\t\tif not isLobbyVisible() then\n\t\t\t\t\tmyHRP.CFrame = targetHRP.CFrame * CFr