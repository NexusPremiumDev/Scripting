local function getClosestSilentTarget()
	local viewport = Camera.ViewportSize
	if not viewport or viewport.Magnitude < 1 then return nil end

	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local bestPlayer, bestDist = nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= k and isPlayerAlive(plr) then
			local char = plr.Character
			local targetPart = getTargetPart(char, aimbonePart)
			if targetPart then
				local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPos.Z > 0 then
					local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
					if dist2d < silentMaxFOV and dist2d < bestDist then
						bestDist = dist2d
						bestPlayer = plr
					end
				end
			end
		end
	end

	return bestPlayer
end

