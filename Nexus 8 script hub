local function checksumText(text)
	if type(text) ~= "string" then return "00000000" end
	local a = 1
	local b = 0
	for i = 1, #text do
		a = (a + string.byte(text, i)) % 65521
		b = (b + a) % 65521
	end
	return string.format("%08X", b * 65536 + a)
end
