			end
		end
	end
	if S.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local mousePos = UserInputService:GetMouseLocation()
		local bestPart, bestDist = nil, S.AimbotFOV
