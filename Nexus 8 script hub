local function reapplyRageAfterSpawn(character)
	task.defer(function()
		isAimingKeyHeld = false
		scopeSkyReturnPending = false
		scopeSkyReturnCFrame = nil
		skyCampSuspended = false
		if not rageModeEnabled then return end
		
		task.wait(0.4)
		pcall(function()
			if toggleSkyCamp then toggleSkyCamp(true) end
		end)
		pcall(function()
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			if hrp and skyCampEnabled then
				hrp.CFrame = CFrame.new(hrp.Position.X, SKY_CAMP_ALTITUDE or 1500, hrp.Position.Z)
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			if hum and skyCampEnabled then
				hum.PlatformStand = true
			end
		end)
		pcall(function()
			silentEnabled = true
			autoShootEnabled = true
			triggerBotEnabled = true
			aimbotEnabled = true
			loopGotoEnabled = true
			hitboxEnabled = true
			spinBotEnabled = true
			_G.EnableSpeed = true
		end)
		print("[Ultra Rage] Rage Mode still ON after respawn")
	end)
end
if k.Character then reapplyRageAfterSpawn(k.Character) end
