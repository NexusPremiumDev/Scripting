function toggleLoopGoto()
	loopGotoEnabled = not loopGotoEnabled
	if loopGotoEnabled then
		local playersList = Players:GetPlayers()
		local validTargets = {}
		for _, p in ipairs(playersList) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					table.insert(validTargets, p)
				end
			end
		end
		if #validTargets > 0 then
			loopGotoTarget = validTargets[math.random(1, #validTargets)]
		else
			loopGotoTarget = nil
			loopGotoEnabled = false
		end
	else
		loopGotoTarget = nil
		if humanoid then humanoid.PlatformStand = false end
	end
	updateStatus()
end

function toggleRageMode()
	rageModeEnabled = not rageModeEnabled
	if rageModeEnabled then
		silentEnabled = true
		autoShootEnabled = true
		AimbotEnabled = true
		loopGotoEnabled = true
		getgenv().Smoothness = 0.005
		spinBotEnabled = true
		_G.EnableSpeed = true
		bendEnabled = true
		spinSpeed = 300
		toggleFixedHeadSpin(true)
		if not takeLEnabled then toggleTakeL() end
		
		local playersList = Players:GetPlayers()
		local validTargets = {}
		for _, p in ipairs(playersList) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					table.insert(validTargets, p)
				end
			end
		end
		if #validTargets > 0 then
			loopGotoTarget = validTargets[math.random(1, #validTargets)]
		end

		if autoShootEnabled and not autoClickConnection then autoClick() end
	else
		silentEnabled = false
		autoShootEnabled = false
		AimbotEnabled = false
		loopGotoEnabled = false
		spinBotEnabled = false
		_G.EnableSpeed = false
		bendEnabled = false
		toggleFixedHeadSpin(false)
		if takeLEnabled then toggleTakeL() end
		
		targetPlayer = nil
		loopGotoTarget = nil
		isLeftMouseDown = false
		if autoClickConnection then
			autoClickConnection:Disconnect()
			autoClickConnection = nil
		end
		
		if humanoid then 
			humanoid.CameraOffset = Vector3.new(0, 0, 0) 
			humanoid.PlatformStand = false 
		end
		
		pcall(function()
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("Motor6D") then
						part.C1 = CFrame.new(0, 0, 0)
					end
				end
				local head = character:FindFirstChild("Head")
				if head then
					local neck = head:FindFirstChild("Neck")
					if neck and originalHeadC0 then
						neck.C0 = originalHeadC0
					end
				end
			end
		end)
	end
	updateStatus()
end

