local function isLobbyVisible()
	local gui = localPlayer.PlayerGui:FindFirstChild("MainGui")
	if gui and gui:FindFirstChild("MainFrame") then
		local lobby = gui.MainFrame:FindFirstChild("Lobby")
		if lobby and lobby:FindFirstChild("Currency") then
			return lobby.Currency.Visible
		end
	end
	return false
end

local function getClosestPlayerOffScreen()
	local closestPlayer = nil
	local shortestDistance = math.huge
	if not rootPart then return nil end
	local origin = rootPart.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChild("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local distance = (hrp.Position - origin).Magnitude
				if distance < shortestDistance then
					shortestDistance = distance
					closestPlayer = player
				end
			end
		end
	end
	return closestPlayer
end

local function lockCameraToHead()
	if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
		local head = targetPlayer.Character.Head
		camera.CFrame = CFrame.new(camera.CFrame.Position, head.Position)
	end
end

local function get_target()
	local target = nil
	local closestDistance = 3000
	local myCharacter = localPlayer.Character
	if not myCharacter then return nil end
	local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	for _, v in ipairs(Players:GetPlayers()) do
		if v ~= localPlayer and v.Character then
			local humanoid = v.Character:FindFirstChild("Humanoid")
			local root = v.Character:FindFirstChild("HumanoidRootPart")
			if humanoid and humanoid.Health > 0 and root then
				local distance = (root.Position - myRoot.Position).Magnitude
				if distance < closestDistance then
					local part = v.Character:FindFirstChild("HeadHB") or v.Character:FindFirstChild("Head") or v.Character:FindFirstChild("UpperTorso")
					if part then
						closestDistance = distance
						target = part
					end
				end
			end
		end
	end
	return target
end

RunService.RenderStepped:Connect(function(dt)
	if spinBotEnabled and rootPart then
		rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
	end

	if AimbotEnabled and (aiming or rageModeEnabled) and getgenv().Aimbot then
		local target = get_target()
		if target and target.Parent then
			local pos, onScreen = camera:WorldToViewportPoint(target.Position)
			if onScreen or rageModeEnabled then
				local mouse = UserInputService:GetMouseLocation()
				local x = (pos.X - mouse.X) * getgenv().Smoothness
				local y = (pos.Y - mouse.Y) * getgenv().Smoothness
				if mousemoverel then mousemoverel(x, y) end
			end
		end
	end

	if bendEnabled and character then
		pcall(function()
			local multiplier = rageModeEnabled and 12.0 or 3.0
			local t = tick() * (rageModeEnabled and 80 or 25)
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("Motor6D") then
					if part.Name == "Neck" then
						part.C1 = part.C1 * CFrame.Angles(math.sin(t * 1.5) * multiplier, math.cos(t * 2) * multiplier, math.sin(t) * multiplier) + Vector3.new(math.sin(t) * 3, math.cos(t) * 3, math.sin(t*1.5)*2)
					elseif part.Name == "Waist" then
						part.C1 = part.C1 * CFrame.Angles(math.cos(t * 1.3) * multiplier, math.sin(t * 1.8) * multiplier, math.sin(t) * (multiplier * 0.8)) + Vector3.new(0, math.sin(t * 2) * 2.5, 0)
					elseif string.find(part.Name, "Shoulder") or string.find(part.Name, "Hip") then
						part.C1 = part.C1 * CFrame.Angles(math.sin(t * 2.5) * multiplier, math.cos(t * 2) * multiplier, math.sin(t) * 2)
					end
				end
			end
		end)
	end
	
	if takeLEnabled and humanoid and rootPart then
		if danceTrack and not danceTrack.IsPlaying then
			danceTrack:Play()
		end
		if danceTrack and danceTrack.Speed ~= 40 then
			danceTrack:AdjustSpeed(40)
		end
		
		danceTime = danceTime + dt * 60
		local offsetX = math.sin(danceTime) * 3.5
		local offsetZ = math.cos(danceTime * 1.3) * 3.5
		local randomRotation = math.rad(math.random(-180, 180))
		
		local crouchOffset = 0
		if rageModeEnabled then
			crouchOffset = math.abs(math.sin(danceTime * 6)) * -3.0
		end
		humanoid.CameraOffset = Vector3.new(0, crouchOffset, 0)
		
		rootPart.CFrame = rootPart.CFrame + Vector3.new(offsetX, math.sin(danceTime * 4) * 1.0, offsetZ) * CFrame.Angles(0, randomRotation, 0)
	end
end)

function autoClick()
	if autoClickConnection then autoClickConnection:Disconnect() end
	autoClickConnection = RunService.Heartbeat:Connect(function()
		if not silentEnabled and not rageModeEnabled then
			autoClickConnection:Disconnect()
			autoClickConnection = nil
			return
		end
		if isLeftMouseDown or autoShootEnabled or (rageModeEnabled and aiming) then
			if not isLobbyVisible() then
				if mouse1click then mouse1click() end
			end
		else
			autoClickConnection:Disconnect()
			autoClickConnection = nil
		end
	end)
end

RunService.RenderStepped:Connect(function()
	if not _G.EnableSpeed then return end
	local char = localPlayer.Character
	if not char then return end
	local hum = char:FindFirstChild("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.MoveDirection.Magnitude > 0 then
		root.CFrame += hum.MoveDirection * (_G.SpeedPower / 10)
	end
end)

-- GÖKYÜZÜNDEN / ÜSTTEN BIÇAKLAMA & LOOPGOTO (Rage Mode aktifken havada kalıp yukarıdan vurma modu)
RunService.Heartbeat:Connect(function()
	local activeBang = loopGotoEnabled or rageModeEnabled
	if activeBang then
		local currentTarget = loopGotoTarget
		if not currentTarget or not currentTarget.Character or not currentTarget.Character:FindFirstChild("HumanoidRootPart") then
			currentTarget = targetPlayer or getClosestPlayerOffScreen()
			loopGotoTarget = currentTarget
		end

		if currentTarget and currentTarget.Character then
			local targetChar = currentTarget.Character
			local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
			local targetHum = targetChar:FindFirstChild("Humanoid")
			
			if targetHum and targetHum.Health <= 0 then
				loopGotoTarget = nil
				return
			end
			
			local myHRP = rootPart
			local hum = humanoid
			if targetHRP and myHRP and hum then
				if not isLobbyVisible() then
					myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 4.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
					hum.PlatformStand = true
				else
					if hum.PlatformStand then
						hum.PlatformStand = false
					end
				end
			end
		end
	else
		if not loopGotoEnabled and not rageModeEnabled and humanoid and humanoid.PlatformStand then
			humanoid.PlatformStand = false
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if not fixedHeadSpinEnabled or takeLEnabled then return end
	local char = localPlayer.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end
	
	local neck = head:FindFirstChild("Neck")
	if neck then
		if not originalHeadC0 then originalHeadC0 = neck.C0 end
		bodyAngle = (bodyAngle + (rageModeEnabled and 20 or bodySpeed)) % 360
		local rad = math.rad(bodyAngle)
		local offsetX = math.cos(rad) * bodyRadius
		local offsetZ = math.sin(rad) * bodyRadius
		neck.C0 = CFrame.new(offsetX, -2.5, offsetZ) * CFrame.Angles(0, rad, 0)
	end
end)

function toggleFixedHeadSpin(state)
	fixedHeadSpinEnabled = state
	if not state and not takeLEnabled then
		local char = localPlayer.Character
		if char then
			local head = char:FindFirstChild("Head")
			if head then
				local neck = head:FindFirstChild("Neck")
				if neck and originalHeadC0 then
					neck.C0 = originalHeadC0
				end
			end
		end
	end
	updateStatus()
end

function toggleNightMode(state)
	nightModeEnabled = state
	if nightModeEnabled then
		Lighting.Ambient = Color3.fromRGB(20, 20, 35)
		Lighting.OutdoorAmbient = Color3.fromRGB(15, 15, 25)
		Lighting.ClockTime = 0
		Lighting.Brightness = 0.5
	else
		Lighting.Ambient = originalAmbient
		Lighting.OutdoorAmbient = originalOutdoorAmbient
		Lighting.ClockTime = originalClockTime
		Lighting.Brightness = originalBrightness
	end
end

function setNoclip(enabled)
	local char = localPlayer.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not enabled
		end
	end
end

RunService.Stepped:Connect(function()
	if noclipEnabled then setNoclip(true) end
end)

local function clearHighlights()
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			local highlight = player.Character:FindFirstChild("PlayerHighlight")
			if highlight then highlight:Destroy() end
		end
	end
end

local function addHighlight(character)
	if not character or character:FindFirstChild("PlayerHighlight") then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerHighlight"
	highlight.FillColor = FILL_COLOR
	highlight.OutlineColor = OUTLINE_COLOR
	highlight.FillTransparency = FILL_TRANSPARENCY
	highlight.OutlineTransparency = OUTLINE_TRANSPARENCY
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character
end

function rebuildHighlights()
	clearHighlights()
	if not espenabled then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			addHighlight(player.Character)
		end
	end
end

RunService.Heartbeat:Connect(function()
	if not espenabled then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			if not player.Character:FindFirstChild("PlayerHighlight") then
				addHighlight(player.Character)
			end
		end
	end
end)

function DoSilentKillSafe()
	if isTeleporting then return end
	isTeleporting = true
	tpKillEnabled = true
	updateStatus()

	pcall(function()
		local target = nil
		local distMin = math.huge
		for _, v in pairs(Players:GetPlayers()) do
			if v ~= localPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
				local hum = v.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					local distance = (v.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
					if distance < distMin then
						distMin = distance
						target = v
					end
				end
			end
		end

		if target and localPlayer.Character then
			local hrp = rootPart
			local oldPosition = hrp.CFrame
			local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
			local targetHead = target.Character:FindFirstChild("Head")

			if targetHRP then
				hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
				if targetHead then
					camera.CFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)
				end
				task.wait(0.03)
				hrp.CFrame = oldPosition
			end
		end
	end)

	task.wait(0.1)
	tpKillEnabled = false
	isTeleporting = false
	updateStatus()
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		if espenabled then
			task.wait(0.2)
			addHighlight(character)
		end
	end)
end)

UserInputService.InputBegan:Connect(function(input, isProcessed)
	if isProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isLeftMouseDown = true
		if autoShootEnabled and not autoClickConnection then autoClick() end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		if AimbotEnabled or rageModeEnabled then
			aiming = true
			updateStatus()
		end
	elseif input.KeyCode == Enum.KeyCode.G then
		toggleLoopGoto()
	elseif input.KeyCode == Enum.KeyCode.B then
		silentEnabled = not silentEnabled
		if not silentEnabled then
			targetPlayer = nil
			isLeftMouseDown = false
			autoShootEnabled = false
			if autoClickConnection then
				autoClickConnection:Disconnect()
				autoClickConnection = nil
			end
		end
		updateStatus()
	elseif input.KeyCode == Enum.KeyCode.P then
		toggleRageMode()
	elseif input.KeyCode == Enum.KeyCode.X then
		espenabled = not espenabled
		rebuildHighlights()
		updateStatus()
	elseif input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift then
		uiVisible = not uiVisible
		mainFrame.Visible = uiVisible
	end
end)

UserInputService.InputEnded:Connect(function(input, isProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isLeftMouseDown = false
	elseif input.UserInputType == Enum.KeyCode.RightButton or input.UserInputType == Enum.UserInputType.MouseButton2 then
		aiming = false
		if humanoid and not rageModeEnabled and not loopGotoEnabled then humanoid.PlatformStand = false end
		updateStatus()
	end
end)

RunService.Heartbeat:Connect(function()
	if not silentEnabled and not rageModeEnabled then return end
	local SilentAimMode = getClosestPlayerOffScreen()
	if not isLobbyVisible() or rageModeEnabled then
		targetPlayer = SilentAimMode
		if targetPlayer then
			lockCameraToHead()
		end
	end
end)
