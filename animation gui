-- Animation Logic Handlers
local function setupAnim(button, assetId, speed, weight, loopType, isR15)
	local Anim = Instance.new("Animation")
	Anim.AnimationId = "rbxassetid://" .. assetId
	local track = game.Players.LocalPlayer.Character.Humanoid:LoadAnimation(Anim)
	local active = false
	
	button.MouseButton1Click:connect(function()
		active = not active
		local activeColor = isR15 and rloc or loc
		local defaultColor = isR15 and rcol or col
		
		if active then
			button.BackgroundColor3 = activeColor
			if loopType == "loop" then
				task.spawn(function()
					while active do
						if not track.IsPlaying then
							track:Play(.1, 1, speed or 1)
						end
						task.wait()
					end
				end)
			elseif loopType == "fastloop" then
				task.spawn(function()
					while active do
						if not track.IsPlaying then
							track:Play(.5, 1, speed or 1e6)
						end
						task.wait()
					end
				end)
			else
				track:Play(.1, weight or 1, speed or 1)
			end
		else
			track:Stop()
			button.BackgroundColor3 = defaultColor
		end
	end)
end

