-- Helper function to style animation buttons nicely
local function styleButton(btn, text, isR15)
	btn.Parent = isR15 and ScrollingFrameR15 or ScrollingFrame
	btn.BackgroundColor3 = isR15 and Color3.fromRGB(55, 65, 85) or Color3.fromRGB(45, 45, 55)
	btn.BorderColor3 = Color3.fromRGB(70, 70, 85)
	btn.Font = Enum.Font.GothamSemibold
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(230, 230, 230)
	btn.TextSize = 13
	btn.TextWrapped = true
end

