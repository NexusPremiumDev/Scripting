	indicator.Font = Enum.Font.GothamBold
	indicator.TextSize = 12
	indicator.TextXAlignment = Enum.TextXAlignment.Right
	indicator.Parent = row

	row.MouseEnter:Connect(function()
		TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 20, 35)}):Play()
	end)
	row.MouseLeave:Connect(function()
		TweenService:Create(row, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(21, 15, 24)}):Play()
	end)

	if onClickCallback then
