local Players = game:GetService("Players")
local player = Players.LocalPlayer

local ViewModels = player
	:WaitForChild("PlayerScripts")
	:WaitForChild("Assets")
	:WaitForChild("ViewModels")

local Weapons = ViewModels:FindFirstChild("Weapons")

if not Weapons then
	warn("[SkinChanger] Weapons klasörü bulunamadı!")
	return
end

--------------------------------------------------
-- SKIN BULUCU
--------------------------------------------------

local function FindSkin(skinName)

	-- Tam eşleşme
	local direct = ViewModels:FindFirstChild(skinName, true)

	if direct then
		print("[SkinChanger] Skin bulundu:")
		print("İsim:", direct.Name)
		print("Class:", direct.ClassName)
		print("Yol:", direct:GetFullName())

		return direct
	end

	-- Yakın isimleri ara
	local wanted = string.lower(skinName)

	for _, obj in ipairs(ViewModels:GetDescendants()) do
		local objName = string.lower(obj.Name)

		if string.find(objName, wanted, 1, true)
			or string.find(wanted, objName, 1, true) then

			print(
				"[SkinChanger] Benzer skin:",
				obj.Name,
				"| Class:",
				obj.ClassName,
				"| Yol:",
				obj:GetFullName()
			)
		end
	end

	warn("[SkinChanger] Skin bulunamadı:", skinName)

	return nil
end

--------------------------------------------------
-- SKIN UYGULAMA
--------------------------------------------------

local function ApplySkin(weaponName, skinName)

	local weapon = Weapons:FindFirstChild(weaponName)

	if not weapon then
		warn("[SkinChanger] Silah bulunamadı:", weaponName)
		return false
	end

	local skin = FindSkin(skinName)

	if not skin then
		return false
	end

	print("[SkinChanger] Weapon:", weapon:GetFullName())
	print("[SkinChanger] Skin:", skin:GetFullName())

	-- Mevcut içeriği temizle
	for _, child in ipairs(weapon:GetChildren()) do
		child:Destroy()
	end

	local copied = 0

	-- Skin modelini kopyala
	for _, child in ipairs(skin:GetChildren()) do
		local clone = child:Clone()
		clone.Parent = weapon
		copied += 1
	end

	print(
		"[SkinChanger] Uygulandı:",
		weaponName,
		"->",
		skinName,
		"| Obje:",
		copied
	)

	return copied > 0
end

