function playDance(danceName)
	pcall(function()
		if activeDanceTrack then
			pcall(function() activeDanceTrack:Stop() end)
			activeDanceTrack = nil
		end
		
		currentDanceName = danceName
		
		if danceName ~= "OFF" and dances[danceName] and humanoid then
			local anim = Instance.new("Animation")
			anim.AnimationId = dances[danceName]
			
			local success, track = pcall(function()
				return humanoid:LoadAnimation(anim)
			end)
			
			if success and track then
				activeDanceTrack = track
				activeDanceTrack.Looped = true
				activeDanceTrack.Priority = Enum.AnimationPriority.Action4
				activeDanceTrack:Play()
				pcall(function() activeDanceTrack:AdjustSpeed(30) end)
			else
				currentDanceName = "OFF"
			end
		end
	end)
	updateStatus()
end

function toggleLoopGoto()
	loopGotoEnabled = not loopGotoEnabled
	if loopGotoEnabled then
		local playersList = Players:GetPlayers()
		local validTargets = {}
		for _, p in ipairs(playersList) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					table.insert(validTargets, p)
				end
			end
		end
		if #validTargets > 0 then
			loopGotoTarget = validTargets[math.random(1, #validTargets)]
		else
			loopGotoTarget = nil
			loopGotoEnabled = false
		end
	else
		loopGotoTarget = nil
		if humanoid then humanoid.PlatformStand = false end
	end
	updateStatus()
end

