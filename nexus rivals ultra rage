local tabs = {}
local tabButtons = {}
local activeTabName = nil

local function createTab(name)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(1, 0, 0, 36)
	tabBtn.BackgroundColor3 = Color3.fromRGB(24, 16, 26)
	tabBtn.BorderSizePixel = 0
	tabBtn.AutoButtonColor = false
	tabBtn.Text = "    " .. name
	tabBtn.TextColor3 = Color3.fromRGB(170, 140, 160)
	tabBtn.Font = Enum.Font.GothamMedium
	tabBtn.TextSize = 13
	tabBtn.TextXAlignment = Enum.TextXAlignment.Left
	tabBtn.Parent = sidebar
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = tabBtn

	local tabScroll = Instance.new("ScrollingFrame")
	tabScroll.Name = name .. "Scroll"
	tabScroll.Size = UDim2.new(1, 0, 1, 0)
	tabScroll.BackgroundTransparency = 1
	tabScroll.BorderSizePixel = 0
	tabScroll.ScrollBarThickness = 4
	tabScroll.ScrollBarImageColor3 = Color3.fromRGB(255, 45, 85)
	tabScroll.CanvasSize = UDim2.new(0, 0, 0, 650)
	tabScroll.Visible = false
	tabScroll.Parent = containerHolder

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Padding = UDim.new(0, 8)
	tabLayout.Parent = tabScroll

	local tabPadding = Instance.new("UIPadding")
	tabPadding.PaddingTop = UDim.new(0, 12)
	tabPadding.PaddingBottom = UDim.new(0, 12)
	tabPadding.PaddingLeft = UDim.new(0, 12)
	tabPadding.PaddingRight = UDim.new(0, 12)
	tabPadding.Parent = tabScroll

	local function switchTab()
		for _, t in pairs(tabs) do t.Visible = false end
		for _, b in pairs(tabButtons) do 
			TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(24, 16, 26)}):Play()
			b.TextColor3 = Color3.fromRGB(170, 140, 160)
		end
		tabScroll.Visible = true
		TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 45, 85)}):Play()
		tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end

	tabBtn.MouseButton1Click:Connect(switchTab)
	tabBtn.TouchTap:Connect(switchTab)

	tabs[name] = tabScroll
	tabButtons[name] = tabBtn

	if not activeTabName then
		activeTabName = name
		tabScroll.Visible = true
		tabBtn.BackgroundColor3 = Color3.fromRGB(255, 45, 85)
		tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end

	return tabScroll
end

