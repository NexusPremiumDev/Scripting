-- Aktif animasyon takibini tutmak için tablo
local activeTracks = {}

local function PlayLoopAnimation(btn, animId)
	local char = LocalPlayer.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Eğer bu buton zaten çalışıyorsa durdur
	if activeTracks[btn] then
		activeTracks[btn].active = false
		if activeTracks[btn].track then
			activeTracks[btn].track:Stop()
		end
		activeTracks[btn] = nil
		btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		return
	end
	
	-- Diğer aktifleri durdur (isteğe bağlı, tek seferde tek animasyon için)
	for b, data in pairs(activeTracks) do
		data.active = false
		if data.track then data.track:Stop() end
		b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		activeTracks[b] = nil
	end
	
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(animId)
	
	local success, track = pcall(function()
		return humanoid:LoadAnimation(anim)
	end)
	
	if success and track then
		local state = {active = true, track = track}
		activeTracks[btn] = state
		btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
		
		task.spawn(function()
			track:Play(.1, 1, 1)
			while state.active and task.wait() do
				if not track.IsPlaying and state.active then
					pcall(function()
						track:Play(.1, 1, 1)
					end)
				end
			end
		end)
	end
end

