local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local ANIMATION_ID = "rbxassetid://123955307291627"
local active = false
local track = nil

local function stopAnimation()
	active = false

	if track then
		pcall(function()
			track:Stop()
			track:Destroy()
		end)
		track = nil
	end
end

local function startAnimation()
	if active then
		return
	end

	local character = LocalPlayer.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = ANIMATION_ID

	local success, result = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	if not success or not result then
		warn("[Nexus] Spider-Man animasyonu yüklenemedi.")
		animation:Destroy()
		return
	end

	track = result
	active = true

	track.Looped = true
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.1, 1, 1)

	animation:Destroy()

	print("[Nexus] Spider-Man Dance: ON")
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.P then
		if active then
			stopAnimation()
			print("[Nexus] Spider-Man Dance: OFF")
		else
			startAnimation()
		end
	end
end)

-- Yeni round / respawn olduğunda otomatik kapat
LocalPlayer.CharacterAdded:Connect(function()
	stopAnimation()
end)

-- Script çalıştırıldığında başlangıçta kapalı
stopAnimation()
