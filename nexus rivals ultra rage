	label.Size = UDim2.new(1, -75, 1, 0)
	label.Position = UDim2.new(0, 14, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(220, 200, 210)
	label.Font = Enum.Font.GothamMedium
