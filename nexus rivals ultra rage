function toggleLoopGoto()
	loopGotoEnabled = not loopGotoEnabled
	if loopGotoEnabled then
		local playersList = Players:GetPlayers()
		local validTargets = {}
		for _, p in ipairs(playersList) do
			if p ~= localPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then
					table.insert(validTargets, p)
				end
			end
		end
		if #validTargets > 0 then
			loopGotoTarget = validTargets[math.random(1, #validTargets)]
		else
			loopGotoTarget = nil
			loopGotoEnabled = false
		end
	else
		loopGotoTarget = nil
		if humanoid then humanoid.PlatformStand = false end
	end
	updateStatus()
end

function toggleRageMode()
	rageModeEnabled = not rageModeEnabled
	if rageModeEnabled then
		silentEnabled = true
		AimbotEnabled = true
		getgenv().Smoothness = 0.05
		spinBotEnabled = true
		_G.EnableSpeed = true
		toggleFixedHeadSpin(true)
		if not takeLEnabled then toggleTakeL() end
	else
		getgenv().Smoothness = 0.35
		spinBotEnabled = false
		_G.EnableSpeed = false
		toggleFixedHeadSpin(false)
		if takeLEnabled then toggleTakeL() end
		if humanoid then humanoid.CameraOffset = Vector3.new(0, 0, 0) end
		if humanoid then humanoid.PlatformStand = false end
	end
	updateStatus()
end

