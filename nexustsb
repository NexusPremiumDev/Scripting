	local function applyAnimation(button, assetId, speedMultiplier, loopMode)
		local char = LocalPlayer.Character
		if not char or not char:FindFirstChildOfClass("Humanoid") then return end
		
		local Anim = Instance.new("Animation")
		Anim.AnimationId = "rbxassetid://" .. assetId
		local track = char:FindFirstChildOfClass("Humanoid"):LoadAnimation(Anim)
		local active = false
		
		button.MouseButton1Click:Connect(function()
			active = not active
			if active then
				button.BackgroundColor3 = button.Parent == ScrollingFrameR15 and rloc or loc
				if loopMode == "loop_fast" then
					task.spawn(function()
						while active do
							if not track.IsPlaying then
								track:Play(.1, 1, speedMultiplier)
							end
							task.wait()
						end
					end)
				elseif loopMode == "loop_normal" then
					task.spawn(function()
						while active do
							if not track.IsPlaying then
								track:Play(.1, 1, 1)
							end
							task.wait()
						end
					end)
				else
					track:Play(.1, 1, speedMultiplier or 1)
				end
			else
				track:Stop()
				button.BackgroundColor3 = button.Parent == ScrollingFrameR15 and rcol or col
			end
		end)
	end

