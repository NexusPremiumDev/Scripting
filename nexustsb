	keyButton.Text = "  PRESS KEY..."
	keyButton.BackgroundColor3 = Color3.fromRGB(55, 42, 60)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if waitingForKey then
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if input.KeyCode == Enum.KeyCode.Escape then
			waitingForKey = false
			if flyKey then
				keyButton.Text = "  KEYBIND • " .. flyKey.Name
				status.Text = "Fly key: " .. flyKey.Name
			else
				keyButton.Text = "  KEYBIND • NONE"
				status.Text = "Fly key: NONE"
			end
			keyButton.BackgroundColor3 = Color3.fromRGB(16, 18, 26)
			return
		end
		flyKey = input.KeyCode
		waitingForKey = false
		keyButton.Text = "  KEYBIND • " .. flyKey.Name
		keyButton.BackgroundColor3 = Color3.fromRGB(43, 78, 65)
		status.Text = "Fly key: " .. flyKey.Name
		return
	end

	if gameProcessed then return end

	if flyKey and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == flyKey then
		if flying then disableFly() else enableFly() end
	end
end)

