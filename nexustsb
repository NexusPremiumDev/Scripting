local function logToTerminal(text)
	terminalBox.Text = terminalBox.Text .. "\n> " .. text
end

runScriptBtn.MouseButton1Click:Connect(function()
	local code = scriptInput.Text
	if code == "" then
		logToTerminal("Error: Script box is empty!")
		return
	end
	
	logToTerminal("Executing script...")
	
	local func, err = loadstring(code)
	if func then
		local success, runtimeErr = pcall(func)
		if success then
			logToTerminal("Script executed successfully!")
		else
			logToTerminal("Runtime Error: " .. tostring(runtimeErr))
		end
	else
		logToTerminal("Compile Error: " .. tostring(err))
	end
end)

clearTermBtn.MouseButton1Click:Connect(function()
	terminalBox.Text = "> Console cleared."
end)

