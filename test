    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(26, 30, 42)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = meta.color, Transparency = 0.05}):Play()
        TweenService:Create(icon, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(36, 41, 56)}):Play()
