Search:GetPropertyChangedSignal("Text"):Connect(function()
    local q = string.lower(Search.Text or "")
    local visible = 0
    for _, card in ipairs(moduleCards) do
        local title = string.lower(card.Name)
        local show = q == "" or string.find(title, q, 1, true) ~= nil
        card.Visible = show
        if show then visible = visible + 1 end
    end
    Empty.Visible = visible == 0
end)

