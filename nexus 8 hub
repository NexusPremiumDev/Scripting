local function bl(hn, hc)
	if not hn or not hc then return end
	pcall(function()
		local oldPivot = nil
		pcall(function() oldPivot = hn:GetPivot() end)

		-- Full model clone is more reliable for multi-part melee (knives)
		-- than child-by-child copy (avoids missing halves / lost welds)
		local template = hc:Clone()
		if not template then return end

		-- Clear target
		hn:ClearAllChildren()

		-- Move children from template into hn (keeps Motor6D / welds under those parts)
		for _, item in ipairs(template:GetChildren()) do
			item.Parent = hn
		end
		template:Destroy()

		-- PrimaryPart fix (stops "Primary is not a valid member")
		pcall(function()
			local prim = hn:FindFirstChild("Primary", true)
				or hn:FindFirstChild("Handle", true)
				or hn:FindFirstChildWhichIsA("BasePart", true)
			if prim and prim:IsA("BasePart") then
				hn.PrimaryPart = prim
			end
			for _, ch in ipairs(hn:GetDescendants()) do
				if ch:IsA("Model") and not ch.PrimaryPart then
					local p = ch:FindFirstChild("Primary", true)
						or ch:FindFirstChild("Handle", true)
						or ch:FindFirstChildWhichIsA("BasePart", true)
					if p and p:IsA("BasePart") then
						ch.PrimaryPart = p
					end
				end
			end
		end)

		-- Ensure visible (some skins ship with Transparency=1 on extras)
		pcall(function()
			for _, p in ipairs(hn:GetDescendants()) do
				if p:IsA("BasePart") then
					-- do not force all to 0 (scopes/sights may be intentional)
					if p.Transparency >= 1 and (p.Name == "Primary" or p.Name == "Handle" or p.Name:lower():find("blade") or p.Name:lower():find("knife")) then
						p.Transparency = 0
					end
					p.LocalTransparencyModifier = 0
				elseif p:IsA("MeshPart") then
					p.LocalTransparencyModifier = 0
				end
			end
		end)

		nexusHideBlockParts(hn)
		if oldPivot then pcall(function() hn:PivotTo(oldPivot) end) end
	end)
end

local function gb(hn, bq, gp)
	local bo = q:FindFirstChild(bq)
	if not bo or not hn then return end
	pcall(function()
		hn:ClearAllChildren()
		for _, item in ipairs(bo:GetChildren()) do
			local ok, cf = pcall(function() return item:Clone() end)
			if ok and cf then pcall(function() cf.Parent = hn end) end
		end
		pcall(function()
			local prim = hn:FindFirstChild("Primary", true)
				or hn:FindFirstChild("Handle", true)
				or hn:FindFirstChildWhichIsA("BasePart", true)
			if prim and prim:IsA("BasePart") then hn.PrimaryPart = prim end
		end)
		if gp then pcall(function() hn:PivotTo(gp) end) end
	end)
end



nexusHideBlockParts = function(model)
	if not model then return end
	pcall(function()
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") then
				local n = string.lower(p.Name)
				local hasSpecial = p:FindFirstChildOfClass("SpecialMesh") or p:FindFirstChildOfClass("BlockMesh") or p:FindFirstChildOfClass("CylinderMesh")
				local isMeshPart = p:IsA("MeshPart")
				local meshOk = isMeshPart and p.MeshId ~= nil and p.MeshId ~= "" and p.MeshId ~= "rbxassetid://0"
				local looksHitbox = n:find("hitbox") or n:find("collide") or n:find("hurt")
					or n:find("damage") or n == "part" or n == "block" or n == "cube"
					or n:find("bladebox") or n:find("proxy")
				local size = p.Size
				local isBlocky = (not isMeshPart and not hasSpecial) or (isMeshPart and not meshOk)
				-- white/grey default material blocks at tip
				if looksHitbox or isBlocky then
					-- keep Primary/Handle if it has a real mesh
					if meshOk and (n == "primary" or n == "handle" or n:find("blade") or n:find("knife") or n:find("weapon")) then
						-- keep visible
					else
						if isBlocky or looksHitbox then
							p.Transparency = 1
							p.LocalTransparencyModifier = 1
							p.CanCollide = false
							p.CastShadow = false
						end
					end
				end
				if isMeshPart and not meshOk then
					p.Transparency = 1
					p.LocalTransparencyModifier = 1
				end
			end
		end
	end)
end

nexusFixPrimary = function(model)
	if not model then return end
	pcall(function()
		if model:IsA("Model") then
			local prim = model.PrimaryPart
				or model:FindFirstChild("Primary", true)
				or model:FindFirstChild("Handle", true)
				or model:FindFirstChildWhichIsA("BasePart", true)
			if prim and prim:IsA("BasePart") then
				model.PrimaryPart = prim
			end
			for _, ch in ipairs(model:GetDescendants()) do
				if ch:IsA("Model") and not ch.PrimaryPart then
					local p = ch:FindFirstChild("Primary", true)
						or ch:FindFirstChild("Handle", true)
						or ch:FindFirstChildWhichIsA("BasePart", true)
					if p and p:IsA("BasePart") then ch.PrimaryPart = p end
				end
			end
		end
	end)
end

