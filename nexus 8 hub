-- Clean previous instances
pcall(function()
    for _, name in ipairs({"NexusPremium", "NexusMM2MiniDock"}) do
        local old = CoreGui:FindFirstChild(name)
        if old then old:Destroy() end
        if gethui then
            local o = gethui():FindFirstChild(name)
            if o then o:Destroy() end
        end
        local pg = Player:FindFirstChild("PlayerGui")
        if pg and pg:FindFirstChild(name) then pg[name]:Destroy() end
    end
end)

local function tw(obj, t, props, style, dir)
    return TweenService:Create(obj, TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
end

local function parentMM2Gui(gui)
    local ok = pcall(function()
        if gethui then gui.Parent = gethui()
        else gui.Parent = CoreGui end
    end)
    if not ok or not gui.Parent then gui.Parent = Player:WaitForChild("PlayerGui") end
end

