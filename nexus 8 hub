local function setTab(tab)
    activeTab = tab
    activeButtons = tab == "GAME" and buttons or utilityButtons
    activeSources = tab == "GAME" and SOURCES or UTILITY_SOURCES
    for _,b in ipairs(buttons) do b.Visible = tab=="GAME" end
    for _,b in ipairs(utilityButtons) do b.Visible = tab=="UTILITY" end
    GameTab.BackgroundColor3 = tab=="GAME" and Color3.fromRGB(60,40,110) or Color3.fromRGB(24,18,42)
    GameTab.TextColor3 = tab=="GAME" and PALETTE.text or PALETTE.muted
    UtilityTab.BackgroundColor3 = tab=="UTILITY" and Color3.fromRGB(30,55,70) or Color3.fromRGB(24,18,42)
    UtilityTab.TextColor3 = tab=="UTILITY" and Color3.fromRGB(200,255,250) or PALETTE.muted
    Search.Text = ""
    Body.CanvasPosition = Vector2.zero
    Footer.Text = tab=="GAME" and "NEXUS GALAXY  •  SELECT A MODULE TO ENTER ORBIT" or "NEXUS GALAXY  •  UTILITY SECTOR"
    setStatus("●  ORBIT READY", PALETTE.mint)
end

local function launch(index)
    if launching then return end
    local source = activeSources[index]
    if type(source) ~= "string" or #source < 5 then
        setStatus("●  MISSING", PALETTE.rose)
        warn("[Nexus Galaxy] empty module "..tostring(index))
        return
    end
    launching = true
    setStatus("●  LAUNCHING", PALETTE.cyan)
    showModuleIntro(index)
    pcall(function() Nexus.Enabled = false end)
    task.delay(1.35, function()
        pcall(function() if Nexus then Nexus:Destroy() end end)
        local fn, err = loadstring(source)
        if not fn then warn("[Nexus Galaxy] compile: "..tostring(err)) return end
        local ok, err2 = pcall(fn)
        if not ok then warn("[Nexus Galaxy] runtime: "..tostring(err2)) end
    end)
end

