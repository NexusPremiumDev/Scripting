    for _, o in ipairs(orbitDots) do
        local a = t * o.speed + o.phase
        local x = math.cos(a) * o.radius
        local y = math.sin(a) * o.radius
        o.dot.Position = UDim2.new(0.5, x, 0.5, y)
    end
    coreGrad.Rotation = (t * 40) % 360
    lcGrad.Rotation = (t * 25) % 360
