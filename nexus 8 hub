local SPINNING_BODY_PARTS_SPEED = 1
local spinningBodyPartsTrack = nil
local spinningBodyPartsConnection = nil
local spinningBodyPartsToken = 0

local function stopSpinningBodyParts()
	spinningBodyPartsToken = spinningBodyPartsToken + 1
	if spinningBodyPartsConnection then
		pcall(function() spinningBodyPartsConnection:Disconnect() end)
		spinningBodyPartsConnection = nil
	end
	if spinningBodyPartsTrack then
		pcall(function() spinningBodyPartsTrack:Stop(0.1) end)
		spinningBodyPartsTrack = nil
	end
	if currentDanceName == "Spinning Body Parts" then
		currentDanceName = "OFF"
	end
end

local function getSpinningBodyPartsTrack(animator)
	if not animator then return nil end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		local animation = track.Animation
		if animation and string.find(tostring(animation.AnimationId), tostring(SPINNING_BODY_PARTS_ID), 1, true) then
			return track
		end
	end
	return nil
end

local function playSpinningBodyParts()
	local hum = humanoid
	if not hum or not hum.Parent or hum.Health <= 0 then return false end

	stopSpinningBodyParts()
	if activeDanceTrack then
		pcall(function() activeDanceTrack:Stop(0.1) end)
		activeDanceTrack = nil
	end

	local description = hum:FindFirstChildOfClass("HumanoidDescription") or hum:FindFirstChild("HumanoidDescription")
	if not description then return false end

	pcall(function()
		description:AddEmote(SPINNING_BODY_PARTS_NAME, SPINNING_BODY_PARTS_ID)
	end)

	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local capturedTrack = nil
	local captureConnection = animator.AnimationPlayed:Connect(function(track)
		local animation = track.Animation
		if animation and string.find(tostring(animation.AnimationId), tostring(SPINNING_BODY_PARTS_ID), 1, true) then
			capturedTrack = track
		end
	end)

	local ok = pcall(function()
		hum:PlayEmote(SPINNING_BODY_PARTS_NAME)
	end)

	task.wait(0.15)
	pcall(function() captureConnection:Disconnect() end)

	local track = capturedTrack or getSpinningBodyPartsTrack(animator)
	if not track then
		return ok == true and getSpinningBodyPartsTrack(animator) ~= nil
	end

	spinningBodyPartsTrack = track
	currentDanceName = "Spinning Body Parts"
	spinningBodyPartsToken = spinningBodyPartsToken + 1
	local myToken = spinningBodyPartsToken

	-- Keep the UGC emote native, but make it resilient to movement/Animate interruptions.
	pcall(function()
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		track:AdjustSpeed(SPINNING_BODY_PARTS_SPEED)
	end)

	spinningBodyPartsConnection = track.Stopped:Connect(function()
		if myToken ~= spinningBodyPartsToken then return end
		-- Do not immediately mark OFF: movement can legitimately interrupt an emote.
		spinningBodyPartsTrack = nil
	end)

	-- Movement-safe recovery: monitor continuously, not only in Rage Mode.
	task.spawn(function()
		while myToken == spinningBodyPartsToken and hum.Parent and hum.Health > 0 and currentDanceName == "Spinning Body Parts" do
			local current = spinningBodyPartsTrack
			if not current or not current.IsPlaying then
				if myToken ~= spinningBodyPartsToken then break end
				pcall(function() hum:PlayEmote(SPINNING_BODY_PARTS_NAME) end)
				task.wait(0.08)
				local freshTrack = getSpinningBodyPartsTrack(animator)
				if freshTrack then
					spinningBodyPartsTrack = freshTrack
					pcall(function()
						freshTrack.Priority = Enum.AnimationPriority.Action4
						freshTrack.Looped = true
						freshTrack:AdjustSpeed(SPINNING_BODY_PARTS_SPEED)
					end)
				end
			end
			task.wait(0.08)
		end
	end)

	updateStatus()
	return true
end

