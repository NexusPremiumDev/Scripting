        function KeyPicker:Display(PickerText)
            if Library.Unloaded then
                return
            end

            local DisplayStr = PickerText or KeyPicker.DisplayValue
            if DisplayStr == "None" then DisplayStr = "..." end

            local X, Y = Library:GetTextBounds(
                DisplayStr,
                Picker.FontFace,
