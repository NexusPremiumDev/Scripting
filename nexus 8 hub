local lastFpsTick = 0
RunService.RenderStepped:Connect(function(dt)
	if fpsDisplayEnabled then
		if tick() - lastFpsTick > 0.35 then
			lastFpsTick = tick()
			pcall(function()
				local fps = math.floor(1 / dt)
				local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
				fpsGui.Text = "FPS: " .. tostring(fps) .. " | Ping: " .. tostring(ping) .. "ms"
			end)
		end
	end

	if customFovEnabled then
		Camera.FieldOfView = customFovValue
	end

	if screenShakeEnabled then
		local shake = Vector3.new(math.random(-50, 50) * 0.005, math.random(-50, 50) * 0.005, math.random(-50, 50) * 0.005)
		Camera.CFrame = Camera.CFrame * CFrame.new(shake)
	end

	-- Persistent, steady Sky Camp: hold altitude without repeatedly teleporting/bouncing.
	if skyCampEnabled and not skyCampSuspended then
		local char = k.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp then
			if not skyCampPosition or skyCampPosition.Parent ~= hrp then
				toggleSkyCamp(true)
			end
			if skyCampPosition then
				skyCampPosition.Position = Vector3.new(hrp.Position.X, SKY_CAMP_ALTITUDE, hrp.Position.Z)
			end
			if hrp.Position.Y < SKY_CAMP_ALTITUDE - 80 then hrp.CFrame = CFrame.new(hrp.Position.X, SKY_CAMP_ALTITUDE, hrp.Position.Z) end
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		if hum then hum.PlatformStand = false; hum.AutoRotate = true end
	end

	if hitboxEnabled then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= k and isPlayerAlive(p) then
				local hrp = p.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					hrp.Size = hitboxSize
					hrp.Transparency = 0.7
					hrp.CanCollide = false
				end
			end
		end
	end

	if aimbotEnabled then
		local mousePos = UserInputService:GetMouseLocation()
		fovCircle.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
	end
	if aimbotEnabled and isAimingKeyHeld then
		local target = getClosestTargetInFov()
		if target and target.Character then
			local part = getTargetPart(target.Character, aimbonePart)
			if part then
				local tPos = part.Position
				if predictionEnabled then
					local hrp = target.Character:FindFirstChild("HumanoidRootPart")
					if hrp then tPos = tPos + (hrp.Velocity * 0.12) end
				end
				local smoothness = math.clamp(getgenv().Smoothness or 65, 1, 100)
				local alpha = math.clamp((101 - smoothness) * 0.03, 0.05, 1)
				Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, tPos), alpha)
			end
		end
	end

	if spinBotEnabled and RootPart then
		RootPart.CFrame = RootPart.CFrame * CFrame.Angles(0, math.rad(spinSpeed * dt), 0)
	end

	if _G.EnableSpeed and not skyCampEnabled then
		local char = k.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hum and hrp and hum.MoveDirection.Magnitude > 0 then
			hrp.CFrame = hrp.CFrame + (hum.MoveDirection * ((_G.SpeedPower or 6) / 10))
		end
	end
end)

RunService.Heartbeat:Connect(function()
	if triggerBotEnabled then
		pcall(function()
			local mouseRay = Camera:ViewportPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {k.Character}
			local result = Workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000, params)
			if result and result.Instance and result.Instance.Parent then
				local hitPlr = Players:GetPlayerFromCharacter(result.Instance.Parent)
				if hitPlr and hitPlr ~= k and isPlayerAlive(hitPlr) then
					if mouse1click then mouse1click() end
				end
			end
		end)
	end

	if autoShootEnabled and isAimingKeyHeld and (os.clock() - lastAutoShotAt) >= 0.12 then
		lastAutoShotAt = os.clock()
		pcall(function()
			if mouse1click then mouse1click() end
		end)
	end

	if isAimingKeyHeld and rageModeEnabled and loopGotoEnabled then -- hold scope/RMB: LoopGoto
		if not loopGotoTarget or not loopGotoTarget.Character or not isPlayerAlive(loopGotoTarget) then
			loopGotoTarget = nil
			local myRoot = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			local bestDistance = math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= k and isPlayerAlive(p) then
					local targetRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					if targetRoot and myRoot then
						local distance = (targetRoot.Position - myRoot.Position).Magnitude
						if distance < bestDistance then bestDistance = distance; loopGotoTarget = p end
					end
				end
			end
		end
		if loopGotoTarget and loopGotoTarget.Character then
			local targetHRP = loopGotoTarget.Character:FindFirstChild("HumanoidRootPart")
			local myHRP = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			local hum = k.Character and k.Character:FindFirstChildOfClass("Humanoid")
			if targetHRP and myHRP and hum then
				-- Remove the sky controller while visiting the target so controllers do not fight.
				if skyCampPosition then skyCampPosition:Destroy(); skyCampPosition = nil end
				hum.PlatformStand = false
				myHRP.CFrame = targetHRP.CFrame * CFrame.new(math.sin(tick() * 15) * 2, 3, math.cos(tick() * 15) * 2)
			end
		end
	end
end)

RunService.Stepped:Connect(function()
	if noclipEnabled then setNoclip(true) end
end)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if silentEnabled then
			fireSilentAim()
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAimingKeyHeld = true
		if rageModeEnabled and skyCampEnabled then
			local hrp = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				scopeSkyReturnCFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(hrp.Orientation.Y), 0)
				scopeSkyReturnPending = true
			end
			-- Suspend Sky Camp while LoopGoto visits the target; otherwise its
			-- RenderStepped controller fights the target teleport and can kill the player.
			skyCampSuspended = true
			if skyCampPosition then skyCampPosition:Destroy(); skyCampPosition = nil end
		end
	elseif input.KeyCode == Enum.KeyCode.B then
		silentEnabled = not silentEnabled
		pcall(function()
			if _G.SilentAim and _G.SilentAim.Toggle then _G.SilentAim.Toggle(silentEnabled) end
		end)
		-- Synchronize the actual UI control as well as the feature state.
		pcall(function()
			local bags = {}
			if type(Toggles) == "table" then table.insert(bags, Toggles) end
			if Library and type(Library.Toggles) == "table" then table.insert(bags, Library.Toggles) end
			for _, bag in ipairs(bags) do
				local t = bag["SilentAim"]
				if t then
					if t.SetValue then pcall(function() t:SetValue(silentEnabled) end) end
					pcall(function() t.Value = silentEnabled end)
				end
			end
		end)
		print("[Ultra Rage] Silent Aim:", silentEnabled and "ON" or "OFF")
	elseif input.KeyCode == Enum.KeyCode.P then
		toggleRageMode()
	elseif input.KeyCode == Enum.KeyCode.X then
		ESP_CONFIG.Enabled = not ESP_CONFIG.Enabled
		if Toggles and Toggles["EspRainbow"] then
			pcall(function() Toggles["EspRainbow"]:SetValue(ESP_CONFIG.Enabled) end)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isAimingKeyHeld = false
		if scopeSkyReturnPending and rageModeEnabled then
			local hrp = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			local hum = k.Character and k.Character:FindFirstChildOfClass("Humanoid")
			if hrp and scopeSkyReturnCFrame then hrp.CFrame = scopeSkyReturnCFrame end
			if hum then hum.PlatformStand = false; hum.AutoRotate = true end
			scopeSkyReturnPending = false
			scopeSkyReturnCFrame = nil
			skyCampSuspended = false
			task.defer(function() if rageModeEnabled then toggleSkyCamp(true) end end)
		elseif not skyCampEnabled and not loopGotoEnabled then
			local hum = k.Character and k.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.PlatformStand = false end
		end
	end
end)

local function unexecuteScript()
	pcall(function()
		if overlayGui then overlayGui:Destroy() end
		if musicSound then musicSound:Stop(); musicSound:Destroy() end
		ESP_CONFIG.Enabled = false
		for _, v in pairs(EspPlayerEntries) do removeEspVisual(v) end
		if modernSkyInstance then modernSkyInstance:Destroy() end
		if modernAtmosphereInstance then modernAtmosphereInstance:Destroy() end
		if Library and Library.Unload then Library:Unload() end
	end)
end

