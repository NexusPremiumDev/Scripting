-- Working Brookhaven RP remotes:
-- RE["1RPNam1eColo1r"] -> FireServer("PickingRPNameColor", Color3) / "PickingRPBioColor"
-- RE["1RPNam1eTex1t"]  -> FireServer("RolePlayName"/"RolePlayBio", text)

local rainbowNameOn = false
local rainbowBioOn = false
local rainbowNameTask = nil
local rainbowBioTask = nil
local rainbowHue = 0

local function nexusRainbowColor()
    rainbowHue = (rainbowHue + 0.035) % 1
    return Color3.fromHSV(rainbowHue, 1, 1)
end

local function getRPColorRemote()
    local RE = game:GetService("ReplicatedStorage"):FindFirstChild("RE")
    if not RE then return nil end
    return RE:FindFirstChild("1RPNam1eColo1r")
        or RE:FindFirstChild("1RPNameColor")
        or RE:FindFirstChild("RPNameColor")
end

local function fireNameColor(c)
    local remote = getRPColorRemote()
    if remote then
        pcall(function() remote:FireServer("PickingRPNameColor", c) end)
        pcall(function() remote:FireServer({[1]="PickingRPNameColor",[2]=c}) end)
        pcall(function()
            local args = {[1] = "PickingRPNameColor", [2] = c}
            remote:FireServer(unpack(args))
        end)
    end
    -- local billboard fallback
    pcall(function()
        local char = game:GetService("Players").LocalPlayer.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end
        for _, d in ipairs(head:GetDescendants()) do
            if d:IsA("TextLabel") then
                local n = d.Name:lower()
                if n:find("name") or n:find("title") or n == "label" then
                    d.TextColor3 = c
                end
            end
        end
    end)
end

local function fireBioColor(c)
    local remote = getRPColorRemote()
    if remote then
        pcall(function() remote:FireServer("PickingRPBioColor", c) end)
        pcall(function()
            local args = {[1] = "PickingRPBioColor", [2] = c}
            remote:FireServer(unpack(args))
        end)
        -- some builds use same remote with Bio key
        pcall(function()
            local args = {[1] = "PickingRPNameColor", [2] = c, [3] = "Bio"}
            remote:FireServer(unpack(args))
        end)
    end
    pcall(function()
        local char = game:GetService("Players").LocalPlayer.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end
        for _, d in ipairs(head:GetDescendants()) do
            if d:IsA("TextLabel") then
                local n = d.Name:lower()
                if n:find("bio") or n:find("desc") or n:find("about") then
                    d.TextColor3 = c
                end
            end
        end
    end)
end

local function setRainbowName(state)
    rainbowNameOn = state and true or false
    if rainbowNameTask then
        pcall(function() task.cancel(rainbowNameTask) end)
        rainbowNameTask = nil
    end
    if not rainbowNameOn then return end
    rainbowNameTask = task.spawn(function()
        while rainbowNameOn do
            local c = nexusRainbowColor()
            fireNameColor(c)
            task.wait(0.12)
        end
    end)
end

local function setRainbowBio(state)
    rainbowBioOn = state and true or false
    if rainbowBioTask then
