local function launchSource(index)
    if launching then return end
    local source = SOURCES[index]
    if type(source) ~= "string" or #source < 20 then
        setStatus("●  MISSING MODULE " .. tostring(index), PALETTE.rose)
        warn("[Nexus] empty module " .. tostring(index))
        return
    end
    launching = true
    setStatus("●  INITIALIZING MODULE " .. tostring(index), PALETTE.purple)
    pcall(function() Nexus.Enabled = false end)
    task.delay(0.35, function()
        pcall(function() if Nexus then Nexus:Destroy() end end)
        local fn, err = loadstring(source)
        if not fn then
            warn("[Nexus] compile error: " .. tostring(err))
            return
        end
        local ok, err2 = pcall(fn)
        if not ok then
            warn("[Nexus] runtime error: " .. tostring(err2))
        end
    end)
end

local currentTab = "GAMES"

local function rebuildCards()
    clearCards()
    local q = string.lower(SearchBox and SearchBox.Text or "")
    local order = 0
    local function match(name, sub)
        if q == "" then return true end
        return string.find(string.lower(name), q, 1, true) or string.find(string.lower(sub), q, 1, true)
    end

    if currentTab == "GAMES" or currentTab == "ALL" then
        for _, m in ipairs(ModuleCards) do
            if match(m.name, m.sub) then
                order = order + 1
                local idx = m.src
                makeCard(order, m.name, m.sub, m.color, function()
                    launchSource(idx)
                end)
            end
        end
    end
    if currentTab == "UTILITIES" or currentTab == "UNIVERSAL" or currentTab == "ALL" then
        for _, m in ipairs(UtilityCards) do
            local show = true
            if currentTab == "UNIVERSAL" then
                show = string.find(m.name, "UNIVERSAL") ~= nil
            end
            if show and match(m.name, m.sub) then
                order = order + 1
                makeCard(order, m.name, m.sub, m.color, function()
                    setStatus("●  LOADED " .. m.name, PALETTE.emerald)
                    pcall(m.run)
                end)
            end
        end
    end
    if EmptyNotice then
        EmptyNotice.Visible = (order == 0)
    end
end

