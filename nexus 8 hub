}

local function getEspAnchor(char)
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Head")
		or char:FindFirstChildWhichIsA("BasePart")
end

local function rainbowEspColor()
	return Color3.fromHSV((tick() * 0.35) % 1, 1, 1)
end

local BonePairs = {
	{ "Head", "Torso" }, { "Head", "UpperTorso" },
	{ "Torso", "Left Arm" }, { "Torso", "Right Arm" },
	{ "Torso", "Left Leg" }, { "Torso", "Right Leg" },
	{ "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}
local BoneCount = #BonePairs

local EspPlayerEntries = {}

local function createEspVisual()
	if not Drawing or type(Drawing.new) ~= "function" then return nil end
	local ok, v = pcall(function()
		local entry = {
			Box           = Drawing.new("Square"),
			Name          = Drawing.new("Text"),
			Dist          = Drawing.new("Text"),
			HpBg          = Drawing.new("Square"),
			HpFill        = Drawing.new("Square"),
			SkeletonLines = {},
		}
		entry.Name.Center       = true
		entry.Name.Size         = ESP_CONFIG.TextSize
		entry.Name.Font         = 2
		entry.Name.Outline      = true
		entry.Name.OutlineColor = Color3.new(0, 0, 0)

		entry.Dist.Center       = true
		entry.Dist.Size         = ESP_CONFIG.TextSize - 2
		entry.Dist.Font         = 2
		entry.Dist.Outline      = true
		entry.Dist.OutlineColor = Color3.new(0, 0, 0)

		entry.HpBg.Filled   = true
		entry.HpFill.Filled = true

		for i = 1, BoneCount do
			local ln = Drawing.new("Line")
			ln.Thickness    = 1
			ln.Transparency = 1
			ln.Visible      = false
			entry.SkeletonLines[i] = ln
		end
		return entry
	end)
	return ok and v or nil
end

local function removeEspVisual(v)
	if not v then return end
	pcall(function()
		if v.Box then v.Box:Remove() end
		if v.Name then v.Name:Remove() end
		if v.Dist then v.Dist:Remove() end
		if v.HpBg then v.HpBg:Remove() end
		if v.HpFill then v.HpFill:Remove() end
		if v.SkeletonLines then
			for _, ln in ipairs(v.SkeletonLines) do pcall(function() ln:Remove() end) end
		end
	end)
end

local function hideEspVisual(v)
	if not v then return end
	pcall(function()
		if v.Box then v.Box.Visible = false end
		if v.Name then v.Name.Visible = false end
		if v.Dist then v.Dist.Visible = false end
		if v.HpBg then v.HpBg.Visible = false end
		if v.HpFill then v.HpFill.Visible = false end
		if v.SkeletonLines then
			for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end
		end
	end)
end

RunService.RenderStepped:Connect(function()
	if not ESP_CONFIG.Enabled then
		for _, v in pairs(EspPlayerEntries) do
			hideEspVisual(v)
		end
		return
	end

	pcall(function()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= k then
				if not EspPlayerEntries[p] then
					EspPlayerEntries[p] = createEspVisual()
				end
				local v = EspPlayerEntries[p]
				if v and isPlayerAlive(p) and p.Character then
					local char = p.Character
					local root = getEspAnchor(char)
					local hum  = char:FindFirstChildOfClass("Humanoid")

					if root and hum then
						local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
						local dist = (root.Position - Camera.CFrame.Position).Magnitude

						if onScreen and pos.Z > 0.5 and dist <= ESP_CONFIG.MaxDistance then
							local color = ESP_CONFIG.Rainbow and rainbowEspColor() or ESP_CONFIG.EnemyColor

							local z = math.max(pos.Z, 1)
							local sx = math.clamp(1800 / z, 10, 400)
							local sy = math.clamp(2800 / z, 14, 620)

							local topX, topY = pos.X - sx / 2, pos.Y - sy / 2

							-- BOX
							v.Box.Size      = Vector2.new(sx, sy)
							v.Box.Position  = Vector2.new(topX, topY)
							v.Box.Color     = color
							v.Box.Thickness = ESP_CONFIG.BoxThickness
							v.Box.Visible   = ESP_CONFIG.Boxes

							-- NAME
							v.Name.Text     = p.Name
							v.Name.Position = Vector2.new(pos.X, topY - 26)
							v.Name.Color    = color
							v.Name.Visible  = ESP_CONFIG.Names

							-- DISTANCE
							v.Dist.Text     = "[" .. math.floor(dist) .. "m]"
							v.Dist.Position = Vector2.new(pos.X, topY - 12)
							v.Dist.Color    = color
							v.Dist.Visible  = ESP_CONFIG.Distance

							-- HEALTH BAR
							if ESP_CONFIG.HealthBar then
								local maxHp = math.max(1, hum.MaxHealth)
								local hpPct = math.clamp(hum.Health / maxHp, 0, 1)
								local barW  = 3
								local barX  = topX - 7
								local barY  = topY
								local barH  = sy

								local hpColor
								if hpPct > 0.5 then
									hpColor = Color3.fromRGB(74, 222, 128)
								elseif hpPct > 0.25 then
									hpColor = Color3.fromRGB(255, 200, 87)
								else
									hpColor = Color3.fromRGB(255, 85, 102)
								end

								v.HpBg.Size     = Vector2.new(barW + 2, barH + 2)
								v.HpBg.Position = Vector2.new(barX - 1, barY - 1)
								v.HpBg.Color    = Color3.fromRGB(0, 0, 0)
								v.HpBg.Visible  = true

								local fillH = barH * hpPct
								v.HpFill.Size     = Vector2.new(barW, math.max(0, fillH))
								v.HpFill.Position = Vector2.new(barX, barY + (barH - fillH))
								v.HpFill.Color    = hpColor
								v.HpFill.Visible  = true
							else
								v.HpBg.Visible   = false
								v.HpFill.Visible = false
							end

							-- SKELETON
							if ESP_CONFIG.Skeleton then
								for i, pair in ipairs(BonePairs) do
									local ln = v.SkeletonLines[i]
									local partA = char:FindFirstChild(pair[1])
									local partB = char:FindFirstChild(pair[2])
									if partA and partB then
										local a2, aOn = Camera:WorldToViewportPoint(partA.Position)
										local b2, bOn = Camera:WorldToViewportPoint(partB.Position)
										if aOn and bOn and a2.Z > 0.5 and b2.Z > 0.5 then
											ln.From    = Vector2.new(a2.X, a2.Y)
											ln.To      = Vector2.new(b2.X, b2.Y)
											ln.Color   = color
											ln.Visible = true
										else
											ln.Visible = false
										end
									else
										ln.Visible = false
									end
								end
							else
								for _, ln in ipairs(v.SkeletonLines) do ln.Visible = false end
							end
						else
							hideEspVisual(v)
						end
					else
						hideEspVisual(v)
					end
				else
					hideEspVisual(v)
				end
			end
		end
	end)
end)

