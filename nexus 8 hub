local function nexusNotify(msg)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Nexus", Text = tostring(msg), Duration = 2.5
		})
	end)
	print("[Nexus]", msg)
end

local unlockOn, unlockBusy, unlockProxy = false, false, nil
local lastNotify, lastOkNotify = 0, 0

local function softNotify(msg, every)
	every = every or 8
	local now = os.clock()
	if now - lastNotify < every then return end
	lastNotify = now
	nexusNotify(msg)
end

local function findCurrentData()
	if type(getgc) ~= "function" then return nil, nil end
	local best, bestScore = nil, -1
	for _, obj in ipairs(getgc(true)) do
		if type(obj) == "table" then
			local ok, cd = pcall(function() return rawget(obj, "CurrentData") or obj.CurrentData end)
			if ok and type(cd) == "table" then
				local ok2, d = pcall(function() return rawget(cd, "Data") or cd.Data end)
				if ok2 and type(d) == "table" then
					local score = 2
					pcall(function()
						if obj.GetSetting then score = score + 2 end
						if obj.PlayerDataAdded then score = score + 2 end
					end)
					local invOk, inv = pcall(function() return d.CosmeticInventory end)
					if invOk and type(inv) == "table" then score = score + 5 end
					if score > bestScore then bestScore = score; best = {host=cd, data=d} end
				end
			end
			local ok3, d2 = pcall(function() return rawget(obj, "Data") or obj.Data end)
			if ok3 and type(d2) == "table" then
				local invOk, inv = pcall(function() return d2.CosmeticInventory end)
				local hasSig = false
				pcall(function() if rawget(obj, "_value_changed_events") then hasSig = true end end)
				if invOk and (type(inv) == "table" or hasSig) then
					local sc = 3 + (type(inv) == "table" and 4 or 0) + (hasSig and 2 or 0)
					if sc > bestScore then bestScore = sc; best = {host=obj, data=d2} end
				end
			end
		end
	end
	if best and bestScore >= 3 then return best.host, best.data end
	return nil, nil
end

local function loadCosmeticIds()
	local ids = {}
	pcall(function()
		local RS = game:GetService("ReplicatedStorage")
		local inst = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("CosmeticLibrary")
		if not inst then
			for _, d in ipairs(RS:GetDescendants()) do
				if d.Name == "CosmeticLibrary" and d:IsA("ModuleScript") then inst = d break end
			end
		end
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				local cos = mod.Cosmetics or rawget(mod, "Cosmetics")
				if type(cos) == "table" then
					for id in pairs(cos) do if type(id)=="string" then ids[id]=true end end
				end
			end
		end
	end)
	if type(ao) == "table" then
		for weapon, skins in pairs(ao) do
			if type(weapon)=="string" then ids[weapon]=true end
			if type(skins)=="table" then
				for _, s in ipairs(skins) do if type(s)=="string" then ids[s]=true end end
			end
		end
	end
	return ids
end

applyUnlockAll = function(silent)
	if unlockBusy then return false end
	unlockBusy = true
	local okRes = false
	pcall(function()
		local host, data = findCurrentData()
		if not host or not data then
			if not silent then softNotify("PlayerData missing — open the skin menu once", 6) end
			return
		end
		local ids = loadCosmeticIds()
		local count = 0
		for _ in pairs(ids) do count = count + 1 end
		if count < 5 then
			ids = setmetatable({}, {__index = function() return true end})
			count = -1
		end
		pcall(function()
			rawset(data, "CosmeticInventory", ids)
			data.CosmeticInventory = ids
		end)
		if not unlockProxy or unlockProxy.host ~= host then
			local inner = data
			local proxy = setmetatable({__nexus=true}, {
				__index = function(_, key)
					if unlockOn and key == "CosmeticInventory" then return ids end
					return inner[key]
				end,
				__newindex = function(_, key, value)
					if key == "CosmeticInventory" and unlockOn then return end
					inner[key] = value
				end,
			})
			pcall(function() rawset(host, "Data", proxy); host.Data = proxy end)
			unlockProxy = {host=host, inner=inner}
		end
		pcall(function()
			local events = rawget(host, "_value_changed_events")
			if type(events)=="table" then
				local sig = events.CosmeticInventory
				if type(sig)=="table" and sig.Fire then sig:Fire(ids)
				elseif type(sig)=="function" then sig(ids) end
			end
		end)
		okRes = true
		if not silent or (os.clock() - lastOkNotify > 15) then
			lastOkNotify = os.clock()
			nexusNotify(count > 0 and ("Unlock OK · "..count) or "Unlock OK")
		end
	end)
	unlockBusy = false
	return okRes
end

startUnlockLoop = function(state)
	unlockOn = state and true or false
	if not unlockOn then nexusNotify("Unlock All: OFF"); return end
	nexusNotify("Unlock All: ON")
	task.spawn(function()
		for i = 1, 25 do
			if not unlockOn then return end
			if applyUnlockAll(i > 1) then break end
			task.wait(0.8)
		end
		while unlockOn do
			task.wait(5)
			if unlockOn then applyUnlockAll(true) end
		end
	end)
end

