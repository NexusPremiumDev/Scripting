-- Soft skin: only swap MeshId / TextureID / SurfaceAppearance (keeps joints)
local function nexusSoftSkin(target, source)
	if not target or not source then return false end
	local ok = pcall(function()
		local srcParts = {}
		for _, d in ipairs(source:GetDescendants()) do
			if d:IsA("MeshPart") or d:IsA("BasePart") then
				srcParts[#srcParts+1] = d
			end
		end
		local ti = 1
		for _, d in ipairs(target:GetDescendants()) do
			if d:IsA("MeshPart") or d:IsA("BasePart") then
				local s = srcParts[ti]
				if s then
					pcall(function()
						if d:IsA("MeshPart") and s:IsA("MeshPart") then
							d.MeshId = s.MeshId
							d.TextureID = s.TextureID
						end
						if s:IsA("BasePart") then
							d.Color = s.Color
							d.Material = s.Material
							d.Reflectance = s.Reflectance
						end
						-- SurfaceAppearance
						local sa = s:FindFirstChildOfClass("SurfaceAppearance")
						if sa then
							local old = d:FindFirstChildOfClass("SurfaceAppearance")
							if old then old:Destroy() end
							sa:Clone().Parent = d
						end
					end)
					ti = ti + 1
				end
			end
		end
		-- copy extra particle emitters from source that target lacks
		for _, d in ipairs(source:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
				-- skip if already many
			end
		end
	end)
	return ok
end

