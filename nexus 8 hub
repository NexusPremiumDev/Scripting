		if hum then
			hum.Died:Connect(function()
				if rageModeEnabled then toggleRageMode(false) end
				isAimingKeyHeld = false
				scopeSkyReturnPending = false
				scopeSkyReturnCFrame = nil
				skyCampSuspended = false
			end)
		end
	end)
end
