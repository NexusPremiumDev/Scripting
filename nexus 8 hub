-- NEXUS SILENT AIM ENGINE
-- ============================================================
end
do
local silentEnabled = true
local aimbonePart = "Head"
local silentMaxFOV = math.huge
local silentAimDelay = 0.02

local function getTargetPart(char, partName)
	if not char then return nil end
	if partName == "Head" then
		return char:FindFirstChild("Head")
	end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Head")
end

local function isPlayerAlive(plr)
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum and hum.Health > 0
end

local function getClosestSilentTarget()
	local viewport = Camera.ViewportSize
	if not viewport or viewport.Magnitude < 1 then return nil end

	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local bestPlayer, bestDist = nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= k and isPlayerAlive(plr) then
			local char = plr.Character
			local targetPart = getTargetPart(char, aimbonePart)
			if targetPart then
				local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPos.Z > 0 then
					local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
					if dist2d < silentMaxFOV and dist2d < bestDist then
						bestDist = dist2d
						bestPlayer = plr
					end
				end
			end
		end
	end

	return bestPlayer
end

local function fireSilentAim()
	local target = getClosestSilentTarget()
	if not target or not target.Character then return end

	local targetPart = getTargetPart(target.Character, aimbonePart)
	if not targetPart then return end

	local saved = Camera.CFrame
	Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)

	task.delay(silentAimDelay, function()
		if Camera and Camera.Parent then
			Camera.CFrame = saved
		end
	end)
end

_G.SilentAim = {
	SetPart = function(part)
		if part == "Head" or part == "Torso" then
			aimbonePart = part
		end
	end,
	SetFOV = function(px)
		silentMaxFOV = px or math.huge
	end,
	SetDelay = function(sec)
		silentAimDelay = sec or 0.02
	end,
	Fire = fireSilentAim,
	Toggle = function(state)
		if state ~= nil then silentEnabled = state else silentEnabled = not silentEnabled end
		return silentEnabled
	end
}

