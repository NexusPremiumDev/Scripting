					if t then
						-- Prefer silent update if library supports it
						local setOk = false
						pcall(function()
							if t.SetValue then
								-- Obsidian/Linoria: SetValue(val) fires callback — skip for RageMode
								if name == "RageMode" then
									t.Value = value
									if t.Set then t:Set(value, true) end -- some libs: second arg = no callback
								else
									t:SetValue(value)
								end
								setOk = true
							end
						end)
						if not setOk then
							pcall(function() t.Value = value end)
						end
					end
				end
			end)
		end

		for _, name in ipairs({
			"SilentAim", "AutoShoot", "TriggerBot", "AimbotFov", "Prediction", "WallBang",
			"HitboxExtender", "SpinBot", "LoopGoto", "SkyCamp",
			"HeavyImpact", "ScreenShake", "SpeedBoost"
		}) do
			forceToggle(name, on)
		end
		-- RageMode UI without callback
		forceToggle("RageMode", on)
		forceToggle("TacoMusic", false)
		forceToggle("HeadSpin", false)

		print("[Ultra Rage] Rage Mode:", on and "ON" or "OFF")
	end)

	if not okAll then
		warn("[Ultra Rage] toggleRageMode error:", errAll)
	end
	_rageBusy = false
end

