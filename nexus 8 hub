function SetInstantPrompts(enabled)
    NEXUS_INSTANT_PROMPT = enabled
    if enabled then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                if v:GetAttribute("NexusOriginalHold") == nil then
                    v:SetAttribute("NexusOriginalHold", v.HoldDuration)
                end
                v.HoldDuration = 0
            end
        end
    else
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                local original = v:GetAttribute("NexusOriginalHold")
                if original ~= nil then
                    v.HoldDuration = original
                    v:SetAttribute("NexusOriginalHold", nil)
                end
            end
        end
    end
end

