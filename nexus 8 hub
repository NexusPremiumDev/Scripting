local function toggle(label, key, onEnable, onDisable)
    local row = Instance.new("TextButton", Scroll)
    row.Size = UDim2.new(1, 0, 0, 30)
    row.BackgroundColor3 = Color3.fromRGB(22, 26, 36)
    row.AutoButtonColor = false
    row.Text = ""
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)
    local name = Instance.new("TextLabel", row)
    name.BackgroundTransparency = 1
    name.Position = UDim2.fromOffset(10, 0)
    name.Size = UDim2.new(1, -56, 1, 0)
    name.Font = Enum.Font.Gotham
    name.Text = label
    name.TextColor3 = Color3.fromRGB(220, 230, 245)
    name.TextSize = 12
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.TextTruncate = Enum.TextTruncate.AtEnd
    local pill = Instance.new("Frame", row)
    pill.Size = UDim2.fromOffset(38, 18)
    pill.Position = UDim2.new(1, -46, 0.5, -9)
    pill.BackgroundColor3 = Color3.fromRGB(40, 48, 60)
    pill.BorderSizePixel = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.fromOffset(2, 2)
    knob.BackgroundColor3 = Color3.fromRGB(180, 190, 200)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local function paint()
        local on = State[key]
        TweenService:Create(pill, TweenInfo.new(0.1), {
            BackgroundColor3 = on and Color3.fromRGB(56, 189, 248) or Color3.fromRGB(40, 48, 60)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.1), {
            Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
        }):Play()
    end
    paint()
    row.MouseButton1Click:Connect(function()
        local new = not State[key]
        State[key] = new
        if new and onEnable then onEnable() elseif not new and onDisable then onDisable() end
        paint()
    end)
end

