local function toggleMinimize()
    if MainFrame.Visible then
        tw(MainFrame, 0.25, {Size = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quart, Enum.EasingDirection.In):Play()
        task.delay(0.25, function()
            MainFrame.Visible = false
            MiniDock.Visible = true
        end)
    else
        MiniDock.Visible = false
        MainFrame.Visible = true
        tw(MainFrame, 0.35, {Size = UDim2.fromOffset(660, 450)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    end
end

